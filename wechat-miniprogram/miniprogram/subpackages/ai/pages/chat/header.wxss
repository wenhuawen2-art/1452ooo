/* The same 64px reveal used by the system header, with a continuous sky tint.
   Each blur layer owns its opacity: an opaque parent would prevent it sampling
   the scrolling content behind the header in WebKit. The tint remains the
   native fallback when backdrop-filter is unavailable. */
.ai-page .ai-header,
.ai-page .ai-preview-header {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: var(--header-height);
  flex: none;
  color: #001126;
  background: transparent;
  border: 0;
  box-shadow: none;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
  pointer-events: none;
  overflow: visible;
  box-sizing: border-box;
}
.ai-page .ai-header { z-index: 4; }
.ai-page .ai-preview-header { z-index: 2; }
.ai-header > view,
.ai-header > button,
.ai-preview-header > view,
.ai-preview-header > button { position: relative; z-index: 1; }
.ai-header > button,
.ai-preview-header > button { pointer-events: auto; }
.ai-header > .ai-header-blur,
.ai-preview-header > .ai-header-blur {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: -24px;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
}
.ai-header-haze-tint,
.ai-header-haze {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  opacity: var(--header-progress, 0);
}
.ai-header-haze-tint {
  background: linear-gradient(180deg, rgba(231, 242, 255, .97) 0%, rgba(234, 244, 255, .86) 48%, rgba(239, 247, 255, .5) 74%, rgba(241, 248, 255, 0) 100%);
}
.ai-header .ai-header-haze-tint {
  background: linear-gradient(180deg, #477bfa 0%, rgba(75,124,248,.98) 70%, rgba(131,169,242,.85) 84%, rgba(152,186,247,0) 100%);
}
.ai-header-haze-deep {
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  mask-image: linear-gradient(#000 0%, #000 22%, transparent 56%);
  -webkit-mask-image: linear-gradient(#000 0%, #000 22%, transparent 56%);
}
.ai-header-haze-mid {
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  mask-image: linear-gradient(transparent 10%, #000 28%, #000 50%, transparent 78%);
  -webkit-mask-image: linear-gradient(transparent 10%, #000 28%, #000 50%, transparent 78%);
}
.ai-header-haze-soft {
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  mask-image: linear-gradient(transparent 38%, #000 56%, #000 72%, transparent 94%);
  -webkit-mask-image: linear-gradient(transparent 38%, #000 56%, #000 72%, transparent 94%);
}
.ai-header-haze-edge {
  backdrop-filter: blur(2px);
  -webkit-backdrop-filter: blur(2px);
  mask-image: linear-gradient(transparent 64%, #000 80%, transparent 100%);
  -webkit-mask-image: linear-gradient(transparent 64%, #000 80%, transparent 100%);
}
