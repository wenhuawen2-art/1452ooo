 
 /* MasterGo ledger: 166:9365 / 166:8879 / 166:00156. */
.page.theme-expenses{padding:0!important;min-height:100vh;color:#001126}
.theme-expenses .content.expense-content{padding:0;margin:0;width:100%;max-width:none}
.ee-page{position:relative;isolation:isolate;box-sizing:border-box;min-height:100vh;padding:16px 16px 200px;overflow:hidden;font-family:'Alibaba PuHuiTi 2.0',sans-serif}
.ee-page view,.ee-page text,.ee-page button{box-sizing:border-box}
.ee-page text,.ee-page button{font-family:'Alibaba PuHuiTi 2.0',sans-serif}
.ee-page>view,.ee-page>scroll-view{position:relative}
.ee-page button{margin:0;line-height:normal}
.ee-header{z-index:2}
.ee-book{display:flex;align-items:center;gap:16px;height:36px;margin-top:40px;color:#fff;font-size:24px;line-height:34px}
.ee-settings{position:relative;display:flex;align-items:center;justify-content:center;width:36px;height:36px;min-height:36px!important;padding:8px;background:rgba(255,255,255,.2);border-radius:50%}
.ee-settings:before{content:'';position:absolute;inset:-4px}.ee-settings image{width:20px;height:20px}
.ee-total-label{display:flex;align-items:center;gap:8px;height:20px;margin-top:52px;font-size:14px;line-height:20px;color:rgba(4,9,17,.75)}
.ee-total-label image{width:16px;height:16px}
.ee-total-line{display:flex;align-items:baseline;gap:8px;min-height:64px;margin-top:13px;white-space:nowrap}
.ee-page .ee-home-total{font-family:'Konkhmer Sleokchher',Arial,sans-serif;font-size:64px;font-weight:400;line-height:64px;letter-spacing:0;font-style:normal}
.ee-page .ee-home-total.compact{font-size:44px}
.ee-currency{font-size:24px;line-height:34px;font-weight:500;color:rgba(4,9,17,.5)}
.ee-budget{min-width:0;overflow:hidden;text-overflow:ellipsis;font-size:20px;line-height:28px;font-weight:500;color:rgba(0,17,38,.5)}
.ee-budget-track{position:relative;height:16px;margin-top:16px;border-radius:8px;background:#fff;overflow:hidden}
.ee-budget-track>view{position:absolute;left:4px;top:3px;max-width:calc(100% - 8px);height:10px;border-radius:5px;background:linear-gradient(90deg,#c5e9ff,#0798ff)}
.ee-tabs{display:flex;gap:12px;margin-top:28px;padding:6px;height:52px;border-radius:224px;background:rgba(0,34,88,.2);backdrop-filter:blur(10px)}
.ee-tabs button{flex:1;display:flex;align-items:center;justify-content:center;min-width:0;min-height:0;height:40px;padding:0;border-radius:224px;background:transparent;color:#fff;font-size:16px;line-height:22px;font-weight:500}
.ee-tabs button.selected{background:rgba(255,255,255,.8);color:#001126}
.ee-dates{margin-top:32px}
.ee-page .rg-date{height:102px;min-width:56px;width:56px;padding:8px 14px 4px;gap:8px;background:rgba(0,34,88,.2)}
.ee-page .rg-date.selected{background:#fff;color:#001126;box-shadow:none;border:0}
.ee-page .rg-date text{font-size:13px;line-height:18px}
.ee-page .rg-date .rg-day{font-size:24px;line-height:24px;font-weight:600}
.ee-page .rg-date-dot{margin-top:auto;width:6px;height:6px}
.ee-page .rg-date.selected .rg-date-dot{background:#0072ff;box-shadow:0 0 0 2px #dbedff}
.ee-detail-days{margin-top:32px;display:flex;flex-direction:column;gap:16px}
.ee-glass,.ee-day{border:1px solid rgba(255,255,255,.8);border-radius:16px;background:rgba(255,255,255,.9);backdrop-filter:blur(10px)}
.ee-day{padding:11px}
.ee-day-head{display:flex;align-items:center;gap:12px;height:36px;font-size:20px;line-height:24px;font-weight:600;margin-bottom:16px}
.ee-day-count{font-weight:400}.ee-dot{width:6px;height:6px;flex:none;background:#001126;border-radius:50%}
.ee-day-total{display:flex;align-items:center;gap:2px;height:36px;margin-left:auto;padding:0 16px;border:1px solid rgba(0,17,38,.1);border-radius:237px;background:rgba(255,255,255,.5)}
.ee-day-total>text:first-child{font-size:16px;font-weight:400}
.ee-page .ee-num{font-family:'Konkhmer Sleokchher',sans-serif;font-weight:400}
.ee-entries{display:flex;flex-direction:column;gap:6px}
.ee-entry{position:relative;display:flex;flex-direction:column;gap:12px;min-height:178px;padding:12px;border-radius:12px;background:rgba(63,90,135,.06)}
.ee-entry.menu-open{z-index:25}
.ee-entry-head{display:flex;align-items:center;gap:16px;min-height:28px}
.ee-entry-title{min-width:0;max-width:48%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:16px;line-height:22px;font-weight:500}
.ee-category{flex:none;max-width:48%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding:3px 8px;border:1px solid rgba(0,114,255,.2);border-radius:8px;background:rgba(125,173,255,.3);color:#0072ff;font-size:14px;line-height:20px;font-weight:500}
.ee-more{display:flex;align-items:center;justify-content:center;position:relative;width:30px;min-width:30px;height:30px;min-height:30px!important;padding:0;margin-left:auto!important;background:transparent}
.ee-more:before{content:'';position:absolute;inset:-7px}.ee-more image{width:30px;height:30px}
.ee-entry-date{display:block;font-size:14px;line-height:24px}
.ee-entry-bottom{display:flex;align-items:center;gap:2px;min-height:30px}
.ee-payer{display:flex;align-items:center;flex:none;padding-right:8px;border:1px solid #fff;border-radius:30px;background:linear-gradient(90deg,#fff,#fff4eb);color:#c28e60;font-size:14px;line-height:24px}
.ee-payer image,.ee-person{width:30px;height:30px;border:1px solid #fff;border-radius:50%;flex:none}
.ee-payer image{margin:-1px 4px -1px -1px}
.ee-entry-amount{margin-left:auto;white-space:nowrap;color:#0072ff;font-size:18px;line-height:25px;font-weight:700}
.ee-note{padding:8px;border-radius:8px;background:rgba(255,255,255,.9);color:rgba(0,17,38,.7);font-size:12px;line-height:24px;white-space:pre-wrap;overflow-wrap:anywhere}
.ee-conversion{font-size:12px;color:#64748b}
.ee-menu{right:12px;top:42px}
.ee-empty{padding:36px 16px;text-align:center;color:#65778c;font-size:14px}.ee-empty text{display:block}.ee-empty button{margin:16px auto 0!important;background:transparent;color:#0072ff}
.ee-my-summary{display:flex;gap:12px;height:88px;margin-top:36px}
.ee-my-summary>view{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;flex:1;min-width:0;background:rgba(255,255,255,.9);border-radius:12px}
.ee-kpi-label{display:flex;align-items:center;justify-content:center;gap:8px;font-size:14px;line-height:20px;color:rgba(51,51,51,.9)}
.ee-kpi-label image{width:20px;height:20px}
.ee-kpi-number{display:flex;align-items:baseline;justify-content:center;gap:2px;font-size:16px;line-height:29px;white-space:nowrap}
.ee-kpi-number>.ee-num{font-size:20px;line-height:36px}
.ee-member-heading{display:block;padding:0 7px;height:25px;min-height:25px!important;margin-top:40px!important;margin-bottom:14px!important;background:transparent;text-align:left;font-size:18px;line-height:25px;font-weight:600;color:#001126}
.ee-members{display:flex;flex-direction:column;gap:12px}
.ee-member{padding:11px}
.ee-member-inner{padding:12px;border-radius:12px;background:rgba(63,90,135,.06)}
.ee-member-head{display:flex;align-items:center;gap:12px;height:40px;margin-bottom:20px;font-size:16px;font-weight:500}
.ee-member-head>image{width:40px;height:40px;border-radius:50%;border:1px solid #fff}
.ee-member-head>text:first-of-type{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1}
.ee-member-head .ee-member-net-label{font-size:14px;font-weight:400;color:rgba(51,51,51,.9);flex:none}
.ee-member-net{font-size:18px;line-height:25px;font-weight:700;color:#00a53a;white-space:nowrap}
.ee-member-net.owing{color:#f15c62}
.ee-member-metrics{display:flex;gap:6px}
.ee-member-metrics>view{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;flex:1;min-width:0;height:81px;background:rgba(255,255,255,.9);border-radius:12px}
.ee-member-metrics .ee-num{font-size:16px;line-height:29px}
.ee-stats-summary{display:flex;align-items:center;height:104px;margin-top:36px;padding:19px}
.ee-stats-summary>view{display:flex;flex-direction:column;gap:8px;flex:1;min-width:0}
.ee-stats-summary>view+view{border-left:1px solid rgba(0,0,0,.1)}
.ee-section-title{display:block;font-size:18px;line-height:25px;font-weight:600}
.ee-category-chart{margin-top:24px;padding:15px}
.ee-chart-legend{display:flex;flex-wrap:wrap;gap:12px 28px;min-height:22px;margin-top:24px}
.ee-chart-legend button{min-height:22px!important;height:22px;display:flex;align-items:center;gap:8px;padding:0;background:transparent;color:rgba(51,51,51,.9);font-size:16px;line-height:22px}
.ee-chart-legend button>view{width:24px;height:12px;border-radius:8px}
.ee-pie-area{position:relative;width:251px;height:250px;margin:28px auto 34px}
.ee-pie-base,.ee-pie-ring{position:absolute;inset:0;border-radius:50%;mask:radial-gradient(circle closest-side,transparent 74px,#000 75px,#000 88px,transparent 89px)}
.ee-pie-base{background:rgba(63,90,135,.1);mask:radial-gradient(circle closest-side,transparent 69px,#000 70px,#000 92px,transparent 93px)}
.ee-pie-cap{position:absolute;width:14px;height:14px;border-radius:50%}
.ee-pie-label{position:absolute;font-size:16px;line-height:29px;font-weight:600;white-space:nowrap}
.ee-pie-label.label-0{left:-44px;top:3px}.ee-pie-label.label-1{left:221px;top:71px}.ee-pie-label.label-2{left:-25px;top:210.5px}
.ee-pie-line{position:absolute;width:34px;height:26px}.ee-pie-line.line-0{left:34px;top:24.5px}.ee-pie-line.line-1{left:249.5px;top:99.5px}.ee-pie-line.line-2{left:31.5px;top:196px}
.ee-chart-empty{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:14px;color:#728196}
.ee-category-rows{display:flex;flex-direction:column;gap:8px}
.ee-category-row{display:block;width:100%;padding:12px;background:rgba(63,90,135,.06);border-radius:12px;text-align:left;color:#001126}
.ee-category-row-head{display:flex;align-items:center;gap:12px;height:25px;font-size:16px;font-weight:500}
.ee-percent{flex:1;font-size:14px;font-weight:400}
.ee-blue{margin-left:auto;color:#0072ff;font-size:18px;line-height:25px;font-weight:700;white-space:nowrap}
.ee-category-row-bottom{display:flex;align-items:center;gap:12px;height:24px;margin-top:12px;font-size:14px}
.ee-category-track{position:relative;flex:1;height:16px;border-radius:8px;background:#fff;padding:3px 4px}
.ee-category-track>view{height:10px;border-radius:5px;background:linear-gradient(90deg,#c5e9ff,#0798ff);max-width:100%}
.ee-daily-chart{margin-top:24px;padding:15px;height:366px}
.ee-daily-scroll{margin-top:16px;width:100%;overflow-x:auto}
.ee-daily-bars{display:flex;justify-content:space-between;gap:8px;min-width:100%;width:max-content;padding-bottom:0}
.ee-daily-bars button{display:flex;flex-direction:column;align-items:center;flex:none;width:40px;padding:0;background:transparent;font-size:16px;color:rgba(51,51,51,.9)}
.ee-bar-track{display:flex;align-items:flex-end;width:12px;height:240px;margin-bottom:8px;border-radius:6px;background:rgba(0,0,0,.08);overflow:hidden}
.ee-bar-track>view{width:100%;border-radius:6px 6px 0 0;background:linear-gradient(180deg,#0798ff,#a7e7ff)}
.ee-daily-bars button>text{line-height:22px}
.ee-scroll-track{height:8px;margin-top:16px;border-radius:4px;background:rgba(0,0,0,.04)}.ee-scroll-track>view{height:8px;width:33px;margin-left:62%;border-radius:4px;background:rgba(0,0,0,.12)}
.ee-ranking{display:flex;flex-direction:column;gap:16px;margin-top:24px;padding:15px}
.ee-rank-row{display:flex;flex-direction:column;gap:12px;padding:12px;border-radius:12px;background:rgba(63,90,135,.06)}
.ee-rank-head{display:flex;align-items:center;gap:12px;font-size:16px;font-weight:500;min-height:28px}
.ee-rank-index{padding:4px 8px;border-radius:8px;font-size:14px;line-height:20px;color:#0b5cff;background:rgba(153,177,255,.22)}
.ee-rank-index.rank-0{color:#ff0900;background:rgba(255,113,87,.3)}.ee-rank-index.rank-1{color:#ca4d00;background:rgba(255,157,87,.3)}.ee-rank-index.rank-2{color:#9c7200;background:rgba(186,166,48,.3)}
.ee-settlement-summary{display:flex;flex-direction:column;gap:12px;margin-bottom:24px}
.ee-filter-state{display:flex;align-items:center;justify-content:space-between;margin-top:16px;font-size:14px}.ee-filter-state button{padding:4px 8px;background:#fff8;border-radius:8px;color:#0072ff}
.ee-add{z-index:29}
.theme-expenses .guest-banner,.theme-expenses .notice{margin:12px 16px}
@media(max-width:374px){.ee-pie-area{transform:scale(.88);transform-origin:center;margin-left:calc((100% - 251px)/2);margin-right:0}.ee-member-head{gap:8px}.ee-home-total{letter-spacing:-1px}.ee-member-net{font-size:16px}.ee-category-chart .ee-blue{font-size:16px}}

.ee-entry>.ee-note,.ee-rank-row>.ee-note{margin-top:-6px}.ee-ranking{margin-right:-8px}

.ee-currency,.ee-budget{position:relative;top:-2px}.ee-budget{margin-left:-6px}

.ee-member-heading{position:relative;z-index:1}
.ee-ranking{gap:8px}.ee-ranking>.ee-section-title{margin-bottom:8px}
