<view class="mg-home" style="padding-top:{{systemContentTop}}px">
 <image class="rg-atmosphere" src="/assets/mastergo-route/planning/svg_a7d2aa9f.svg" mode="scaleToFill"/>
 <view class="system-header-space"></view>
 <view class="mg-trip-head"><text>{{trip.name}}</text><button wx:if="{{!trip.archived}}" bindtap="openEditTrip" aria-label="编辑旅行"><image src="/assets/mastergo/svg_aa12c6ee.svg"/></button></view>
 <view class="mg-member-row"><view class="mg-members"><image wx:for="{{trip.members}}" wx:key="id" wx:if="{{index < 3}}" src="{{item.avatarSrc}}" mode="aspectFill"/><button open-type="share" aria-label="邀请同行人"><image src="/assets/mastergo/svg_92e9a6a5.svg" mode="aspectFit"/></button></view><text class="mg-type">{{trip.type || '旅行'}}</text></view>
 <view class="mg-countdown"><view class="mg-count-label"><image src="/assets/mastergo/svg_09acd1ff.svg" mode="aspectFit"/><text>{{tripPhaseLabel}}</text></view><view class="mg-count-number"><text>{{tripPhaseValue}}</text><text class="unit">{{tripPhaseUnit}}</text></view><view class="mg-count-number reflection"><text>{{tripPhaseValue}}</text><text class="unit">{{tripPhaseUnit}}</text></view></view>
 <view class="mg-trip-overview"><view class="mg-days"><text class="label">旅程共计</text><view><text class="number">{{tripDays}}</text><text>天</text></view></view><view class="mg-date-row"><view class="mg-date-card" data-endpoint="start" bindtap="openTripDate"><view><image src="/assets/mastergo/svg_9f1a75b2.svg"/><text class="label">出发日期</text></view><text class="date">{{tripStartDate}} {{startTimeDisplay}}</text></view><view class="mg-date-card" data-endpoint="end" bindtap="openTripDate"><view><image src="/assets/mastergo/svg_50b43fff.svg"/><text class="label">归来日期</text></view><text class="date">{{tripEndDate}} {{endTimeDisplay}}</text></view></view></view>
 <view class="mg-content-panel"><text class="mg-section-title">出发准备</text><view class="mg-prep-grid"><button data-section="public" bindtap="openChecklist"><text>团队准备</text><view><text class="value">{{publicProgress.done}}</text><text>/{{publicProgress.total}}项</text></view><view class="mg-progress"><view style="width:{{publicProgress.percent}}%"></view></view></button><button data-section="personal" bindtap="openChecklist"><text>我的准备</text><view><text class="value">{{mineProgress.done}}</text><text>/{{mineProgress.total}}项</text></view><view class="mg-progress personal"><view style="width:{{mineProgress.percent}}%"></view></view></button><button class="mg-outfit-summary" data-section="outfit" bindtap="openChecklist"><text>穿搭</text><view><text class="value">{{outfitCount}}</text><text>套</text></view></button></view>
 <view class="mg-weather-section"><text class="mg-section-title">天气</text><view class="mg-weather"><image class="mg-weather-bg" src="/assets/mastergo/weather-cloud.webp"/><button class="mg-weather-more" bindtap="showWeatherDetails" aria-label="天气详情"><image src="/assets/mastergo/svg_4e94fef7.svg"/></button><block wx:if="{{weather && weather.available && !weatherLoading}}"><image class="mg-weather-sun" src="/assets/mastergo/svg_e4253e14.svg"/><view class="mg-location">{{weather.location}}</view><text class="mg-temp">{{weather.current != null ? weather.current : weather.high}}°</text><view class="mg-condition"><view><image src="/assets/mastergo/svg_b2ceaa57.svg"/><text>{{weather.condition}}</text></view><view><image src="/assets/mastergo/svg_fd2d52e1.svg"/><text>最高 {{weather.high}}°</text></view><view><image src="/assets/mastergo/svg_fd2d52e1.svg"/><text>最低 {{weather.low}}°</text></view></view><view class="mg-weather-stats"><view><text>紫外线</text><text class="strong">{{weather.uvLevel || '—'}} UV {{weather.uvIndex != null ? weather.uvIndex : '—'}}</text><view class="mg-uv-track"><view style="left:{{weather.uvIndex != null ? weather.uvIndex * 8 : 0}}%"></view></view></view><view><text>湿度</text><text class="strong">{{weather.humidity != null ? weather.humidity + '%' : '—'}}</text><view class="mg-humidity-track"><view style="width:{{weather.humidity || 0}}%"></view></view></view></view></block><view wx:else class="mg-weather-state">{{weatherLoading ? '正在获取天气…' : weather && weather.reason !== 'missing_place' ? '暂时无法获取天气，点击右上角查看城市' : '填写行程地点后显示第一站天气'}}</view></view></view>
 <view class="mg-route-section"><text class="mg-section-title">全程路线</text><view class="mg-route" bindtap="openRouteMap" hover-class="motion-pressed" hover-stop-propagation="true"><map wx:if="{{routeOverview && routeOverview.available && !designHomeMapImage}}" longitude="{{routeOverview.centerLongitude}}" latitude="{{routeOverview.centerLatitude}}" scale="{{routeOverview.mapScale}}" markers="{{routeOverview.markers}}" polyline="{{routeOverview.polylines}}" include-points="{{routeOverview.includePoints}}" enable-scroll="{{false}}" enable-zoom="{{false}}" enable-rotate="{{false}}" enable-overlooking="{{false}}"/><image wx:else src="/assets/mastergo/route-fallback.jpg" mode="aspectFill"/><view class="mg-map-open"><image src="/assets/mastergo/svg_bb052d4c.svg" mode="aspectFit"/></view></view></view>
 </view>
</view>
