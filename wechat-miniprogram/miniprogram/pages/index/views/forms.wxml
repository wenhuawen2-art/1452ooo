      <scroll-view class="modal-body" scroll-y style="height:{{motionExitModal && motionExitBodyHeight != null ? motionExitBodyHeight + 'px' : formBodyHeight != null ? formBodyHeight + 'px' : 'auto'}}"><view class="form-fields">
        <block wx:if="{{modal.type === 'profile'}}">
          <label class="field"><text>昵称</text><input cursor-spacing="140" type="nickname" value="{{modal.values.nickname}}" maxlength="40" data-field="nickname" bindinput="bindInput"/><text wx:if="{{fieldErrors.nickname}}" class="field-error">{{fieldErrors.nickname}}</text></label>
          <text class="field-label">选择头像</text>
          <view class="avatar-grid"><button class="avatar custom {{modal.values.avatarData ? 'selected' : ''}}" open-type="chooseAvatar" bindchooseavatar="chooseProfileWechatAvatar"><image wx:if="{{modal.values.avatarData}}" src="{{modal.values.avatarData}}"/><text wx:else>＋</text></button><button wx:for="{{avatars}}" wx:key="id" class="avatar {{modal.values.avatarId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="chooseAvatar"><image src="{{item.src}}"/></button></view>
        </block>
        <block wx:elif="{{modal.type === 'trip'}}">
          <label class="field"><text>旅行名称</text><input cursor-spacing="140" value="{{modal.values.name}}" data-field="name" bindinput="bindInput"/><text wx:if="{{fieldErrors.name}}" class="field-error">{{fieldErrors.name}}</text></label>
          <label class="field"><text>旅行类型</text><picker range="{{tripTypes}}" bindchange="bindType"><view class="picker-value">{{modal.values.type}} 〉</view></picker></label>
          <view class="field-row"><label class="field"><text>出发日期</text><picker mode="date" value="{{modal.values.startDate}}" data-field="startDate" bindchange="bindDate"><view class="picker-value">{{modal.values.startDate}}</view></picker></label><label class="field"><text>时间</text><picker mode="time" value="{{modal.values.startTime}}" data-field="startTime" bindchange="bindTime"><view class="picker-value">{{modal.values.startTime}}</view></picker></label></view>
          <view class="field-row"><label class="field"><text>归来日期</text><picker mode="date" value="{{modal.values.endDate}}" data-field="endDate" bindchange="bindDate"><view class="picker-value">{{modal.values.endDate}}</view></picker><text wx:if="{{fieldErrors.endDate}}" class="field-error">{{fieldErrors.endDate}}</text></label><label class="field"><text>时间</text><picker mode="time" value="{{modal.values.endTime}}" data-field="endTime" bindchange="bindTime"><view class="picker-value">{{modal.values.endTime}}</view></picker></label></view>
        </block>
        <block wx:elif="{{modal.type === 'cloneTrip'}}">
          <view class="notice">将复制“{{trip.name}}”的日期、行程、住宿、清单和票据。原旅行不会改变；同行人需在新副本中重新邀请。</view>
          <label class="field"><text>副本名称</text><input cursor-spacing="140" value="{{modal.values.name}}" maxlength="200" data-field="name" bindinput="bindInput"/><text wx:if="{{fieldErrors.name}}" class="field-error">{{fieldErrors.name}}</text></label>
        </block>
        <block wx:elif="{{modal.type === 'event'}}">
          <label class="field"><text>做什么</text><input cursor-spacing="140" value="{{modal.values.title}}" data-field="title" bindinput="bindInput"/><text wx:if="{{fieldErrors.title}}" class="field-error">{{fieldErrors.title}}</text></label>
          <label class="field"><text>日期</text><picker mode="date" value="{{modal.values.date}}" data-field="date" bindchange="bindDate"><view class="picker-value">{{modal.values.date}}</view></picker></label>
          <view class="field-row"><label class="field"><text>开始时间</text><picker mode="time" value="{{modal.values.startTime}}" data-field="startTime" bindchange="bindTime"><view class="picker-value">{{modal.values.startTime}}</view></picker></label><label class="field"><text>结束时间</text><picker mode="time" value="{{modal.values.endTime}}" data-field="endTime" bindchange="bindTime"><view class="picker-value">{{modal.values.endTime}}</view></picker></label></view>
          <label class="field"><text>起始地</text><input cursor-spacing="140" value="{{modal.values.startPlace}}" data-field="startPlace" bindinput="bindInput"/><text wx:if="{{fieldErrors.startPlace}}" class="field-error">{{fieldErrors.startPlace}}</text></label><label class="field"><text>目的地</text><input cursor-spacing="140" value="{{modal.values.endPlace}}" data-field="endPlace" bindinput="bindInput"/><text wx:if="{{fieldErrors.endPlace}}" class="field-error">{{fieldErrors.endPlace}}</text></label><label class="field"><text>具体地址</text><input cursor-spacing="140" value="{{modal.values.address}}" data-field="address" bindinput="bindInput"/><text wx:if="{{fieldErrors.address}}" class="field-error">{{fieldErrors.address}}</text></label><label class="field"><text>交通方式</text><picker range="{{modal.transportModes}}" range-key="label" value="{{modal.transportIndex}}" bindchange="bindEventTransport"><view class="picker-value">{{modal.transportModes[modal.transportIndex].icon}} {{modal.transportModes[modal.transportIndex].label}} 〉</view></picker></label><label class="field"><text>备注</text><textarea cursor-spacing="140" value="{{modal.values.note}}" data-field="note" bindinput="bindInput"/></label>
        </block>
        <block wx:elif="{{modal.type === 'hotel'}}">
          <label class="field"><text>住宿名称</text><input cursor-spacing="140" value="{{modal.values.name}}" data-field="name" bindinput="bindInput"/><text wx:if="{{fieldErrors.name}}" class="field-error">{{fieldErrors.name}}</text></label><label class="field"><text>城市</text><input cursor-spacing="140" value="{{modal.values.city}}" data-field="city" bindinput="bindInput"/><text wx:if="{{fieldErrors.city}}" class="field-error">{{fieldErrors.city}}</text></label><label class="field"><text>具体地址</text><input cursor-spacing="140" value="{{modal.values.address}}" data-field="address" bindinput="bindInput"/><text wx:if="{{fieldErrors.address}}" class="field-error">{{fieldErrors.address}}</text></label>
          <view class="field-row"><label class="field"><text>入住</text><picker mode="date" value="{{modal.values.checkin}}" data-field="checkin" bindchange="bindDate"><view class="picker-value">{{modal.values.checkin}}</view></picker></label><label class="field"><text>退房</text><picker mode="date" value="{{modal.values.checkout}}" data-field="checkout" bindchange="bindDate"><view class="picker-value">{{modal.values.checkout}}</view></picker><text wx:if="{{fieldErrors.checkout}}" class="field-error">{{fieldErrors.checkout}}</text></label></view><label class="field"><text>电话（选填）</text><input cursor-spacing="140" value="{{modal.values.phone}}" data-field="phone" bindinput="bindInput"/><text wx:if="{{fieldErrors.phone}}" class="field-error">{{fieldErrors.phone}}</text></label><label class="field"><text>备注</text><textarea cursor-spacing="140" value="{{modal.values.note}}" data-field="note" bindinput="bindInput"/></label>
        </block>
        <block wx:elif="{{modal.type === 'item'}}">
          <view wx:if="{{!modal.edit}}" class="item-context">{{modal.categoryName}}</view><label class="field"><text>条目名称</text><input cursor-spacing="140" value="{{modal.values.title}}" data-field="title" bindinput="bindInput"/><text wx:if="{{fieldErrors.title}}" class="field-error">{{fieldErrors.title}}</text></label><label wx:if="{{modal.edit}}" class="field"><text>分类</text><picker range="{{modal.categories}}" range-key="name" value="{{modal.categoryIndex}}" bindchange="bindCategory"><view class="picker-value">{{modal.categories[modal.categoryIndex].name}} 〉</view></picker></label><label class="switch-row"><text>设为关键项</text><switch checked="{{modal.values.key}}" data-field="key" bindchange="bindSwitch" color="#4f8ee8"/></label>
        </block>
        <block wx:elif="{{modal.type === 'category'}}"><button wx:if="{{modal.showTemplateEntry}}" class="category-template-entry" bindtap="openTemplates"><view class="category-template-icon"><text>◆</text></view><text>导入清单模板</text><text class="category-template-arrow">›</text></button><view wx:if="{{modal.showTemplateEntry}}" class="category-create-divider"></view><text wx:if="{{modal.showTemplateEntry}}" class="category-create-title">新建分类</text><label class="field"><text>分类名称</text><input cursor-spacing="140" value="{{modal.values.name}}" data-field="name" bindinput="bindInput"/><text wx:if="{{fieldErrors.name}}" class="field-error">{{fieldErrors.name}}</text></label></block>
        <block wx:elif="{{modal.type === 'templates'}}"><button wx:for="{{templates}}" wx:key="id" class="template-card" data-id="{{item.id}}" bindtap="openTemplateDetail"><view class="template-icon-slot"><image class="template-symbol" src="{{item.iconSrc}}" mode="aspectFit"/></view><view class="grow"><text class="strong">{{item.name}}</text><text class="small">{{item.items.length}} 项</text></view><text class="template-arrow">›</text></button></block>
        <block wx:elif="{{modal.type === 'templateDetail'}}"><view class="template-detail-head"><image class="template-symbol large" src="{{modal.template.iconSrc}}" mode="aspectFit"/><view class="grow"><text class="template-badge">建议放入{{modal.template.recommendedScope === '公共' ? '一起准备' : '我的物品'}}</text><text class="template-description">{{modal.template.description}}</text></view></view><view class="template-items"><view wx:for="{{modal.template.items}}" wx:key="title" class="template-item"><text>{{item.title}}</text><text wx:if="{{item.key}}" class="key-tag">关键项</text></view></view><button class="primary template-import" data-id="{{modal.template.id}}" bindtap="importTemplate">导入到{{scope === '公共' ? '一起准备' : '我的物品'}}</button></block>
        <block wx:elif="{{modal.type === 'join'}}"><view class="notice">你将以微信账号“{{account.nickname}}”加入这趟旅行，头像和昵称会保持全账号一致。</view></block>
        <block wx:elif="{{modal.type === 'guestInvite'}}"><view class="notice">你收到了一趟旅行邀请。可以先继续浏览演示功能，登录后再确认加入。</view><button class="primary guest-invite-login" data-intent="join" bindtap="startLogin">登录并加入旅行</button></block>
        <block wx:elif="{{modal.type === 'ticket'}}"><label class="field"><text>票据类型</text><input cursor-spacing="140" value="{{modal.values.type}}" data-field="type" bindinput="bindInput"/><text wx:if="{{fieldErrors.type}}" class="field-error">{{fieldErrors.type}}</text></label><view class="field-row"><label class="field"><text>使用日期</text><picker mode="date" value="{{modal.values.useDate}}" start="{{tripStartDate}}" end="{{tripEndDate}}" data-field="useDate" bindchange="bindDate"><view class="picker-value">{{modal.values.useDate}}</view></picker></label><label class="field"><text>使用时间</text><picker mode="time" value="{{modal.values.useClock}}" data-field="useClock" bindchange="bindTime"><view class="picker-value">{{modal.values.useClock}}</view></picker></label></view></block>
        <block wx:elif="{{modal.type === 'ticketMeta'}}"><label class="field"><text>票据类型</text><input cursor-spacing="140" value="{{modal.values.type}}" data-field="type" bindinput="bindInput"/><text wx:if="{{fieldErrors.type}}" class="field-error">{{fieldErrors.type}}</text></label><view class="field-row"><label class="field"><text>使用日期</text><picker mode="date" value="{{modal.values.useDate}}" start="{{tripStartDate}}" end="{{tripEndDate}}" data-field="useDate" bindchange="bindDate"><view class="picker-value">{{modal.values.useDate}}</view></picker></label><label class="field"><text>使用时间</text><picker mode="time" value="{{modal.values.useClock}}" data-field="useClock" bindchange="bindTime"><view class="picker-value">{{modal.values.useClock}}</view></picker></label></view></block>
        <block wx:elif="{{modal.type === 'outfitItem'}}">
          <view class="outfit-item-editor outfit-item-editor-single">
            <label class="field"><text>衣物类型</text><picker range="{{outfitTypes}}" range-key="name" value="{{modal.values.items[0].typeIndex}}" data-index="0" bindchange="bindOutfitItemType"><view class="picker-value">{{modal.values.items[0].typeName}} 〉</view></picker></label>
            <label class="field"><text>衣物名称</text><input cursor-spacing="140" class="outfit-item-name" value="{{modal.values.items[0].name}}" placeholder="例如：白色打底衫" data-index="0" bindinput="bindOutfitItemName"/></label>
            <view class="outfit-photo-picker"><button data-index="0" bindtap="chooseOutfitItemPhoto">{{modal.values.items[0].photoLocalPath || (!modal.values.items[0].removePhoto && modal.values.items[0].photoFileId) ? '替换衣物照片' : '＋ 添加衣物照片（选填）'}}</button><button wx:if="{{modal.values.items[0].photoLocalPath || (!modal.values.items[0].removePhoto && modal.values.items[0].photoFileId)}}" class="danger-text" data-index="0" bindtap="removeOutfitItemPhoto">移除照片</button></view>
            <image wx:if="{{modal.values.items[0].photoLocalPath || (!modal.values.items[0].removePhoto && modal.values.items[0].photoSrc)}}" class="outfit-photo-preview" src="{{modal.values.items[0].photoLocalPath || modal.values.items[0].photoSrc}}" mode="aspectFill"/>
          </view>
        </block>
        <block wx:elif="{{modal.type === 'outfit'}}">
          <view class="field-row"><label class="field"><text>日期</text><picker mode="date" value="{{modal.values.date}}" start="{{tripStartDate}}" end="{{tripEndDate}}" data-field="date" bindchange="bindDate"><view class="picker-value">{{modal.values.date}}</view></picker></label><label class="field"><text>场景</text><picker range="{{modal.scenes}}" value="{{modal.sceneIndex}}" bindchange="bindOutfitScene"><view class="picker-value">{{modal.values.scene}} 〉</view></picker></label></view>
          <label class="field"><text>穿搭标题</text><input cursor-spacing="140" value="{{modal.values.title}}" placeholder="例如：上午徒步" data-field="title" bindinput="bindInput"/><text wx:if="{{fieldErrors.title}}" class="field-error">{{fieldErrors.title}}</text></label>
          <view wx:if="{{modal.legacyPhotoSrc}}" class="legacy-outfit-photo"><text class="field-label">旧版整套参考照片</text><image src="{{modal.legacyPhotoSrc}}" mode="aspectFill"/></view>
          <view class="outfit-item-heading"><text class="field-label">衣物清单</text></view>
          <view wx:for="{{modal.values.items}}" wx:key="localId" class="outfit-item-editor">
            <view class="outfit-item-top"><picker class="grow" range="{{outfitTypes}}" range-key="name" value="{{item.typeIndex}}" data-index="{{index}}" bindchange="bindOutfitItemType"><view class="picker-value">{{item.typeName}} 〉</view></picker><button class="danger-text outfit-item-remove" data-index="{{index}}" bindtap="removeOutfitItem">删除</button></view>
            <input cursor-spacing="140" class="outfit-item-name" value="{{item.name}}" placeholder="填写具体衣物，例如白色打底衫" data-index="{{index}}" bindinput="bindOutfitItemName"/>
            <view class="outfit-photo-picker"><button data-index="{{index}}" bindtap="chooseOutfitItemPhoto">{{item.photoLocalPath || (!item.removePhoto && item.photoFileId) ? '替换衣物照片' : '＋ 添加衣物照片（选填）'}}</button><button wx:if="{{item.photoLocalPath || (!item.removePhoto && item.photoFileId)}}" class="danger-text" data-index="{{index}}" bindtap="removeOutfitItemPhoto">移除照片</button></view>
            <image wx:if="{{item.photoLocalPath || (!item.removePhoto && item.photoSrc)}}" class="outfit-photo-preview" src="{{item.photoLocalPath || item.photoSrc}}" mode="aspectFill"/>
          </view>
          <button wx:if="{{!modal.edit}}" class="outline full outfit-add-item" bindtap="addOutfitItem">＋ 添加衣物</button>
          <label class="field"><text>备注（选填）</text><textarea cursor-spacing="140" value="{{modal.values.note}}" placeholder="温差、防晒、备用单品等" data-field="note" bindinput="bindInput"/></label>
        </block>
        <block wx:elif="{{modal.type === 'outfitTypes'}}">
          <view class="outfit-type-create"><input cursor-spacing="140" value="{{modal.values.name}}" placeholder="例如：泳装、睡衣" data-field="name" bindinput="bindInput"/><text wx:if="{{fieldErrors.name}}" class="field-error">{{fieldErrors.name}}</text><button bindtap="saveOutfitType">{{modal.editingId ? '保存修改' : '新增类型'}}</button></view>
          <button wx:if="{{modal.editingId}}" class="type-cancel" bindtap="cancelOutfitTypeEdit">取消编辑</button>
          <view class="outfit-type-list"><view wx:for="{{modal.types}}" wx:key="id" class="outfit-type-row"><text class="grow">{{item.name}}</text><button data-id="{{item.id}}" data-action="move" data-direction="up" bindtap="mutateOutfitType">上移</button><button data-id="{{item.id}}" data-action="move" data-direction="down" bindtap="mutateOutfitType">下移</button><button data-id="{{item.id}}" bindtap="editOutfitType">编辑</button><button class="danger-text" data-id="{{item.id}}" data-action="delete" bindtap="mutateOutfitType">删除</button></view></view>
          <button class="primary outfit-type-done" bindtap="returnToOutfit">完成</button>
        </block>
        <block wx:elif="{{modal.type === 'expense'}}">
          <view class="field-row"><label class="field"><text>日期</text><picker mode="date" value="{{modal.values.date}}" start="{{tripStartDate}}" end="{{tripEndDate}}" data-field="date" bindchange="bindDate"><view class="picker-value">{{modal.values.date}}</view></picker></label><label class="field"><text>类目</text><picker range="{{modal.categories}}" value="{{modal.categoryIndex}}" bindchange="bindExpenseCategory"><view class="picker-value">{{modal.values.category}} 〉</view></picker></label></view>
          <label class="field"><text>消费事项</text><input cursor-spacing="140" value="{{modal.values.title}}" placeholder="例如：晚餐、民宿订金" data-field="title" bindinput="bindInput"/><text wx:if="{{fieldErrors.title}}" class="field-error">{{fieldErrors.title}}</text></label>
          <view class="field-row"><label class="field"><text>金额</text><input cursor-spacing="140" type="digit" value="{{modal.values.amount}}" placeholder="0.00" data-field="amount" bindinput="bindInput"/><text wx:if="{{fieldErrors.amount}}" class="field-error">{{fieldErrors.amount}}</text></label><label class="field"><text>币种</text><picker range="{{modal.currencyLabels}}" value="{{modal.currencyIndex}}" bindchange="bindExpenseCurrency"><view class="picker-value">{{modal.currencyLabel}} 〉</view></picker></label></view>
          <label wx:if="{{modal.values.currency !== expenseSettings.baseCurrency}}" class="field"><text>兑换为{{modal.baseCurrencyLabel}}的汇率</text><input cursor-spacing="140" type="digit" value="{{modal.values.exchangeRateToBase}}" placeholder="1 原币 = 多少本位币" data-field="exchangeRateToBase" bindinput="bindInput"/><text wx:if="{{fieldErrors.exchangeRateToBase}}" class="field-error">{{fieldErrors.exchangeRateToBase}}</text></label>
          <label class="field"><text>谁付款</text><picker range="{{modal.payers}}" range-key="name" value="{{modal.payerIndex}}" bindchange="bindExpensePayer"><view class="picker-value">{{modal.payers[modal.payerIndex].name}} 〉</view></picker></label>
          <label class="field"><text>怎么分</text><picker range="{{modal.splitModes}}" range-key="label" value="{{modal.splitIndex}}" bindchange="bindSplitMode"><view class="picker-value">{{modal.splitModes[modal.splitIndex].label}} 〉</view></picker></label>
          <view wx:if="{{modal.values.splitMode !== 'personal'}}" class="expense-participants"><text class="field-label">参与成员</text><view wx:for="{{modal.members}}" wx:key="id" class="expense-participant"><view class="expense-participant-toggle" data-index="{{index}}" bindtap="toggleExpenseMember"><view class="check {{item.selected ? 'done' : ''}}">{{item.selected ? '✓' : ''}}</view><image src="{{item.avatarSrc}}" mode="aspectFill"/><text class="grow">{{item.name}}</text></view><input cursor-spacing="140" wx:if="{{modal.values.splitMode === 'custom' && item.selected}}" type="digit" value="{{item.amount}}" placeholder="分摊金额" data-index="{{index}}" bindinput="bindCustomShare"/></view></view>
          <view class="receipt-actions"><button class="receipt-picker" bindtap="chooseExpenseReceipt">{{modal.receiptLocalPath || (!modal.values.removeReceipt && modal.values.receiptFileId) ? '替换票据照片' : '＋ 添加票据照片'}}</button><button wx:if="{{modal.receiptLocalPath || (!modal.values.removeReceipt && modal.values.receiptFileId)}}" class="receipt-remove danger-text" bindtap="removeExpenseReceipt">移除照片</button></view>
          <label class="field"><text>备注（选填）</text><textarea cursor-spacing="140" value="{{modal.values.note}}" placeholder="地点、用途或补充说明" data-field="note" bindinput="bindInput"/></label>
        </block>
        <block wx:elif="{{modal.type === 'expenseSettings'}}"><label class="field"><text>本位币</text><picker range="{{modal.currencyLabels}}" value="{{modal.currencyIndex}}" bindchange="bindSettingsCurrency"><view class="picker-value">{{modal.currencyLabel}} 〉</view></picker></label><label class="field"><text>全行程预算</text><input cursor-spacing="140" type="digit" value="{{modal.values.budget}}" placeholder="不填写则不设预算" data-field="budget" bindinput="bindInput"/><text wx:if="{{fieldErrors.budget}}" class="field-error">{{fieldErrors.budget}}</text></label><label class="field"><text>费用类目</text><textarea cursor-spacing="140" value="{{modal.values.categories}}" placeholder="使用顿号或逗号分隔" data-field="categories" bindinput="bindInput"/></label><view class="notice">已有旅行保留当前类目。停用类目时，历史费用仍会保留原分类。</view></block>
      </view></scroll-view>

