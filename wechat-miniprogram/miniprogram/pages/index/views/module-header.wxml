<view wx:if="{{!loading && !error}}" class="system-header" style="padding-top:{{systemContentTop}}px;--header-progress:{{headerScrollProgress || 0}}" bindtap="closeHeaderMenus">
 <view class="system-header-blur"></view>
 <view wx:if="{{tab === 'today' || !trip}}" class="mg-top"><view class="mg-brand"><image src="/assets/mastergo/svg_3b35dfdc.svg" mode="aspectFit"/><text>向野清单</text></view><include src="account-entry.wxml" /></view>
 <view wx:else class="rg-header"><view class="rg-module-title"><text wx:if="{{tab === 'route'}}" class="rg-greeting">行程</text><text wx:elif="{{tab === 'list'}}" class="rg-greeting">清单</text><text wx:elif="{{tab === 'outfit'}}" class="rg-greeting">穿搭</text><text wx:else class="rg-greeting">记账</text><view class="rg-title-accent" aria-hidden="true"></view></view><include src="account-entry.wxml" /></view>
</view>
