<view class="ee-page" id="expenses-{{expenseSegment}}" style="padding-top:{{systemContentTop}}px" bindtap="closeExpenseMenu">
  <image class="rg-atmosphere" src="/assets/mastergo-route/planning/svg_a7d2aa9f.svg" mode="scaleToFill"/>
  <view class="system-header-space"></view>
  <view class="ee-book"><text>旅行账本</text><button wx:if="{{isOwner && !guestMode && !trip.archived}}" class="ee-settings" bindtap="openExpenseSettings" aria-label="记账设置"><image src="/assets/mastergo/svg_aa12c6ee.svg" mode="aspectFit"/></button></view>
  <view class="ee-total-label"><image src="/assets/mastergo-expenses/svg_bf1045d6.svg" mode="aspectFit"/><text>全行程支出</text></view>
  <view class="ee-total-line"><text class="ee-home-total {{expenseView.totalNumber.length > 8 ? 'compact' : ''}}">{{expenseView.totalNumber}}</text><text class="ee-currency">{{expenseView.symbol}}</text><text class="ee-budget">{{expenseSummary.budgetMinor != null ? '/' + expenseView.budgetNumber : expenseView.budgetNumber}}</text></view>
  <view class="ee-budget-track"><view style="width:{{expenseSummary.budgetProgress}}%"></view></view>
  <view class="ee-tabs"><button class="{{expenseSegment === 'details' ? 'selected' : ''}}" data-segment="details" bindtap="setExpenseSegment">明细</button><button class="{{expenseSegment === 'split' ? 'selected' : ''}}" data-segment="split" bindtap="setExpenseSegment">分账</button><button class="{{expenseSegment === 'stats' ? 'selected' : ''}}" data-segment="stats" bindtap="setExpenseSegment">统计</button></view>
  <view class="ee-segment-content"><block wx:if="{{expenseSegment === 'details'}}">
    <scroll-view class="rg-dates ee-dates" scroll-x enable-flex show-scrollbar="false" scroll-into-view="expense-date-{{selectedDate}}" scroll-with-animation="{{!reducedMotion}}"><view class="rg-date-row"><button wx:for="{{expenseView.dates}}" wx:key="value" id="expense-date-{{item.value}}" class="rg-date {{item.active ? 'selected' : ''}}" data-date="{{item.value}}" bindtap="selectDate"><text>{{item.weekday}}</text><text class="rg-day">{{item.day}}</text><text>{{item.month}}月</text><view class="rg-date-dot {{item.hasContent ? 'has-content' : ''}}"></view></button></view></scroll-view>
    <view wx:if="{{expenseView.activeFilters}}" class="ee-filter-state"><text>已筛选明细</text><button bindtap="resetExpenseFilters">清除筛选</button></view>
    <view class="ee-detail-days">
      <view wx:for="{{expenseView.groups}}" wx:for-item="group" wx:key="date" class="ee-day">
        <view class="ee-day-head"><text>{{group.dateLabel}}</text><view class="ee-dot"></view><text class="ee-day-count">{{group.count}}笔</text><view class="ee-day-total"><text>{{expenseView.symbol}}</text><text class="ee-num">{{group.totalNumber}}</text></view></view>
        <view class="ee-entries">
          <view wx:for="{{group.entries}}" wx:for-item="entry" wx:key="id" class="ee-entry {{expenseMenuId === entry.id ? 'menu-open' : ''}}" data-kind="expense" data-id="{{entry.id}}" bindtap="openDetail" hover-class="motion-pressed" hover-stop-propagation="true">
            <view class="ee-entry-head"><text class="ee-entry-title">{{entry.title}}</text><text class="ee-category">{{entry.category}}</text><button wx:if="{{!trip.archived}}" class="ee-more" data-id="{{entry.id}}" catchtap="toggleExpenseMenu" aria-label="{{entry.title}}更多操作"><image src="/assets/mastergo-expenses/svg_9e67a583.svg" mode="aspectFit"/></button></view>
            <text class="ee-entry-date">{{entry.date}}</text>
            <view class="ee-entry-bottom"><view class="ee-payer"><image src="{{entry.payerAvatar}}" mode="aspectFill"/><text>付款</text></view><image wx:for="{{entry.participantAvatars}}" wx:for-item="person" wx:key="memberId" class="ee-person" src="{{person.src}}" mode="aspectFill"/><text class="ee-entry-amount">-{{entry.displayAmount}}</text></view>
            <text wx:if="{{entry.baseDisplay}}" class="ee-conversion">{{entry.baseDisplay}}</text><view wx:if="{{entry.note}}" class="ee-note">{{entry.note}}</view>
            <view wx:if="{{!trip.archived && expenseMenuId === entry.id}}" class="xy-pop-menu ee-menu" catchtap="stopBubble"><button data-id="{{entry.id}}" bindtap="openExpense">编辑</button><button data-id="{{entry.id}}" bindtap="deleteExpense">删除</button></view>
          </view>
        </view><view wx:if="{{!group.entries.length}}" class="ee-empty ee-empty-state"><image src="/assets/icons/empty-expenses-beads-v2.png" mode="aspectFit" aria-label="像素拼豆旅行收据"/><text>这一天还没有支出</text></view>
      </view><view wx:if="{{!expenseView.groups.length}}" class="ee-empty ee-glass"><text>没有符合筛选条件的费用</text><button bindtap="resetExpenseFilters">清除筛选</button></view>
    </view>
  </block>
  <block wx:elif="{{expenseSegment === 'split'}}">
    <view class="ee-my-summary"><view><view class="ee-kpi-label"><image src="/assets/mastergo-expenses/svg_4ffd286c.svg" mode="aspectFit"/><text>我的实际付款</text></view><view class="ee-kpi-number"><text>{{expenseView.symbol}}</text><text class="ee-num">{{expenseView.paidNumber}}</text></view></view><view><view class="ee-kpi-label"><image src="/assets/mastergo-expenses/svg_d9286587.svg" mode="aspectFit"/><text>我的应承担</text></view><view class="ee-kpi-number"><text>{{expenseView.symbol}}</text><text class="ee-num">{{expenseView.owedNumber}}</text></view></view></view>
    <view class="ee-member-section ee-glass"><button class="ee-member-heading" bindtap="openExpenseSettlements" aria-label="成员结余，查看建议结算和结算记录">成员结余</button>
    <view class="ee-members"><view wx:for="{{expenseView.members}}" wx:key="memberId" class="ee-member" bindtap="openExpenseSettlements"><view class="ee-member-inner"><view class="ee-member-head"><image src="{{item.avatarSrc}}" mode="aspectFill"/><text>{{item.name}}</text><text class="ee-member-net-label">{{item.netLabel}}</text><text class="ee-member-net {{item.netMinor < 0 ? 'owing' : ''}}">{{item.netAmount}}</text></view><view class="ee-member-metrics"><view><view class="ee-kpi-label"><image src="/assets/mastergo-expenses/svg_4ffd286c.svg" mode="aspectFit"/><text>已付</text></view><view class="ee-kpi-number"><text>{{expenseView.symbol}}</text><text class="ee-num">{{item.paidNumber}}</text></view></view><view><view class="ee-kpi-label"><image src="/assets/mastergo-expenses/svg_d9286587.svg" mode="aspectFit"/><text>承担</text></view><view class="ee-kpi-number"><text>{{expenseView.symbol}}</text><text class="ee-num">{{item.owedNumber}}</text></view></view></view></view></view></view></view>
  </block>
  <block wx:else>
    <view class="ee-stats-summary ee-glass"><view><view class="ee-kpi-label"><image src="/assets/mastergo-expenses/svg_4ffd286c.svg" mode="aspectFit"/><text>支出</text></view><view class="ee-kpi-number"><text>{{expenseView.symbol}}</text><text class="ee-num">{{expenseView.statsTotalNumber}}</text></view></view><view><view class="ee-kpi-label"><image src="/assets/mastergo-expenses/svg_f00ee709.svg" mode="aspectFit"/><text>结余</text></view><view class="ee-kpi-number"><text>{{expenseView.symbol}}</text><text class="ee-num">{{expenseView.balanceNumber}}</text></view></view></view>
    <view class="ee-category-chart ee-glass"><text class="ee-section-title">支出分类构成</text><view class="ee-chart-legend"><button wx:for="{{expenseView.categories}}" wx:key="category" data-field="category" data-value="{{item.category}}" bindtap="drillExpense"><view style="background:{{item.color}}"></view><text>{{item.category}}</text></button></view>
      <view class="ee-pie-area"><view class="ee-pie-base"></view><view class="ee-pie-ring" style="background:{{expenseView.ringBackground}}"></view><view wx:for="{{expenseView.caps}}" wx:key="id" class="ee-pie-cap" style="background:{{item.color}};left:{{item.left}}%;top:{{item.top}}%"></view><view wx:for="{{expenseView.categories}}" wx:key="category" wx:if="{{index < 3}}" class="ee-pie-label label-{{index}}" style="color:{{item.color}}"><text>{{item.amountDisplay}}</text></view><image wx:if="{{expenseView.categories.length}}" class="ee-pie-line line-0" src="/assets/mastergo-expenses/svg_63b96594.svg" mode="aspectFit"/><image wx:if="{{expenseView.categories.length > 1}}" class="ee-pie-line line-1" src="/assets/mastergo-expenses/svg_e50050f7.svg" mode="aspectFit"/><image wx:if="{{expenseView.categories.length > 2}}" class="ee-pie-line line-2" src="/assets/mastergo-expenses/svg_59294556.svg" mode="aspectFit"/><text wx:if="{{!expenseView.categories.length}}" class="ee-chart-empty">暂无类目统计</text></view>
      <view class="ee-category-rows"><button wx:for="{{expenseView.categoryRows}}" wx:key="category" class="ee-category-row" data-field="category" data-value="{{item.category}}" bindtap="drillExpense"><view class="ee-category-row-head"><text>{{item.category}}</text><text class="ee-percent">{{item.percent}}%</text><text class="ee-blue">{{item.amountDisplay}}</text></view><view class="ee-category-row-bottom"><view class="ee-category-track"><view style="width:{{item.percent}}%"></view></view><text>{{item.count}}笔</text></view></button></view>
    </view>
    <view class="ee-daily-chart ee-glass"><text class="ee-section-title">每日支出趋势</text><scroll-view class="ee-daily-scroll" scroll-x enable-flex show-scrollbar="true"><view class="ee-daily-bars"><button wx:for="{{expenseView.daily}}" wx:key="date" data-field="date" data-value="{{item.date}}" bindtap="drillExpense" aria-label="{{item.dateLabel}} {{item.amountDisplay}}"><view class="ee-bar-track"><view style="height:{{item.percent}}%"></view></view><text>{{item.shortDate}}</text></button></view></scroll-view><view class="ee-scroll-track"><view></view></view></view>
    <view class="ee-ranking ee-glass"><text class="ee-section-title">单笔支出排行</text><view wx:for="{{expenseView.rankings}}" wx:key="id" class="ee-rank-row" data-kind="expense" data-id="{{item.id}}" bindtap="openDetail" hover-class="motion-pressed" hover-stop-propagation="true"><view class="ee-rank-head"><text class="ee-rank-index rank-{{index}}">{{item.rank}}</text><text>{{item.category}}</text><text class="ee-blue">{{item.displayAmount}}</text></view><text class="ee-entry-date">{{item.date}}</text><view class="ee-note">{{item.title}}</view></view><view wx:if="{{!expenseView.rankings.length}}" class="ee-empty">暂无支出记录</view></view>
  </block>
  </view>
</view>
<view wx:if="{{expenseSettlementsOpen}}" class="modal-mask" bindtap="closeExpenseSettlements"><view class="modal" catchtap="stopBubble"><view class="modal-head"><text>结算管理</text><button bindtap="closeExpenseSettlements" aria-label="关闭结算管理">×</button></view><scroll-view class="modal-body" scroll-y><view class="ee-settlement-summary"><text>全团待结算 {{expenseSummary.outstandingDisplay}}</text><text>我的结余 {{expenseSummary.myNetLabel}}</text></view><text class="ee-section-title">建议结算</text><view wx:if="{{!expenseSummary.plan.length}}" class="ee-empty">成员账目已经结清</view><view wx:for="{{expenseSummary.plan}}" wx:key="key" class="settlement-row"><view class="grow"><text>{{item.fromName}} → {{item.toName}}</text><text class="small">{{item.amountDisplay}}</text></view><button wx:if="{{!trip.archived}}" data-from="{{item.fromMemberId}}" data-to="{{item.toMemberId}}" data-amount="{{item.amountMinor}}" bindtap="saveSettlement">标记结清</button></view><text class="ee-section-title">结算记录</text><text class="small">已结算 {{expenseSummary.settledDisplay}}</text><view wx:for="{{settlements}}" wx:key="id" class="settlement-row"><view class="grow"><text>{{item.fromName}} → {{item.toName}}</text><text class="small">{{item.date}} · {{item.amountDisplay}}</text></view><button wx:if="{{!trip.archived}}" class="danger-text" data-id="{{item.id}}" bindtap="deleteSettlement">撤销</button></view></scroll-view></view></view>
