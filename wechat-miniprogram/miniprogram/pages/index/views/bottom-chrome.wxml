<!-- Foreground actions live beside the navigation, outside each content stacking context. -->
<view wx:if="{{!modal && !detail && !routeMapOpen && !expenseSettlementsOpen && !loginPrompt && !routeMenu && !listItemMenuId && !categoryMenuId && !outfitMenu && !expenseMenuId}}" class="bottom-haze" aria-hidden="true"><view class="haze-soft"></view><view class="haze-mid"></view><view class="haze-deep"></view><view class="haze-base"></view></view>
<block wx:if="{{trip && !trip.archived}}">
 <button wx:if="{{tab === 'route' && routeSection === 'planning'}}" class="rg-add-event" data-date="{{selectedDate}}" bindtap="openEvent" aria-label="添加安排"><image class="floating-create-background" src="/assets/mastergo-route/create-background.png" mode="scaleToFill"/><image class="floating-create-plus" src="/assets/mastergo-route/create-icon.svg" mode="aspectFit"/><text>添加安排</text></button>
 <button wx:elif="{{tab === 'outfit'}}" class="xy-list-fixed-add xy-outfit-fixed-add" bindtap="openOutfit" aria-label="添加穿搭"><image class="floating-create-background" src="/assets/mastergo-route/create-background.png" mode="scaleToFill"/><image class="floating-create-plus" src="/assets/mastergo-route/create-icon.svg" mode="aspectFit"/><text>添加穿搭</text></button>
 <button wx:elif="{{tab === 'list'}}" class="xy-list-fixed-add" bindtap="openCategory" aria-label="添加类目"><image class="floating-create-background" src="/assets/mastergo-route/create-background.png" mode="scaleToFill"/><image class="floating-create-plus" src="/assets/mastergo-route/create-icon.svg" mode="aspectFit"/><text>添加类目</text></button>
 <button wx:elif="{{tab === 'expenses'}}" class="xy-list-fixed-add ee-add" bindtap="openExpense" aria-label="记一笔"><image class="floating-create-background" src="/assets/mastergo-route/create-background.png" mode="scaleToFill"/><image class="floating-create-plus" src="/assets/mastergo-route/create-icon.svg" mode="aspectFit"/><text>记一笔</text></button>
</block>
