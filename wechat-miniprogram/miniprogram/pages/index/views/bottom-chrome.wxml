<!-- Foreground actions live beside the navigation, outside each content stacking context. -->
<view wx:if="{{!modal && !detail && !routeMapOpen && !expenseSettlementsOpen && !loginPrompt && !routeMenu && !listItemMenuId && !categoryMenuId && !outfitMenu && !expenseMenuId}}" class="bottom-haze" aria-hidden="true"><view class="haze-soft"></view><view class="haze-mid"></view><view class="haze-deep"></view><view class="haze-base"></view></view>
<block wx:if="{{trip && !trip.archived}}">
 <button wx:if="{{tab === 'route' && routeSection === 'planning'}}" class="rg-add-event" data-date="{{selectedDate}}" bindtap="openEvent" aria-label="添加安排"><view class="xy-add-flow" aria-hidden="true"><view class="xy-add-flow-ring"></view><view class="xy-add-flow-core"></view></view><image src="/assets/mastergo-route/planning/svg_f896667a.svg"/><text>添加安排</text></button>
 <button wx:elif="{{tab === 'list' && listSection === 'outfit'}}" class="xy-list-fixed-add xy-outfit-fixed-add" bindtap="openOutfit" aria-label="添加穿搭"><view class="xy-add-flow" aria-hidden="true"><view class="xy-add-flow-ring"></view><view class="xy-add-flow-core"></view></view><image src="/assets/mastergo-list/shared/svg_1e09e1de.svg" mode="aspectFit"/><text>添加穿搭</text></button>
 <button wx:elif="{{tab === 'list'}}" class="xy-list-fixed-add" bindtap="openCategory" aria-label="添加类目"><view class="xy-add-flow" aria-hidden="true"><view class="xy-add-flow-ring"></view><view class="xy-add-flow-core"></view></view><image src="/assets/mastergo-list/public/svg_3265a1ac.svg" mode="aspectFit"/><text>添加类目</text></button>
 <button wx:elif="{{tab === 'expenses' && expenseSegment === 'details'}}" class="xy-list-fixed-add ee-add" bindtap="openExpense" aria-label="记一笔"><view class="xy-add-flow" aria-hidden="true"><view class="xy-add-flow-ring"></view><view class="xy-add-flow-core"></view></view><image src="/assets/mastergo-expenses/svg_dc089b5f.svg" mode="aspectFit"/><text>记一笔</text></button>
</block>
