<scroll-view class="rg-dates xy-outfit-dates" scroll-x enable-flex show-scrollbar="false" scroll-left="{{routeDateScroll}}" scroll-with-animation="{{!reducedMotion}}"><view class="rg-date-row"><button wx:for="{{dates}}" wx:key="value" class="rg-date {{item.active ? 'selected' : ''}}" data-date="{{item.value}}" bindtap="selectDate"><text>{{item.weekday}}</text><text class="rg-day">{{item.day}}</text><text>{{item.month}}月</text><view class="rg-date-dot {{item.hasContent ? 'has-content' : ''}}"></view></button></view></scroll-view>
<view class="rg-date-title xy-outfit-date-title"><text>{{routePrettyDate}}</text><view class="rg-title-dot"></view><text>{{routeWeekday}}</text><view class="rg-title-dot"></view><text>{{routeDayLabel}}</text><image src="/assets/mastergo-route/planning/svg_36d81f0a.svg" mode="aspectFit"/></view>
<view class="xy-outfit-weather"><view class="xy-weather-place"><text>{{weather && weather.available ? weather.location : weatherLoading ? '加载中' : '天气暂缺'}}</text><text>{{weather && weather.available ? weather.condition : '—'}}</text></view><view class="xy-weather-sun"><image wx:if="{{weather && weather.available && weather.code <= 2}}" src="/assets/mastergo-list/shared/svg_6e54e561.svg" mode="aspectFit"/><text wx:else>{{weather && weather.available ? weather.condition : '—'}}</text></view><view class="xy-weather-range"><text>{{weather && weather.available ? weather.low + '°' : '—'}}</text><view class="xy-weather-track"><view></view></view><text>{{weather && weather.available ? weather.high + '°' : '—'}}</text></view></view>
<view wx:if="{{selectedOutfits.length}}" class="xy-outfit-groups">
  <view wx:for="{{selectedOutfits}}" wx:for-item="outfit" wx:key="id" class="xy-outfit-group {{outfitMenu.outfitId === outfit.id ? 'menu-open' : ''}}">
    <view class="xy-outfit-head"><text>{{outfit.scene || outfit.title}}</text><button wx:if="{{!trip.archived}}" class="xy-new-button" data-outfit="{{outfit.id}}" bindtap="openNewOutfitItem"><image src="/assets/mastergo-profile/svg_116003db.svg" mode="aspectFit"/><text>新增</text></button><button wx:if="{{!trip.archived}}" class="xy-outfit-group-more" data-id="{{outfit.id}}" data-outfit="{{outfit.id}}" data-kind="outfit" catchtap="toggleOutfitMenu" aria-label="{{outfit.title}}更多操作"><image src="/assets/mastergo-list/public/svg_2e9698ef.svg" mode="aspectFit"/></button>
      <view wx:if="{{!trip.archived && outfitMenu.id === outfit.id && outfitMenu.kind === 'outfit'}}" class="xy-pop-menu" catchtap="stopBubble"><button data-id="{{outfit.id}}" bindtap="openOutfit">编辑整套</button><button data-outfit="{{outfit.id}}" bindtap="openNewOutfitItem">新增衣物</button><button data-action="deleteOutfit" data-id="{{outfit.id}}" bindtap="confirmDelete">删除整套</button></view>
    </view>
    <view class="xy-outfit-grid">
      <view wx:for="{{outfit.items}}" wx:for-item="piece" wx:key="id" class="xy-outfit-piece {{outfitMenu.id === piece.id ? 'menu-open' : ''}}">
        <view class="xy-piece-media" data-outfit="{{outfit.id}}" data-item="{{piece.id}}" bindtap="previewOutfitItem" hover-class="motion-pressed" hover-stop-propagation="true"><image wx:if="{{piece.photoSrc}}" src="{{piece.photoSrc}}" mode="aspectFill"/><view wx:else class="xy-piece-placeholder"><image src="/assets/icons/garment-{{piece.garmentIcon}}.svg" mode="aspectFit"/></view><text class="xy-piece-type">{{piece.typeName}}</text></view>
        <view class="xy-piece-bottom"><text>{{piece.name}}</text><button wx:if="{{!trip.archived}}" data-id="{{piece.id}}" data-outfit="{{outfit.id}}" data-kind="piece" catchtap="toggleOutfitMenu" aria-label="{{piece.name}}更多操作"><image src="/assets/mastergo-list/public/svg_2e9698ef.svg" mode="aspectFit"/></button></view>
        <view wx:if="{{!trip.archived && outfitMenu.id === piece.id && outfitMenu.kind === 'piece'}}" class="xy-pop-menu xy-piece-menu" catchtap="stopBubble"><button data-outfit="{{outfit.id}}" data-item="{{piece.id}}" bindtap="openOutfitItem">编辑衣物</button><button data-outfit="{{outfit.id}}" data-item="{{piece.id}}" bindtap="deleteOutfitItem">删除衣物</button></view>
      </view>
    </view>
  </view>
</view>
<view wx:else class="xy-outfit-empty"><text>空状态</text></view>
