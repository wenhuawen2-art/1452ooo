<view class="new-loading-surface" aria-label="向野正在加载">
  <image class="new-loading-reference" src="/assets/loading-new/clean-background.webp" mode="scaleToFill" aria-hidden="true" />
  <image wx:if="{{!reducedMotion}}" class="new-loading-landscape" src="/assets/loading-new/kite-landscape.webp" mode="scaleToFill" aria-hidden="true" />
  <image wx:else class="new-loading-landscape" src="/assets/loading-new/kite-landscape-still.webp" mode="scaleToFill" aria-hidden="true" />
</view>
