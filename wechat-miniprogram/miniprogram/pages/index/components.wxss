.detail-actions{display:flex;gap:20rpx;margin-top:24rpx}
.detail-actions .outline{min-width:160rpx}
.trip-manage-toggle{width:100%;display:flex;align-items:center;justify-content:space-between;min-height:88rpx;font-size:26rpx;color:#42658b;margin-top:20rpx;border-top:1rpx solid #e7edf4}
.motion-paused .today-hero:before,.motion-paused .module-hero:before{animation-play-state:paused!important}
.reduced-motion .today-hero:before,.reduced-motion .module-hero:before,.reduced-motion .content,.reduced-motion .modal,.reduced-motion .nav-item,.reduced-motion .progress-fill{animation:none!important;transition:none!important}

