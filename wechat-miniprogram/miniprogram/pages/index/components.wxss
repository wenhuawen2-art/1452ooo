.nav-pressed,button:active{transform:scale(.97);opacity:.85}
.field-error,.save-error{display:block;color:#b6413d;font-size:12px;line-height:1.5;padding:10rpx 0}
.outfit-editor-item{min-height:0!important;padding:20rpx;margin-bottom:18rpx;border-radius:24rpx;background:#fff}
.outfit-editor-item input{min-height:88rpx;font-size:28rpx}
.outfit-editor-photo{height:260rpx}
.outfit-photo-actions button,.outfit-editor-item button{min-height:88rpx;font-size:12px}
.receipt-picker,.receipt-remove{min-height:88rpx}
.editor-page{padding:0;background:#f7f9fc;min-height:100vh;color:#17212c}
.editor-header{box-sizing:border-box;display:flex;align-items:center;gap:18rpx;padding-left:28rpx;padding-right:210rpx;font-size:36rpx;font-weight:600;position:fixed;left:0;right:0;top:0;background:#f7f9fc;z-index:5}
