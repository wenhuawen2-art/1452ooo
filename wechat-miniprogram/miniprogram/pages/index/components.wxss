/* Shared controls, lists, maps and forms. One declaration per selector. */
.page{box-sizing:border-box;padding-left:16rpx;padding-right:16rpx;--ink:#17212c;--blue:#438fe8;--muted:#738397;min-height:100vh;padding:68px 36rpx calc(190rpx + env(safe-area-inset-bottom));color:var(--ink);font-size:30rpx;line-height:1.55;background:linear-gradient(180deg,#438fe8 0,#8bbaf0 380rpx,#dcebfa 720rpx,#f8fafc 1040rpx,#f8fafc 100%);position:relative;overflow-x:hidden}
.state-screen{min-height:80vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:24rpx;text-align:center}
.state-title{font-size:40rpx;font-weight:700}
.spinner{width:52rpx;height:52rpx;border:6rpx solid #dbe9fb;border-top-color:#4f8ee8;border-radius:50%;animation:spin .8s linear infinite}
.welcome,.content{max-width:1040rpx;margin:0 auto}
.eyebrow{color:#3978d4;font-size:12px;font-weight:600}
.welcome-title{white-space:pre-line;display:block;font-size:76rpx;color:white;line-height:1.22;font-weight:500;margin:28rpx 0}
.welcome-copy{white-space:pre-line;display:block;line-height:1.7;font-size:28rpx;color:#eaf5ff;margin:26rpx 0 90rpx}
.hero-card{margin:32rpx 0;padding:36rpx;border-radius:40rpx;background:linear-gradient(145deg,#c7e6ff,#eff8ff);box-shadow:0 24rpx 60rpx rgba(80,130,190,.18);display:none}
.route-line{height:72rpx;margin:28rpx 0;border-bottom:5rpx solid #76a8ed;border-radius:50%}
.hero-foot{font-weight:600}
.welcome-point{display:flex;gap:20rpx;margin:36rpx 0}
.point-icon{place-items:center;color:#3478db;background:#ffffff70;border-radius:50%;width:88rpx;height:88rpx;display:flex;align-items:center;justify-content:center}
.point-title{display:block;font-weight:600;margin-bottom:6rpx}
button{margin:0;padding:0;background:transparent;line-height:1.3}
.primary{width:100%;display:flex;align-items:center;justify-content:center;font-weight:600;min-height:96rpx;border-radius:100rpx;background:#17212c;font-size:30rpx;color:#fff;padding:20rpx 30rpx;box-sizing:border-box;box-shadow:0 8rpx 20rpx #17212c0b}
.primary.small{width:auto;min-height:72rpx;padding:0 36rpx}
.outline{display:flex;align-items:center;justify-content:center;border:0;min-height:88rpx;font-size:26rpx;border-radius:100rpx;padding:16rpx 24rpx;color:#285e9d;background:#e9f1fb}
.outline.full{width:100%;margin-top:16rpx}
.muted{display:block;color:#8a95a6;font-size:12px}
.pill,.tag{display:inline-flex;padding:8rpx 16rpx;border-radius:16rpx;background:#dcecff;color:#3978d4;font-size:12px;font-weight:600}
.card{border:0;box-shadow:none;background:#ffffffbd;border-radius:32rpx}
.row,.section-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx}
.grow{flex:1;min-width:0}
.notice{padding:24rpx;border-radius:24rpx;background:#fff2df;color:#8b4c0e;font-size:26rpx}
.date-strip{max-width:1040rpx;margin:0 -4rpx 24rpx;white-space:nowrap;width:calc(100% + 8rpx);display:flex}
.date-chip{display:inline-flex;vertical-align:top;margin-right:16rpx;flex-direction:column;align-items:center;justify-content:center;width:96rpx;min-width:88rpx;height:140rpx;margin:0 8rpx 0 0;background:transparent;color:#466a94;border-radius:100rpx;box-shadow:none;transition:background .18s,color .18s,transform .18s}
.date-chip .strong{font-size:38rpx;margin:4rpx 0;font-weight:500;color:#17212c}
.date-chip .small{font-size:12px}
.date-chip.active{background:#ffffffdb;color:#224e80;box-shadow:0 8rpx 24rpx #3264a010}
.date-chip.active .strong{color:#17212c}
.content{max-width:900rpx;padding-bottom:24rpx;animation:content-arrive .24s ease-out}
.page-title{display:block;font-size:48rpx;line-height:1.2;font-weight:700;margin:20rpx 0 32rpx}
.card-title{font-size:38rpx;font-weight:700}
.countdown{height:190rpx;display:flex;align-items:center;justify-content:center;gap:10rpx;color:#39465b}
.countdown .strong{font-size:88rpx;line-height:1;font-weight:700;color:#14213a}
.trip-dates{padding:28rpx 0 0;margin-top:30rpx;border-top:1rpx solid #ffffff4d;background:transparent;border-radius:0;display:flex;align-items:center;justify-content:space-between;gap:12rpx}
.trip-dates view{display:flex;flex-direction:column;gap:6rpx}
.trip-dates .strong{font-size:26rpx;font-weight:500;color:white}
.arrow{font-size:44rpx;color:#78a0cf}
.section-title{display:block;font-size:36rpx;font-weight:700;margin:42rpx 0 22rpx}
.section-title.plain{margin:0}
.section-title .small{font-size:12px;color:#8c96a4;font-weight:400}
.stats{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}
.stat-card{text-align:left;padding:30rpx;background:#ffffff90;border-radius:28rpx}
.stat-card>text{font-size:26rpx;color:#536e8e}
.stat-card .strong{font-size:52rpx;font-weight:500}
.stat-card .small{color:#8a95a6}
.progress{height:10rpx;margin-top:22rpx;border-radius:6rpx;background:#e6ebf2;overflow:hidden}
.progress .progress-fill{display:block;height:100%;background:linear-gradient(90deg,#69a8f8,#477fe2);border-radius:6rpx}
.weather{padding:28rpx;border:2rpx solid #cee0f5;background:#eff7ff}
.today-weather{background:linear-gradient(130deg,#e2edfa,#fff7e8);padding:34rpx;border:0;margin-top:20rpx}
.weather-row{display:flex;align-items:center;gap:16rpx}
.weather-icon{font-size:52rpx}
.weather .strong,.weather text,.weather .small{display:block}
.temp{font-size:60rpx;font-weight:400}
.section-head{margin:34rpx 0 22rpx;gap:16rpx;flex-wrap:wrap}
.schedule{margin-bottom:24rpx;overflow:hidden;background:transparent;border-radius:0;padding:0;margin:30rpx 0}
.schedule-head{display:flex;align-items:center;border-bottom:2rpx dashed #cfdaea;position:relative;justify-content:flex-start;padding:12rpx 0;gap:12rpx}
.schedule-head view text{display:block;color:#3978d4;margin-top:6rpx}
.event-row{display:flex;border-bottom:0;padding:20rpx 0;gap:20rpx}
.event-row:last-child{border-bottom:0}
.event-copy{flex:1;min-width:0}
.event-copy>.strong,.event-copy>text{display:block}
.event-time{font-weight:700;font-size:12px;color:#3b79be;margin:0 0 8rpx}
.event-copy>.strong{margin:10rpx 0;color:#3978d4;font-size:32rpx;font-weight:500}
.address{font-size:12px;color:#647187}
.route-box{display:grid;grid-template-columns:auto minmax(0,1fr) auto minmax(0,1fr) auto;align-items:center;margin-top:22rpx;border-radius:20rpx;column-gap:8rpx;width:100%;box-sizing:border-box;padding:18rpx 0;background:transparent;gap:12rpx;flex-wrap:wrap}
.route-box .start,.route-box .end{padding:12rpx;border-radius:14rpx;color:#fff;background:#80acf0;font-size:12px;font-weight:600}
.route-box .end{background:#add86c}
.route-arrow{color:#72a2e7;font-size:34rpx;text-align:center}
.icon-actions{display:flex;gap:0;align-items:center}
.icon-actions button,.mini-btn{width:68rpx;height:68rpx;border:0;border-radius:50%;display:flex;place-items:center;color:#4f86dc;background:#f8fbff;align-items:center;justify-content:center}
.hotel{display:flex;align-items:center;gap:16rpx;padding:28rpx;flex-wrap:wrap}
.hotel .strong,.hotel text{display:block;margin:6rpx 0}
.empty{padding:70rpx 30rpx;color:#76879a;text-align:center;background:#ffffff75;line-height:1.8}
.empty .outline{margin:20rpx auto 0}
.ticket-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}
.ticket{padding:12rpx;border-radius:24rpx;background:#fff;text-align:left}
.ticket image{width:100%;height:180rpx;border-radius:18rpx}
.ticket .strong,.ticket text{display:block;margin:8rpx}
.segment{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);align-items:center;padding:8rpx;gap:4rpx;border-radius:100rpx;background:#e5ecf3;margin:24rpx 0}
.segment button{width:100%;min-width:0;height:72rpx;display:flex;align-items:center;justify-content:center;text-align:center;min-height:88rpx;border-radius:100rpx;color:#697b90;font-size:28rpx;transition:background .18s,color .18s}
.segment button.active{background:#fff;color:#111827;font-weight:600;box-shadow:0 6rpx 18rpx rgba(45,68,96,.08)}
.progress-card{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-top:24rpx;padding:28rpx}
.progress-label{display:block;color:#5b6574;font-size:12px}
.progress-value{display:flex;align-items:baseline;gap:8rpx;margin-top:12rpx}
.progress-card .strong{font-size:56rpx;line-height:1;font-weight:700}
.progress-card .small{font-size:12px;color:#8a95a6}
.top-actions{display:grid;gap:10rpx;width:100%;justify-content:space-between}
.check-group{display:block;margin-top:40rpx;margin:34rpx 0}
.check-group .section-head{margin:0 0 24rpx;position:relative;gap:8rpx}
.list-card{padding:0 28rpx}
.check-row{display:flex;align-items:center;padding:20rpx 0;min-height:96rpx;border-bottom:1rpx solid #dde5ee;gap:4rpx}
.check-row:last-child{border-bottom:0}
.check{flex:none;padding:0;box-sizing:border-box;display:flex;align-items:center;justify-content:center;background:#fff;color:#fff;font-weight:500;line-height:1;text-align:center;width:44rpx;height:44rpx;min-width:44rpx;border:2rpx solid #b9c8d9;border-radius:50%;font-size:26rpx;transition:background .16s,transform .16s}
.check.done{box-shadow:0 4rpx 10rpx rgba(81,124,202,.18);background:#438fe8;border-color:#438fe8}
.item-title{font-size:30rpx;line-height:1.5}
.item-title.done{color:#8492a2;text-decoration:line-through}
.key-tag{display:inline-flex;margin-left:10rpx;padding:4rpx 8rpx;border-radius:10rpx;background:#fff0d9;color:#b46b13;font-size:12px}
.check-row .small{display:block;color:#5f89d2;font-size:12px;margin-top:4rpx}
.review{border-radius:14rpx;color:#567aa8;min-height:88rpx;padding:12rpx;font-size:12px;background:transparent}
.review.active{background:#e8f7dc;color:#54802b}
.profile{display:flex;align-items:center;gap:24rpx;padding:32rpx}
.profile image,.member image{width:96rpx;height:96rpx;border-radius:28rpx}
.profile .strong,.profile text,.member .strong,.member text{display:block}
.profile .strong{color:#111827;font-size:38rpx}
.profile text,.member text{color:#8a95a6;font-size:12px;margin-top:6rpx}
.profile-edit{width:68rpx;height:68rpx;display:grid;place-items:center;border:0;border-radius:50%;background:#edf4fd;color:#4f86dc;font-size:30rpx}
.trip-card{margin-bottom:20rpx;text-align:left;position:relative;padding:30rpx;margin:22rpx 0;background:white;border:0;border-radius:30rpx}
.trip-card.current{border:2rpx solid #78a7ef}
.trip-card>text{display:block;color:#647187;margin-top:16rpx}
.manage{padding:28rpx;margin-top:24rpx}
.member{display:flex;align-items:center;gap:18rpx;padding:20rpx 0;border-bottom:2rpx solid #edf0f4}
.member image{width:72rpx;height:72rpx}
.manage .primary{margin-top:24rpx}
.manage-grid{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;margin-top:20rpx}
.manage-grid button{height:72rpx;display:flex;align-items:center;justify-content:center;text-align:center;border-radius:20rpx;background:#edf4fd;color:#3978d4}
.danger-text{background:#fff0f0!important;color:#b94b46}
.bottom-nav{grid-template-columns:repeat(5,1fr);isolation:isolate;transform:translateZ(0);position:fixed;left:16px;right:16px;bottom:calc(16px + env(safe-area-inset-bottom));height:68px;padding:8px;background:rgba(255,255,255,.7);border:1px solid rgba(255,255,255,.9);border-radius:220px;display:flex;align-items:center;justify-content:space-between;box-shadow:0 16px 26px rgba(12,30,56,.06);backdrop-filter:blur(18px);z-index:30;max-width:430px;margin:auto;box-sizing:border-box}
.modal-mask{position:fixed;inset:0;display:flex;z-index:60;align-items:flex-end;background:#15283e66;backdrop-filter:blur(4px)}
.modal{display:flex;flex-direction:column;box-shadow:0 -20rpx 70rpx rgba(16,28,45,.18);width:100%;max-height:90vh;padding:32rpx 36rpx calc(28rpx + env(safe-area-inset-bottom));border-radius:44rpx 44rpx 0 0;background:#f7f9fc;box-sizing:border-box;animation:sheet-arrive .32s cubic-bezier(.2,.75,.25,1)}
.modal-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:20rpx;font-size:38rpx;font-weight:600;padding:0 0 22rpx;gap:20rpx}
.modal-head button{width:88rpx;height:88rpx;min-width:88rpx;border-radius:50%;font-size:40rpx;background:#e9eef5;display:flex;align-items:center;justify-content:center}
.modal-body{flex:1;overflow-y:auto;padding-bottom:2rpx;min-height:0;max-height:65vh;padding:0}
.modal-submit{margin-top:24rpx;flex-shrink:0}
.field{display:block;margin-bottom:22rpx;margin:0 0 24rpx}
.field>text,.field-label{display:block;margin:0 0 10rpx;font-size:26rpx;color:#62738a;margin-bottom:12rpx}
.field input,.field textarea,.picker-value{box-sizing:border-box;width:100%;min-height:96rpx;font-size:30rpx;color:#17212c;background:white;border:1rpx solid #e0e7ef;border-radius:22rpx;padding:24rpx;line-height:1.5}
.field textarea{height:176rpx}
.field-row{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}
.switch-row{display:flex;align-items:center;justify-content:space-between;padding:24rpx;border-radius:24rpx;background:#fff}
.avatar-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14rpx;margin:14rpx 0 28rpx}
.avatar{aspect-ratio:1;border-radius:26rpx;overflow:hidden;background:#fff;border:4rpx solid transparent}
.avatar image{width:100%;height:100%}
.avatar.selected{border-color:#568de5}
.avatar.custom{display:grid;place-items:center;font-size:42rpx;color:#568de5;border-style:dashed;border-color:#bfd3ef}
.template-card{width:100%;display:flex;gap:16rpx;padding:12rpx 24rpx;margin-bottom:14rpx;border-radius:24rpx;background:#fff;text-align:left;align-items:center;min-height:134rpx}
.template-card .strong,.template-card text,.template-card .small{display:block}
.template-card text{color:#667184;font-size:12px;margin:6rpx 0}
.template-card .small{color:#3978d4;font-size:12px;margin:0}
.template-symbol{width:110rpx;height:110rpx;border-radius:22rpx;background:transparent;color:#3978d4;display:block!important;place-items:center;font-weight:700;padding:0;box-sizing:border-box;flex:none}
.card,.hero-card,.date-chip.active,.segment button.active,.modal{display:flex;flex-direction:column;box-shadow:none}
.trip-card .strong{font-weight:500}
.trip-summary{display:block;text-align:left}
.trip-summary .row{align-items:center}
.trip-summary .strong{font-weight:600;font-size:34rpx}
.trip-summary-dates{display:block;font-size:12px;margin-top:18rpx;color:#738397}
.trip-card-actions{flex-wrap:wrap;justify-content:flex-end;display:flex;align-items:center;gap:12rpx}
.trip-expanded{padding-top:18rpx;border-top:2rpx solid #e6edf6;margin-top:26rpx}
.member-panel{background:#f4f7fa;padding:22rpx;border-radius:22rpx}
.member-heading{display:flex;align-items:center;justify-content:space-between;font-size:25rpx}
.member-panel .member{padding:16rpx 0}
.member-panel .member image{width:64rpx;height:64rpx}
.member-panel .primary{margin-top:12rpx;min-height:64rpx}
.clone-trip{width:100%;min-height:70rpx;margin-top:16rpx;border-radius:18rpx;background:#e6f1ff;color:#3978d4;font-size:26rpx;display:flex;align-items:center;justify-content:center;text-align:center;line-height:1.3;padding:0}
.trip-card .manage-grid{margin-top:16rpx}
.trip-card .trip-delete{position:absolute;right:18rpx;bottom:16rpx}
.tag-current{background:#dcecff;color:#3978d4}
.tag-active{background:#e4f5e8;color:#318653}
.tag-archived{background:#edf0f3;color:#8993a0}
.outline,.icon-actions button,.mini-btn,.profile-edit,.manage-grid button,.review{background:#e5effc}
.icon-actions button,.mini-btn,.profile-edit{background:#eef4fd}
.icon-actions .danger-text{background:#fff0f0!important}
.icon-actions .danger-text image{width:32rpx;height:32rpx}
.event-note{display:flex;align-items:flex-start;gap:12rpx;margin-top:16rpx;color:#52647d;font-size:12px;line-height:1.5;white-space:pre-wrap;overflow-wrap:anywhere;padding:16rpx 20rpx;background:#edf2f7;border-radius:18rpx}
.event-note-label{flex:none;color:#6187bb}
.event-note-content{flex:1;min-width:0}
.mini-btn.danger-text{background:#fff4f3}
.route-box .route-destination{justify-self:end;text-align:right}
.event-activity{display:flex;align-items:baseline;gap:16rpx;min-width:0;margin-top:10rpx}
.event-activity .strong{flex:none;color:#3978d4;font-weight:500;white-space:nowrap;font-size:34rpx;line-height:1.4}
.event-activity .address{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.confirmation{display:flex;align-items:center;gap:6rpx;color:#667184;font-size:12px;line-height:32rpx;margin-top:8rpx}
.confirmation image{width:32rpx;height:32rpx;border-radius:50%;flex:none}
.confirmation-name{color:#667184}
.confirmation-status{color:#5f89d2}
.login-screen{min-height:100vh;box-sizing:border-box;padding:120rpx 48rpx 80rpx;display:flex;flex-direction:column;align-items:center;background:#f4f7fb}
.login-brand{display:flex;flex-direction:column;align-items:center;margin-bottom:64rpx}
.login-brand image{width:136rpx;height:136rpx;border-radius:32rpx;margin-bottom:24rpx}
.login-title{font-size:44rpx;font-weight:700;margin-bottom:12rpx}
.wechat-avatar{width:176rpx;height:176rpx;padding:0;border:4rpx solid #d8e5f6;border-radius:40rpx;overflow:hidden;display:grid;place-items:center;background:#fff;color:#5b83bd;font-size:12px}
.wechat-avatar image{width:100%;height:100%}
.wechat-nickname{width:100%;height:96rpx;box-sizing:border-box;margin:36rpx 0 24rpx;padding:0 28rpx;border:2rpx solid #e0e7f0;border-radius:24rpx;background:#fff;text-align:center}
.wechat-login{width:100%}
.login-tip{margin-top:24rpx;color:#8491a4;font-size:12px;text-align:center}
.check-toggle-zone{align-self:stretch;min-width:0;flex:1;display:flex;align-items:center;padding:22rpx 0;gap:22rpx;min-height:88rpx}
.check-toggle-zone .grow{min-width:0}
.trip-delete{width:60rpx;height:60rpx;padding:14rpx;border-radius:50%;background:#fff0f0}
.trip-delete image{width:100%;height:100%}
.empty-tab,.empty-profile-page{padding-top:36rpx}
.empty-onboarding,.login-card{display:flex;flex-direction:column;align-items:center;gap:22rpx;text-align:center}
.empty-onboarding image,.login-card image{width:112rpx;height:112rpx;border-radius:28rpx}
.empty-onboarding .primary,.login-card .primary{width:100%;margin-top:10rpx}
.auth-modal{padding-bottom:calc(40rpx + env(safe-area-inset-bottom))}
.wechat-profile-collect,.wechat-profile-confirm{display:flex;flex-direction:column;align-items:center;text-align:center}
.wechat-profile-collect>.muted{margin-bottom:30rpx}
.wechat-profile-confirm>image{width:176rpx;height:176rpx;border-radius:40rpx;margin:20rpx 0 26rpx}
.wechat-profile-confirm>.muted{margin-top:12rpx}
.auth-actions{width:100%;display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:38rpx}
.auth-actions button{margin:0;background:#edf2f8}
.auth-actions .primary{background:#0d1a2b;color:#fff}
.profile-editor{max-height:72vh}
.profile-preview{display:block;width:176rpx;height:176rpx;border-radius:44rpx;margin:10rpx auto 32rpx;box-shadow:0 12rpx 30rpx rgba(62,91,126,.16)}
.profile-label{display:block;color:#6f7c90;font-size:12px;margin:24rpx 0 14rpx}
.profile-source-actions{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}
.profile-source-actions button{height:76rpx;display:flex;align-items:center;justify-content:center;margin:0;border:2rpx solid #dbe7f5;border-radius:20rpx;background:#f5f9ff;color:#3978d4;font-size:26rpx}
.profile-avatar-grid{display:grid;grid-template-columns:repeat(5,114rpx);gap:20rpx;justify-content:space-between}
.profile-avatar-grid button{width:114rpx;height:114rpx;margin:0;padding:0;border:4rpx solid transparent;border-radius:24rpx;background:#f1f5fa;overflow:hidden}
.profile-avatar-grid button.selected{border-color:#5a98ef;background:#e8f2ff}
.profile-avatar-grid image{display:block;width:100%;height:100%;border-radius:20rpx}
.profile-name{margin-top:28rpx}
.profile-editor .auth-actions{padding-bottom:8rpx}
.ticket-preview{width:100%;padding:0;background:transparent;text-align:left}
.ticket-actions{display:flex;gap:12rpx;padding:8rpx}
.ticket-actions button{flex:1;min-height:56rpx;border-radius:14rpx;background:#eef6ff;color:#3978d4;font-size:12px}
.schedule-head .strong{font-size:30rpx}
.schedule-head .tag{margin-left:auto;background:transparent;color:#8494a6;font-size:12px}
.period-bar{position:absolute;left:0;top:18rpx;bottom:18rpx;width:8rpx;border-radius:0 8rpx 8rpx 0;background:#57b77d;display:none}
.period-1 .period-bar{background:#5d91e7}
.period-2 .period-bar{background:#8b73df}
.event-timeline{width:18rpx;display:flex;flex-direction:column;align-items:center;flex:none}
