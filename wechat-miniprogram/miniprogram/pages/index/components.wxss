.route-original{display:block;margin-top:4rpx;color:#9aa4b3;font-size:12px}
.route-editor{flex:1;min-height:0;padding:22rpx 24rpx 150rpx;box-sizing:border-box}
.route-editor-point{margin-top:18rpx;padding:20rpx;border:2rpx solid #e3eaf4;border-radius:26rpx;background:#fff}
.route-editor-point.excluded{opacity:.52}
.route-editor-top{display:flex;align-items:center;gap:14rpx}
.route-editor-top input,.route-address-input{height:70rpx;padding:0 16rpx;border-radius:16rpx;background:#f4f7fb;box-sizing:border-box}
.route-address-input{width:100%;margin-top:12rpx}
.route-mode-picker{margin-top:12rpx;background:#f0f5fc}
.route-editor-actions{display:grid;grid-template-columns:1fr 1fr 1.5fr;gap:10rpx;margin-top:12rpx}
.route-editor-actions button{height:58rpx;border-radius:16rpx;background:#edf4fd;color:#3978d4;font-size:12px}
.route-search{margin-top:14rpx;padding:14rpx;border-radius:18rpx;background:#f4f7fb}
.route-search-bar{display:flex;gap:10rpx}
.route-search-bar input{height:66rpx;padding:0 14rpx;border-radius:14rpx;background:#fff}
.route-search-bar button{padding:0 20rpx;border-radius:14rpx;background:#4f8ee8;color:#fff}
.route-search-result{display:block;width:100%;margin-top:10rpx;padding:14rpx;text-align:left;border-radius:14rpx;background:#fff}
.route-search-result text{display:block}
.route-editor-bottom-space{height:80rpx}
.route-editor-footer{display:grid;grid-template-columns:1fr 1.5fr;gap:14rpx;padding:18rpx 24rpx 34rpx;background:#fff;box-shadow:0 -8rpx 24rpx rgba(32,51,79,.08)}
.route-editor-footer button{height:76rpx}
.route-editor-resolution{display:flex;align-items:center;gap:10rpx;margin:12rpx 0 0 62rpx;color:#8b96a7;font-size:12px}
button::after{border:0}
.check,.review,.ticket-actions button,.expense-entry-actions button,.expense-settings,.expense-filters button,.settlement-row button,.receipt-picker,.receipt-remove,.outfit-actions button,.outfit-item-heading button,.outfit-item-remove,.outfit-photo-picker button,.outfit-type-create button,.outfit-type-row button,.modal-head button,.route-map-head button,.route-editor-actions button,.route-search-bar button,.guest-banner button{display:flex;align-items:center;justify-content:center;text-align:center;box-sizing:border-box;line-height:1.2}
button[disabled]{opacity:.55}
.check-toggle-zone.readonly{cursor:default}
.receipt-actions{display:flex;gap:12rpx;margin-bottom:22rpx}
.receipt-actions .receipt-picker{min-width:0;flex:1;margin-bottom:0}
.receipt-remove{flex:none;height:82rpx;padding:0 20rpx;border-radius:22rpx;font-size:12px}
.outfit-item-editor-single{margin-bottom:0}
.outfit-item-editor-single .outfit-item-name{margin:0}
.outfit-item-editor-single .outfit-photo-picker{margin-top:18rpx}
.outfit-head-actions .mini-btn image{display:block;width:28rpx;height:28rpx}
.outfit-head-actions .outfit-item-create{background:#edf4fd;color:#3978d4;font-size:32rpx;font-weight:400;line-height:1}
.no-trip-profile{display:flex;align-items:center;gap:20rpx;padding:26rpx}
.no-trip-profile>image{width:88rpx;height:88rpx;border-radius:24rpx}
.no-trip-profile .muted{display:block;margin-top:8rpx}
.no-trip-empty{padding:48rpx 26rpx;min-height:360rpx;display:flex;flex-direction:column;justify-content:center;gap:14rpx}
.custom-header{position:absolute;top:0;left:0;right:0;box-sizing:border-box;display:flex;align-items:center;gap:18rpx;padding-left:40rpx;padding-right:200rpx;color:white;z-index:2}
.custom-brand{font-size:34rpx;font-weight:700;white-space:nowrap;letter-spacing:4rpx}
.custom-tagline{font-size:12px;opacity:.78;white-space:nowrap}
.module-hero,.today-hero{position:relative;color:white;padding:44rpx 6rpx 52rpx;isolation:isolate}
.module-hero:before,.today-hero:before{content:"";position:absolute;inset:-80rpx -120rpx 0;z-index:-1;pointer-events:none;background:radial-gradient(ellipse at 78% 22%,#ffffff38,transparent 54%);animation:sky-light 12s ease-in-out infinite alternate}
.hero-kicker{display:block;font-size:12px;letter-spacing:2rpx;color:#e8f3ff}
.hero-heading{display:block;font-size:52rpx;line-height:1.24;font-weight:600;letter-spacing:-1rpx;margin:18rpx 0 22rpx;overflow-wrap:anywhere}
.hero-trip-line{display:flex;align-items:center;justify-content:space-between;gap:12rpx}
.hero-trip-badge{font-size:12px;padding:8rpx 18rpx;border:1rpx solid #ffffff60;border-radius:100rpx}
.hero-status{display:block;text-align:center;margin-top:44rpx;font-size:26rpx;color:#ffffffd9}
.hero-metric{display:flex;align-items:baseline;justify-content:center;gap:10rpx;margin:0 0 8rpx}
.hero-number{font-size:168rpx;line-height:1.2;letter-spacing:-10rpx;font-weight:400;font-variant-numeric:tabular-nums}
.hero-unit{font-size:30rpx;margin-left:8rpx}
.hero-description{display:block;text-align:center;color:#eef6ff;font-size:26rpx}
.module-hero .hero-heading{text-align:center}
.module-hero .hero-kicker{text-align:center}
.hero-money{display:block;text-align:center;font-size:108rpx;line-height:1.3;letter-spacing:-5rpx;word-break:break-all;font-variant-numeric:tabular-nums}
.trip-dates text{font-size:12px;color:#eef6ff}
.trip-dates .arrow{font-size:40rpx;color:white}
.section-title,.section-title.plain{font-size:38rpx;line-height:1.35;font-weight:600;letter-spacing:-.6rpx}
.section-head>.section-title{margin:0}
.section-head .muted{margin-top:8rpx}
.strong{font-weight:600}
.small,.muted,.expense-meta,.expense-note,.address{font-size:12px;line-height:1.6}
.muted,.small{color:#738397}
.text-btn{min-height:88rpx;padding:16rpx;color:#315e90;font-size:26rpx}
.icon-actions button,.mini-btn,.category-menu-trigger,.profile-edit{width:88rpx!important;height:88rpx!important;min-width:88rpx;display:flex;align-items:center;justify-content:center;border-radius:100rpx;padding:24rpx;box-sizing:border-box;background:transparent}
.tag,.pill{font-size:12px;padding:6rpx 16rpx;border-radius:100rpx;background:#edf4fc;color:#3c6598;font-weight:500}
.progress,.chart-track{height:10rpx;background:#dfe7ee;overflow:hidden;border-radius:20rpx}
.progress-fill,.chart-fill{transition:width .4s ease;background:#438fe8!important}
.date-chip text{font-size:12px}
.date-chip.active .small{color:#416d9f}
.period{padding:0;background:transparent;margin-bottom:28rpx;border-radius:0}
.period-title{font-size:12px;color:#738397;margin-bottom:14rpx}
.event-main .icon-actions{justify-content:flex-end}
