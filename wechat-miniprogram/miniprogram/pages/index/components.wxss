.editor-footer{position:fixed;bottom:0;left:0;right:0;padding:22rpx 36rpx calc(24rpx + env(safe-area-inset-bottom));background:#f7f9fcf5;z-index:5}
.editor-fallback .modal{height:100vh;max-height:100vh;border-radius:0;padding-top:60rpx}
.editor-fallback .modal-body{max-height:calc(100vh - 310rpx)}
.schedule-head>.strong{font-size:26rpx;color:#647b94;font-weight:500}
.outfit-head .grow>.strong{font-size:32rpx;display:block}
.outfit-piece-placeholder text{font-size:12px;color:#8a9aad}
.outfit-piece-actions image{width:30rpx;height:30rpx}
.expense-today-grid>view{background:transparent;padding:0}
.detail-amount{display:block;font-size:72rpx;margin-bottom:24rpx}
.detail-meta{display:block;font-size:26rpx;color:#6e839b}
.detail-location{display:block;font-size:32rpx;margin:24rpx 0}
