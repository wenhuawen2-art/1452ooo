.segment .active{background:white;color:#17212c;box-shadow:0 4rpx 16rpx #17212c08}
.theme-list .progress-card{background:transparent;padding:0;margin:16rpx 0;box-shadow:none}
.theme-list .progress-copy{display:none}
.check-group .list-card{background:transparent;border-radius:0}
.confirmation text{font-size:12px}
.category-head .outline{background:transparent;padding:12rpx;font-size:12px}
.outfit-header{padding:0 0 12rpx;gap:12rpx}
.outfit-header .strong{font-size:34rpx}
.outfit-items{gap:20rpx;grid-template-columns:repeat(2,minmax(0,1fr))}
.outfit-item{border:0;border-radius:28rpx;box-shadow:none;background:#fff;overflow:hidden}
.outfit-item-photo,.outfit-item-placeholder{width:100%;height:290rpx;background:linear-gradient(145deg,#e8eef6,#f6f8fc);border-radius:0}
.outfit-item-placeholder image{width:100rpx;height:100rpx;opacity:.34}
.outfit-item-info{padding:18rpx 18rpx 4rpx}
.outfit-item-type{font-size:12px;color:#738397}
.outfit-item .icon-actions{justify-content:flex-end}
.outfit-item .icon-actions button{width:88rpx!important;height:88rpx!important}
.expense-hero-top,.expense-total{display:none}
.expense-hero-stats{background:#ffffff85;border-radius:28rpx;padding:26rpx;gap:20rpx}
.expense-hero-stats text{font-size:12px;color:#698098}
.expense-hero-stats .strong{font-size:30rpx;color:#17212c}
.expense-hero-actions{margin-top:24rpx;gap:16rpx}
.expense-hero-actions button{min-height:88rpx}
.expense-entry .grow{min-width:0}
.expense-entry-title>.strong{overflow-wrap:anywhere;font-size:30rpx}
.expense-filters picker{flex:1;min-width:170rpx}
.expense-filter{min-height:88rpx;box-sizing:border-box;display:flex;align-items:center}
.expense-day-total,.expense-category-total{font-variant-numeric:tabular-nums}
.split-overview,.stats-highlight .card{background:#ffffffab;border-radius:28rpx}
.profile,.no-trip-profile{background:#ffffff85;padding:30rpx;border-radius:32rpx}
.profile image,.no-trip-profile image{width:112rpx;height:112rpx;border:6rpx solid white;border-radius:50%}
.profile .grow>text+text{font-size:12px;color:#738397}
.trip-summary>.row{align-items:flex-start;flex-wrap:wrap}
.member-heading text,.member .grow>text+text{font-size:12px}
.manage-grid button,.clone-trip{min-height:88rpx;font-size:26rpx}
.guest-banner text{font-size:12px}
.empty .strong{font-size:34rpx}
.welcome{padding-top:72rpx}
.welcome .eyebrow{color:#eef7ff;font-weight:400}
.welcome>.primary{margin-bottom:46rpx}
.welcome-point .muted{font-size:26rpx}
.welcome-point .point-title{font-size:32rpx}
.nav-item{flex:1;min-width:0;min-height:96rpx;padding:10rpx 0;border-radius:100rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5rpx;box-sizing:border-box;transition:background .18s,transform .18s;color:#718297}
.nav-item image{width:36rpx;height:36rpx;opacity:.5}
.nav-item .small{font-size:12px;line-height:1.2}
.nav-item.active{background:#e8f1fc;color:#245e9e}
