/* Content-sized sheets; only the fields scroll, never the title or save action. */
.form-mask{z-index:80;background:rgba(9,24,43,.18);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px)}
.form-mask .form-sheet{height:auto;min-height:0;max-height:calc(100vh - 90px);padding:0;border-radius:24px 24px 0 0;background:#ebf0f6;box-shadow:0 -8px 32px #10213912;overflow:hidden;transition:height .24s ease,border-radius .24s ease}
.form-sheet.is-expanded{border-radius:20px 20px 0 0}.form-sheet.is-dragging{transition:none}
.form-sheet .form-drag-handle{position:relative;display:flex;align-items:center;justify-content:center;flex:none;width:100%;height:28px;min-height:28px;max-height:28px;margin:0;padding:0;border:0;border-radius:0;background:transparent;touch-action:none}
.form-drag-handle>view{width:36px;height:4px;border-radius:4px;background:#a6b0bd;pointer-events:none}.form-drag-handle:active{transform:none;opacity:1}
.form-sheet .modal-head{flex:none;min-height:64px;margin:0;padding:4px 16px 16px;gap:16px;color:#17212c;font-size:20px;font-weight:600;line-height:28px}
.form-sheet .modal-head button{flex:none;width:40px;height:40px;min-width:40px;min-height:40px;border-radius:50%;padding:0;background:#17212c14;color:#333;font-size:28px;line-height:40px}
.form-sheet .modal-head .form-back-button{font-size:22px;font-weight:600;line-height:40px}
.form-sheet .modal-body{flex:0 1 auto;min-height:0;max-height:none;padding:0;box-sizing:border-box;overscroll-behavior:contain}
.form-fields{padding:8px 16px 16px;box-sizing:border-box}
.form-footer{flex:none;padding:12px 16px calc(16px + var(--sheet-safe-bottom,env(safe-area-inset-bottom)));background:#ebf0f6}
.form-footer .modal-submit{margin:0;width:100%;min-height:48px;border-radius:24px;background:#17212c;color:#fff;font-size:16px}
.form-footer .save-error{margin:0 0 8px}.form-sheet .field input,.form-sheet .field textarea,.form-sheet .picker-value{font-size:16px;border-radius:12px;background:#fff;border-color:#dce4ee}
.category-template-entry{display:flex;align-items:center;width:100%;height:56px;min-height:56px;padding:8px 12px;border-radius:14px;background:#fff;color:#17212c;font-size:16px;font-weight:600;text-align:left}.category-template-icon{display:flex;align-items:center;justify-content:center;width:36px;height:36px;margin-right:12px;border-radius:10px;background:#dceeff;color:#438fe8;font-size:18px}.category-template-arrow{margin-left:auto;color:#778390;font-size:28px;font-weight:400}.category-create-divider{height:1px;margin:18px 0;background:#cfd7e2}.category-create-title{display:block;margin:0 0 12px;color:#17212c;font-size:18px;font-weight:600;line-height:25px}
@media(prefers-reduced-motion:reduce){.form-sheet{animation:none!important;transition:none!important}}
