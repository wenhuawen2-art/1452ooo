/* Transparent at the top, progressively diffused toward the home indicator. */
.bottom-haze{position:fixed;left:0;right:0;bottom:0;height:calc(176px + var(--safe-bottom,0px));z-index:28;pointer-events:none;overflow:hidden;background:linear-gradient(180deg,rgba(237,241,245,0) 0%,rgba(237,241,245,.08) 22%,rgba(237,241,245,.42) 52%,rgba(237,241,245,.82) 82%,rgba(237,241,245,.96) 100%)}
.bottom-haze>view{position:absolute;inset:0;pointer-events:none}
.bottom-haze .haze-soft{backdrop-filter:blur(2px);-webkit-backdrop-filter:blur(2px);mask-image:linear-gradient(transparent,#000 24%,#000 48%,transparent 74%);-webkit-mask-image:linear-gradient(transparent,#000 24%,#000 48%,transparent 74%)}
.bottom-haze .haze-mid{backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);mask-image:linear-gradient(transparent 18%,#000 44%,#000 70%,transparent);-webkit-mask-image:linear-gradient(transparent 18%,#000 44%,#000 70%,transparent)}
.bottom-haze .haze-deep{backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);mask-image:linear-gradient(transparent 40%,#000 76%);-webkit-mask-image:linear-gradient(transparent 40%,#000 76%)}
.bottom-haze .haze-base{backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);mask-image:linear-gradient(transparent 64%,#000 94%);-webkit-mask-image:linear-gradient(transparent 64%,#000 94%)}
.motion-paused .bottom-haze{visibility:hidden}
/* End-of-page content can always scroll fully above the haze and foreground actions. */
.mastergo-home .mg-content-panel{padding-bottom:calc(192px + var(--safe-bottom,0px))}
.page.theme-route.route-lodging .rg-page{padding-bottom:calc(192px + var(--safe-bottom,0px))}
.page.theme-list .xy-list-groups{padding-bottom:16px}
.page.theme-list .xy-list-page{padding-bottom:calc(192px + var(--safe-bottom,0px))}

.page.theme-expenses .ee-page{padding-bottom:calc(192px + var(--safe-bottom,0px))}
.page.is-no-trip{padding-bottom:calc(208px + var(--safe-bottom,0px))}
