<view class="page">
  <view wx:if="{{loading}}" class="state-screen"><view class="spinner"></view><text>正在连接向野…</text></view>
  <view wx:elif="{{error}}" class="state-screen"><text class="state-title">暂时无法登录</text><text class="muted">{{error}}</text><button class="primary small" bindtap="retry">重新尝试</button></view>
  <block wx:else>
    <header class="brandbar">
      <image class="brand-logo" src="/assets/brand/logo-144.png" mode="aspectFill" />
      <view><text class="brand-name">向野</text><text class="brand-en">INTO THE WILD</text></view>
    </header>

    <view wx:if="{{!trip}}" class="welcome">
      <text class="eyebrow">把准备留下，把风景带走</text>
      <text class="welcome-title">下一程，\n从容出发。</text>
      <text class="welcome-copy">路线、住宿、随身物品。\n出门需要记住的事，都放在这里。</text>
      <view class="hero-card"><text class="pill">你的自驾随身助手</text><view class="route-line"></view><text class="hero-foot">准备好，就出发。</text></view>
      <button class="primary" bindtap="openCreateTrip">＋ 创建我的旅行</button>
      <view class="welcome-point"><text class="point-icon">⌖</text><view><text class="point-title">每天的路线与住宿</text><text class="muted">打开手机，就知道下一站。</text></view></view>
      <view class="welcome-point"><text class="point-icon">✓</text><view><text class="point-title">一起准备，各自确认</text><text class="muted">公共物品共享，个人清单独立。</text></view></view>
    </view>

    <block wx:else>
      <scroll-view wx:if="{{tab === 'route'}}" class="date-strip" scroll-x enable-flex show-scrollbar="false">
        <button wx:for="{{dates}}" wx:key="value" class="date-chip {{item.active ? 'active' : ''}}" data-date="{{item.value}}" bindtap="selectDate">
          <text>{{item.weekday}}</text><strong>{{item.day}}</strong><small>{{item.month}}月</small>
        </button>
      </scroll-view>

      <main class="content">
        <view wx:if="{{trip.archived}}" class="notice">这趟旅行已归档，内容仅供查看。</view>

        <block wx:if="{{tab === 'today'}}">
          <text class="page-title">旅途将近，准备出发。</text>
          <view class="trip-hero card">
            <view class="row"><text class="card-title">{{trip.name}}</text><text class="tag">{{trip.type}}</text></view>
            <view class="countdown"><text>距离出发</text><strong>{{daysUntil}}</strong><text>天</text></view>
            <view class="trip-dates"><view><text>出发日期</text><strong>{{trip.startDisplay}}</strong></view><text class="arrow">→</text><view><text>归来日期</text><strong>{{trip.endDisplay}}</strong></view></view>
          </view>
          <view class="section-title"><text>出行准备</text></view>
          <view class="stats">
            <button class="stat-card" data-scope="公共" bindtap="openChecklist"><text>公共准备</text><view><strong>{{publicProgress.done}}</strong><small> / {{publicProgress.total}} 项</small></view><view class="progress"><i style="width:{{publicProgress.percent}}%"></i></view></button>
            <button class="stat-card" data-scope="我的" bindtap="openChecklist"><text>我的准备</text><view><strong>{{mineProgress.done}}</strong><small> / {{mineProgress.total}} 项</small></view><view class="progress"><i style="width:{{mineProgress.percent}}%"></i></view></button>
          </view>
          <view class="weather card">
            <view wx:if="{{weatherLoading}}"><text class="muted">正在获取天气…</text></view>
            <view wx:elif="{{weather && weather.available}}" class="weather-row"><text class="weather-icon">{{weather.code < 3 ? '☀️' : weather.code < 60 ? '☁️' : '🌧️'}}</text><view class="grow"><strong>{{weather.location}}</strong><text>{{weather.condition}}</text><small>天气 Open-Meteo · 地点 {{weather.geoSource}}</small></view><strong class="temp">{{weather.high}}°</strong><text class="muted">{{weather.low}}°</text></view>
            <view wx:else><strong>当地天气</strong><text class="muted">请先填写住宿城市或行程地址</text></view>
          </view>
        </block>

        <block wx:elif="{{tab === 'route'}}">
          <view class="section-head"><text class="section-title plain">{{dateLabel}}</text><button class="outline" data-date="{{selectedDate}}" bindtap="openEvent">＋ 添加安排</button></view>
          <view wx:for="{{periods}}" wx:key="name" class="schedule card">
            <view class="schedule-head"><view><strong>{{item.name}}行程</strong><text>{{item.range}}</text></view><text class="tag">{{item.events.length}} 项</text></view>
            <view wx:for="{{item.events}}" wx:for-item="event" wx:key="id" class="event-row">
              <view class="event-copy"><text class="event-time">{{event.startTime}}—{{event.endTime}}</text><strong>{{event.title}}</strong><text wx:if="{{event.locationText}}" class="address">⌖ {{event.locationText}}</text><view wx:if="{{event.startPlace || event.endPlace}}" class="route-box"><text class="start">起点</text><strong>{{event.startPlace}}</strong><text class="route-arrow">→</text><strong>{{event.endPlace}}</strong><text class="end">终点</text></view></view>
              <view class="icon-actions"><button data-id="{{event.id}}" bindtap="openEvent">✎</button><button data-place="{{event.locationText}}" bindtap="openMap">⌖</button></view>
            </view>
          </view>
          <view wx:if="{{!periods.length}}" class="empty card"><text>这一天还没有行程</text><button class="outline" data-date="{{selectedDate}}" bindtap="openEvent">添加安排</button></view>
          <view class="section-head"><text class="section-title plain">住宿</text><button class="outline" data-date="{{selectedDate}}" bindtap="openHotel">＋ 添加住宿</button></view>
          <view wx:if="{{hotel}}" class="hotel card"><view class="grow"><strong>{{hotel.name}}</strong><text>{{hotel.city}} · {{hotel.checkin}} 至 {{hotel.checkout}}</text><text class="address">⌖ {{hotel.address}}</text></view><view class="icon-actions"><button data-id="{{hotel.id}}" bindtap="openHotel">✎</button><button data-place="{{hotel.address}}" bindtap="openMap">⌖</button></view></view>
          <view wx:else class="empty card"><text>当晚尚未填写住宿</text></view>
          <view class="section-head"><text class="section-title plain">票据</text><button class="outline" bindtap="addTicket">＋ 添加票据</button></view>
          <view class="ticket-grid"><view wx:for="{{trip.tickets}}" wx:key="id" wx:if="{{item.date === selectedDate}}" class="ticket"><button class="ticket-preview" data-id="{{item.id}}" bindtap="previewTicket"><image src="{{item.imageUrl}}" mode="aspectFill"/><strong>{{item.type}}</strong><text>{{item.startTime}}</text></button><view class="ticket-actions"><button data-id="{{item.id}}" bindtap="editTicket">编辑</button><button class="danger-text" data-action="deleteTicket" data-id="{{item.id}}" bindtap="confirmDelete">删除</button></view></view></view>
        </block>

        <block wx:elif="{{tab === 'list'}}">
          <view class="segment"><button class="{{scope === '公共' ? 'active' : ''}}" data-scope="公共" bindtap="setScope">一起准备</button><button class="{{scope === '我的' ? 'active' : ''}}" data-scope="我的" bindtap="setScope">我的物品</button></view>
          <view class="progress-card card"><view><text>准备进度</text><strong>{{scope === '公共' ? publicProgress.done : mineProgress.done}}<small> / {{scope === '公共' ? publicProgress.total : mineProgress.total}} 项</small></strong></view><view class="top-actions"><button class="outline" bindtap="openTemplates">▦ 导入模板</button><button class="outline" bindtap="openCategory">＋ 新建分类</button></view></view>
          <view wx:for="{{checklistGroups}}" wx:key="id" class="check-group">
            <view class="section-head"><text class="section-title plain">{{item.name}} <small>{{item.items.length}} 项</small></text><button class="outline" data-category="{{item.id}}" bindtap="openItem">新增条目 ＋</button></view>
            <view class="card list-card">
              <view wx:for="{{item.items}}" wx:for-item="entry" wx:key="id" class="check-row">
                <button class="check {{entry.done ? 'done' : ''}}" data-action="toggle" data-id="{{entry.id}}" bindtap="mutateAction">{{entry.done ? '✓' : ''}}</button>
                <view class="grow"><text class="item-title {{entry.done ? 'done' : ''}}">{{entry.title}}</text><text wx:if="{{entry.key}}" class="key-tag">关键项</text><small wx:if="{{entry.by}}">{{entry.by}} 已确认</small></view>
                <button wx:if="{{entry.done && entry.key}}" class="review {{entry.reviewed ? 'active' : ''}}" data-action="review" data-id="{{entry.id}}" bindtap="mutateAction">复核</button>
                <button class="mini-btn" data-id="{{entry.id}}" bindtap="openItem">✎</button>
                <button class="mini-btn danger-text" data-action="deleteItem" data-id="{{entry.id}}" bindtap="confirmDelete">⌫</button>
              </view>
            </view>
          </view>
        </block>

        <block wx:else>
          <view class="section-head"><text class="section-title plain">我的资料</text><button class="outline" bindtap="openProfileTap">✎ 编辑资料</button></view>
          <view class="profile card"><image src="{{account.avatarSrc}}" mode="aspectFill"/><view><strong>{{account.nickname}}</strong><text>微信账号已绑定</text></view></view>
          <button class="scan-login card" bindtap="scanWebLogin"><strong>扫一扫登录网页版</strong><text>在电脑网页显示登录码后使用</text></button>
          <view class="section-head"><text class="section-title plain">旅行管理</text><button class="outline" bindtap="openCreateTrip">＋ 新建旅行</button></view>
          <view wx:for="{{trips}}" wx:key="id" class="trip-card card {{item.id === trip.id ? 'current' : ''}}" data-id="{{item.id}}" bindtap="switchTrip"><view class="row"><strong>{{item.name}}</strong><text class="tag">{{item.archived ? '已归档' : item.id === trip.id ? '当前旅程' : '进行中'}}</text></view><text>{{item.startDisplay}} → {{item.endDisplay}}</text></view>
          <view class="manage card">
            <view class="section-head"><strong>同行成员</strong><text>{{trip.members.length}} 人</text></view>
            <view wx:for="{{trip.members}}" wx:key="id" class="member"><image src="{{item.avatarSrc}}" mode="aspectFill"/><view class="grow"><strong>{{item.name}}</strong><text>{{item.id === trip.creator ? '创建者' : '同行成员'}}</text></view><button wx:if="{{isOwner && item.id !== trip.creator}}" class="danger-text" data-action="removeMember" data-id="{{item.id}}" bindtap="confirmDelete">移除</button></view>
            <button wx:if="{{isOwner && !trip.archived}}" class="primary" open-type="share">邀请同行人</button>
            <button wx:if="{{isOwner && !trip.archived}}" class="outline full" bindtap="copyInvite">复制网页邀请链接</button>
            <view class="manage-grid"><button wx:if="{{!trip.archived}}" bindtap="openEditTrip">编辑旅行</button><button bindtap="exportCalendar">导出日历</button><button wx:if="{{isOwner}}" bindtap="exportTrip">导出备份</button><button wx:if="{{isOwner && !trip.archived}}" data-action="archive" bindtap="confirmDelete">归档旅行</button><button wx:if="{{isOwner}}" class="danger-text" bindtap="deleteTrip">删除旅行</button></view>
          </view>
        </block>
      </main>

      <nav class="bottom-nav">
        <button class="{{tab === 'today' ? 'active' : ''}}" data-tab="today" bindtap="setTab"><text>☀</text><small>今天</small></button>
        <button class="{{tab === 'route' ? 'active' : ''}}" data-tab="route" bindtap="setTab"><text>⌘</text><small>行程</small></button>
        <button class="{{tab === 'list' ? 'active' : ''}}" data-tab="list" bindtap="setTab"><text>☷</text><small>清单</small></button>
        <button class="{{tab === 'people' ? 'active' : ''}}" data-tab="people" bindtap="setTab"><text>♙</text><small>我的</small></button>
      </nav>
    </block>
  </block>

  <view wx:if="{{modal}}" class="modal-mask" bindtap="closeModal">
    <view class="modal" catchtap="stopBubble">
      <view class="modal-head"><text>{{modal.title}}</text><button wx:if="{{!modal.required}}" bindtap="closeModal">×</button></view>
      <scroll-view class="modal-body" scroll-y>
        <block wx:if="{{modal.type === 'profile'}}">
          <label class="field"><text>昵称</text><input value="{{modal.values.nickname}}" maxlength="40" data-field="nickname" bindinput="bindInput"/></label>
          <text class="field-label">选择头像</text>
          <view class="avatar-grid"><button class="avatar custom {{modal.values.avatarData ? 'selected' : ''}}" open-type="chooseAvatar" bindchooseavatar="chooseCustomAvatar"><image wx:if="{{modal.values.avatarData}}" src="{{modal.values.avatarData}}"/><text wx:else>＋</text></button><button wx:for="{{avatars}}" wx:key="id" class="avatar {{modal.values.avatarId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="chooseAvatar"><image src="{{item.src}}"/></button></view>
        </block>
        <block wx:elif="{{modal.type === 'trip'}}">
          <label class="field"><text>旅行名称</text><input value="{{modal.values.name}}" data-field="name" bindinput="bindInput"/></label>
          <label class="field"><text>旅行类型</text><picker range="{{tripTypes}}" bindchange="bindType"><view class="picker-value">{{modal.values.type}} 〉</view></picker></label>
          <view class="field-row"><label class="field"><text>出发日期</text><picker mode="date" value="{{modal.values.startDate}}" data-field="startDate" bindchange="bindDate"><view class="picker-value">{{modal.values.startDate}}</view></picker></label><label class="field"><text>时间</text><picker mode="time" value="{{modal.values.startTime}}" data-field="startTime" bindchange="bindTime"><view class="picker-value">{{modal.values.startTime}}</view></picker></label></view>
          <view class="field-row"><label class="field"><text>归来日期</text><picker mode="date" value="{{modal.values.endDate}}" data-field="endDate" bindchange="bindDate"><view class="picker-value">{{modal.values.endDate}}</view></picker></label><label class="field"><text>时间</text><picker mode="time" value="{{modal.values.endTime}}" data-field="endTime" bindchange="bindTime"><view class="picker-value">{{modal.values.endTime}}</view></picker></label></view>
        </block>
        <block wx:elif="{{modal.type === 'event'}}">
          <label class="field"><text>做什么</text><input value="{{modal.values.title}}" data-field="title" bindinput="bindInput"/></label>
          <label class="field"><text>日期</text><picker mode="date" value="{{modal.values.date}}" data-field="date" bindchange="bindDate"><view class="picker-value">{{modal.values.date}}</view></picker></label>
          <view class="field-row"><label class="field"><text>开始时间</text><picker mode="time" value="{{modal.values.startTime}}" data-field="startTime" bindchange="bindTime"><view class="picker-value">{{modal.values.startTime}}</view></picker></label><label class="field"><text>结束时间</text><picker mode="time" value="{{modal.values.endTime}}" data-field="endTime" bindchange="bindTime"><view class="picker-value">{{modal.values.endTime}}</view></picker></label></view>
          <label class="field"><text>起始地</text><input value="{{modal.values.startPlace}}" data-field="startPlace" bindinput="bindInput"/></label><label class="field"><text>目的地</text><input value="{{modal.values.endPlace}}" data-field="endPlace" bindinput="bindInput"/></label><label class="field"><text>具体地址</text><input value="{{modal.values.address}}" data-field="address" bindinput="bindInput"/></label><label class="field"><text>备注</text><textarea value="{{modal.values.note}}" data-field="note" bindinput="bindInput"/></label>
        </block>
        <block wx:elif="{{modal.type === 'hotel'}}">
          <label class="field"><text>住宿名称</text><input value="{{modal.values.name}}" data-field="name" bindinput="bindInput"/></label><label class="field"><text>城市</text><input value="{{modal.values.city}}" data-field="city" bindinput="bindInput"/></label><label class="field"><text>具体地址</text><input value="{{modal.values.address}}" data-field="address" bindinput="bindInput"/></label>
          <view class="field-row"><label class="field"><text>入住</text><picker mode="date" value="{{modal.values.checkin}}" data-field="checkin" bindchange="bindDate"><view class="picker-value">{{modal.values.checkin}}</view></picker></label><label class="field"><text>退房</text><picker mode="date" value="{{modal.values.checkout}}" data-field="checkout" bindchange="bindDate"><view class="picker-value">{{modal.values.checkout}}</view></picker></label></view><label class="field"><text>电话（选填）</text><input value="{{modal.values.phone}}" data-field="phone" bindinput="bindInput"/></label><label class="field"><text>备注</text><textarea value="{{modal.values.note}}" data-field="note" bindinput="bindInput"/></label>
        </block>
        <block wx:elif="{{modal.type === 'item'}}">
          <label class="field"><text>条目名称</text><input value="{{modal.values.title}}" data-field="title" bindinput="bindInput"/></label><label class="field"><text>分类</text><picker range="{{modal.categories}}" range-key="name" value="{{modal.categoryIndex}}" bindchange="bindCategory"><view class="picker-value">{{modal.categories[modal.categoryIndex].name}} 〉</view></picker></label><label class="switch-row"><text>设为关键项</text><switch checked="{{modal.values.key}}" data-field="key" bindchange="bindSwitch" color="#4f8ee8"/></label>
        </block>
        <block wx:elif="{{modal.type === 'category'}}"><label class="field"><text>分类名称</text><input value="{{modal.values.name}}" data-field="name" bindinput="bindInput"/></label></block>
        <block wx:elif="{{modal.type === 'templates'}}"><button wx:for="{{templates}}" wx:key="id" class="template-card" data-id="{{item.id}}" bindtap="importTemplate"><text class="template-symbol">{{item.symbol}}</text><view class="grow"><strong>{{item.name}}</strong><text>{{item.description}}</text><small>{{item.items.length}} 项 · 建议{{item.recommendedScope}}</small></view></button></block>
        <block wx:elif="{{modal.type === 'join'}}"><view class="notice">你将以微信账号“{{account.nickname}}”加入这趟旅行，头像和昵称会保持全账号一致。</view></block>
        <block wx:elif="{{modal.type === 'ticket'}}"><label class="field"><text>票据类型</text><input value="{{modal.values.type}}" data-field="type" bindinput="bindInput"/></label><label class="field"><text>使用时间</text><input value="{{modal.values.startTime}}" data-field="startTime" bindinput="bindInput"/></label></block>
        <block wx:elif="{{modal.type === 'ticketMeta'}}"><label class="field"><text>票据类型</text><input value="{{modal.values.type}}" data-field="type" bindinput="bindInput"/></label><label class="field"><text>使用时间</text><input value="{{modal.values.startTime}}" data-field="startTime" bindinput="bindInput"/></label></block>
      </scroll-view>
      <button wx:if="{{modal.type === 'ticket'}}" class="primary modal-submit" disabled="{{busy}}" bindtap="submitTicket">上传票据</button>
      <button wx:elif="{{modal.type !== 'templates'}}" class="primary modal-submit" disabled="{{busy}}" bindtap="submitModal">{{modal.type === 'join' ? '确认加入' : '保存'}}</button>
    </view>
  </view>
</view>
