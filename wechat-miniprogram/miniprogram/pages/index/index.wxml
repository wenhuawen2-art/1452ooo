<view class="page motion-nav-{{motionNav}} motion-section-{{motionSection}} {{!trip && !loading && !error ? 'is-no-trip' : ''}} theme-{{tab === 'outfit' ? 'list' : tab}} {{tab === 'route' ? 'route-' + routeSection : ''}} {{trip && tab === 'today' ? 'mastergo-home' : ''}} {{pageHidden ? 'motion-paused' : ''}} {{reducedMotion ? 'reduced-motion' : ''}}" style="--design-height:{{tab === 'today' ? 1559 : tab === 'route' ? (routeSection === 'planning' ? 1785 : 1220) : tab === 'expenses' ? (expenseSegment === 'stats' ? 2633 : expenseSegment === 'split' ? 1184 : 1785) : 1573}}px;--content-top:{{systemContentTop}}px;--safe-bottom:{{safeBottomInset}}px;padding-top:{{trip && (tab === 'today' || tab === 'route' || tab === 'list' || tab === 'outfit' || tab === 'expenses') ? 0 : systemHeaderHeight}}px">
  <view wx:if="{{trip && tab !== 'today' && tab !== 'route' && tab !== 'list' && tab !== 'outfit' && tab !== 'expenses'}}" class="custom-header" style="height:{{systemHeaderHeight}}px;padding-top:{{systemContentTop}}px"><text class="custom-brand">向野</text><text class="custom-tagline">让下一程，从容发生。</text><include src="views/account-entry.wxml" /></view>
  <include src="views/module-header.wxml" />
  <view wx:if="{{loading}}" class="journey-loading" role="status" aria-label="正在加载旅行"><block wx:if="{{loadingVersion === 'v1'}}"><include src="./views/loading-v1.wxml" /></block><block wx:elif="{{loadingVersion === 'v2'}}"><include src="./views/loading-v2.wxml" /></block><block wx:elif="{{loadingVersion === 'v3'}}"><include src="./views/loading-previous.wxml" /></block><block wx:else><include src="./views/loading.wxml" /></block></view>
  <view wx:elif="{{error}}" class="state-screen"><text class="state-title">暂时无法登录</text><text class="muted">{{error}}</text><button class="primary small" bindtap="retry">重新尝试</button></view>
  <block wx:else>


    <block wx:if="{{!trip}}">
    <include src="views/onboarding.wxml" />
    </block>
    <block wx:else>
      <view class="module-hero" wx:if="{{tab !== 'today' && tab !== 'route' && tab !== 'list' && tab !== 'outfit' && tab !== 'expenses'}}">
        <text class="hero-kicker">{{tab === 'route' ? '把沿途，安排从容' : tab === 'list' ? '准备好，就出发' : '一起出发，清楚记账'}}</text>
        <text class="hero-heading">{{tab === 'route' ? '沿途计划' : tab === 'list' ? '行囊准备' : '旅行账本'}}</text>
        <view wx:if="{{tab === 'list'}}" class="hero-metric"><text class="hero-number">{{visualProgress}}</text><text class="hero-unit">%</text></view>
        <text wx:elif="{{tab === 'expenses'}}" class="hero-money">{{expenseSummary.totalDisplay || '¥0.00'}}</text>
        <text wx:elif="{{tab === 'route'}}" class="hero-description">{{dateLabel}}</text>
        <text wx:if="{{tab === 'list'}}" class="hero-description">{{scope === '公共' ? publicProgress.done : mineProgress.done}} / {{scope === '公共' ? publicProgress.total : mineProgress.total}} 项已准备</text>
        <text wx:if="{{tab === 'expenses'}}" class="hero-description">全程支出 · {{trip.name}}</text>
      </view>


      <view class="content {{(tab === 'list' || tab === 'outfit') ? 'list-content' : tab === 'expenses' ? 'expense-content' : ''}}">
        <view wx:if="{{guestMode}}" class="guest-banner"><view><text class="guest-badge">游客体验</text><text>当前为演示旅行，浏览不会产生或保存真实数据</text></view><button data-intent="login" bindtap="startLogin">登录</button></view>
        <view wx:if="{{trip.archived}}" class="notice">这趟旅行已归档，内容仅供查看。</view>

        <block wx:if="{{tab === 'today'}}">
          <include src="views/today.wxml" />
        </block>

        <block wx:elif="{{tab === 'route'}}">
          <include src="views/route.wxml" />
        </block>

        <block wx:elif="{{tab === 'list' || tab === 'outfit'}}">
          <include src="views/list.wxml" />
        </block>

        <block wx:elif="{{tab === 'expenses'}}">
          <include src="views/expenses.wxml" />
        </block>
      </view>

    </block>
      <include src="views/bottom-chrome.wxml" />
      <view class="bottom-nav master-nav">
        <view class="nav-item {{tab === 'today' ? 'active' : ''}}" hover-class="nav-pressed" role="button" aria-label="首页" data-tab="today" bindtap="setTab"><image src="{{tab === 'today' ? '/assets/mastergo-route/nav-today-active.svg' : '/assets/mastergo-route/planning/svg_bfe74286.svg'}}" mode="aspectFit" /><text class="small">首页</text></view>
        <view class="nav-item {{tab === 'route' ? 'active' : ''}}" hover-class="nav-pressed" role="button" aria-label="行程" data-tab="route" bindtap="setTab"><image src="{{tab === 'route' ? '/assets/mastergo-route/nav-route-active.svg' : '/assets/mastergo/svg_7bb647bd.svg'}}" mode="aspectFit" /><text class="small">行程</text></view>
        <view class="nav-item {{tab === 'list' ? 'active' : ''}}" hover-class="nav-pressed" role="button" aria-label="清单" data-tab="list" bindtap="setTab"><image src="{{tab === 'list' ? '/assets/mastergo-route/nav-list-active.svg' : '/assets/mastergo/svg_988bdf11.svg'}}" mode="aspectFit" /><text class="small">清单</text></view>
        <view class="nav-item {{tab === 'outfit' ? 'active' : ''}}" hover-class="nav-pressed" role="button" aria-label="穿搭" data-tab="outfit" bindtap="setTab"><image src="/assets/mastergo-route/nav-outfit-{{tab === 'outfit' ? 'active' : 'default'}}.svg" mode="aspectFit"/><text class="small">穿搭</text></view>
        <view class="nav-item {{tab === 'expenses' ? 'active' : ''}}" hover-class="nav-pressed" role="button" aria-label="记账" data-tab="expenses" bindtap="setTab"><image src="{{tab === 'expenses' ? '/assets/mastergo-route/nav-expenses-active.svg' : '/assets/mastergo-route/planning/svg_0634b27b.svg'}}" mode="aspectFit" /><text class="small">记账</text></view>
      </view>
  </block>

  <view wx:if="{{routeMapOpen}}" class="route-map-page">
    <view class="route-map-head" style="padding-top:{{systemContentTop}}px"><button wx:if="{{routeEditing}}" bindtap="cancelRouteEdit">‹</button><button wx:else bindtap="closeRouteMap">‹</button><view class="grow"><text class="strong">{{routeEditing ? '调整全程路线' : '全程路线'}}</text><text class="small">{{trip.name}}</text></view><button wx:if="{{!routeEditing && !trip.archived}}" class="route-edit-link" bindtap="startRouteEdit">调整</button></view>
    <block wx:if="{{!routeEditing}}">
      <map class="route-full-map" longitude="{{routeOverview.centerLongitude}}" latitude="{{routeOverview.centerLatitude}}" scale="{{routeOverview.mapScale}}" markers="{{routeOverview.markers}}" polyline="{{routeOverview.polylines}}" include-points="{{routeOverview.includePoints}}" enable-scroll="{{true}}" enable-zoom="{{true}}" enable-rotate="{{false}}" enable-overlooking="{{false}}" />
      <scroll-view class="route-map-details" scroll-y>
        <view class="route-summary card"><view><text class="small">全程地点</text><text class="strong">{{routeOverview.points.length}} 个</text></view><view><text class="small">可计算里程</text><text class="strong">{{routeOverview.distanceLabel || '—'}}</text></view><view><text class="small">交通方式</text><text class="strong route-summary-mode">{{routeOverview.modeSummary || '待完善'}}</text></view></view>
        <view wx:if="{{routeOverview.unresolved.length}}" class="route-warning route-full-warning">有 {{routeOverview.unresolved.length}} 个地点未识别，请点击“调整”修正。</view>
        <view class="route-stop-list card"><view wx:for="{{routeOverview.points}}" wx:key="id" class="route-stop"><view class="route-stop-index {{item.role}}">{{item.role === 'return' ? '返' : item.number}}</view><view class="grow"><view class="route-stop-title"><text class="strong">{{item.label}}</text><text wx:if="{{item.resolutionSourceLabel}}" class="route-source {{item.resolutionSource}}">{{item.resolutionSourceLabel}}</text></view><text class="small">{{item.date}} · {{item.title}}</text><text class="route-stop-address">{{item.address}}</text><text wx:if="{{item.originalLabel && item.originalLabel !== item.label}}" class="route-original">原填写：{{item.originalLabel}}</text></view><text class="route-role">{{item.role === 'start' ? '起点' : item.role === 'return' ? '返程' : item.role === 'end' ? '终点' : '途经'}}</text></view></view>
        <button wx:if="{{!trip.archived}}" class="outline full route-rebuild" bindtap="rebuildRouteOverview">重新生成路线</button>
      </scroll-view>
    </block>
    <block wx:else>
      <scroll-view class="route-editor" scroll-y>
        <view class="notice">路线从每日行程自动提取。可调整顺序、排除地点、修正地址，并为每一段选择交通方式。</view>
        <view wx:for="{{routeEditorPoints}}" wx:key="id" class="route-editor-point {{item.excluded ? 'excluded' : ''}}">
          <view class="route-editor-top"><view class="route-stop-index">{{index + 1}}</view><input class="grow" value="{{item.label}}" data-index="{{index}}" data-field="label" bindinput="bindRoutePoint" placeholder="地点名称"/><switch checked="{{!item.excluded}}" data-index="{{index}}" bindchange="toggleRoutePoint" color="#4f8ee8"/></view>
          <view wx:if="{{item.resolutionSourceLabel || (item.originalLabel && item.originalLabel !== item.label)}}" class="route-editor-resolution"><text wx:if="{{item.resolutionSourceLabel}}" class="route-source {{item.resolutionSource}}">{{item.resolutionSourceLabel}}</text><text wx:if="{{item.originalLabel && item.originalLabel !== item.label}}">原填写：{{item.originalLabel}}</text></view>
          <input class="route-address-input" value="{{item.address}}" data-index="{{index}}" data-field="address" bindinput="bindRoutePoint" placeholder="用于地图解析的详细地址"/>
          <picker wx:if="{{index > 0}}" range="{{transportModes}}" range-key="label" value="{{item.modeIndex}}" data-index="{{index}}" bindchange="bindRouteMode"><view class="picker-value route-mode-picker">从上一站前往这里：{{transportModes[item.modeIndex].icon}} {{transportModes[item.modeIndex].label}} 〉</view></picker>
          <view class="route-editor-actions"><button data-index="{{index}}" data-direction="up" bindtap="moveRoutePoint">上移</button><button data-index="{{index}}" data-direction="down" bindtap="moveRoutePoint">下移</button><button data-index="{{index}}" bindtap="beginRouteSearch">搜索替换</button></view>
          <view wx:if="{{routeSearchIndex === index}}" class="route-search"><view class="route-search-bar"><input class="grow" value="{{routeSearchKeyword}}" bindinput="bindRouteSearch" placeholder="搜索地点或完整地址"/><button disabled="{{busy}}" bindtap="searchRoutePlaces">搜索</button></view><button wx:for="{{routeSearchResults}}" wx:key="id" class="route-search-result" data-index="{{index}}" bindtap="selectRoutePlace"><text class="strong">{{item.title}}</text><text class="small">{{item.address}}</text></button></view>
        </view>
        <view class="route-editor-bottom-space"></view>
      </scroll-view>
      <view class="route-editor-footer"><button class="outline" bindtap="resetRouteEditor">恢复自动</button><button class="primary" disabled="{{busy}}" bindtap="saveRouteEditorTap">保存并生成</button></view>
    </block>
  </view>

  <include src="views/form-sheet.wxml" />

  <block wx:for="{{detail || motionExitDetail ? [detail || motionExitDetail] : []}}" wx:for-item="detail" wx:key="id"><view wx:if="{{detail}}" class="modal-mask {{motionExitDetail ? 'motion-exit' : ''}}" bindtap="closeDetail"><view class="modal detail-panel" catchtap="stopBubble"><view class="modal-head"><text>{{detail.title}}</text><button bindtap="closeDetail" aria-label="关闭详情">×</button></view><scroll-view class="modal-body" scroll-y><text wx:if="{{detail.amount}}" class="detail-amount">{{detail.amount}}</text><text class="detail-meta">{{detail.date}} {{detail.time}}</text><text wx:if="{{detail.location}}" class="detail-location">{{detail.location}}{{detail.destination ? ' → ' + detail.destination : ''}}</text><text class="detail-note">{{detail.note || '暂无备注'}}</text></scroll-view><view wx:if="{{!trip.archived}}" class="detail-actions"><button class="outline danger-text" bindtap="deleteDetail">删除</button><button class="primary" bindtap="editDetail">编辑</button></view></view></view>
  </block><view wx:if="{{loginPrompt || motionExitLoginPrompt}}" class="modal-mask login-mask {{motionExitLoginPrompt ? 'motion-exit' : ''}}" bindtap="dismissLogin">
    <view class="modal login-modal" catchtap="stopBubble"><view class="modal-head"><text>登录并保存旅行</text><button bindtap="dismissLogin">×</button></view><view class="login-brand"><image src="/assets/loading-welcome/brand.svg" mode="aspectFit"/><text class="muted">使用当前微信身份一键登录。登录后可创建、编辑并同步旅行数据。</text></view><button class="primary wechat-login" disabled="{{busy}}" bindtap="startLogin">微信一键登录</button><text class="login-tip">无需手机号，头像和昵称可在登录后自行修改</text></view>
  </view>
</view>
