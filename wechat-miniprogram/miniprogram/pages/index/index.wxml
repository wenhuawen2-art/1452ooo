<view class="page">
  <view wx:if="{{loading}}" class="state-screen"><view class="spinner"></view><text>正在连接向野…</text></view>
  <view wx:elif="{{error}}" class="state-screen"><text class="state-title">暂时无法登录</text><text class="muted">{{error}}</text><button class="primary small" bindtap="retry">重新尝试</button></view>
  <block wx:else>
    <view class="brandbar">
      <image class="brand-logo" src="/assets/brand/logo-144.png" mode="aspectFill" />
      <view><text class="brand-name">向野</text><text class="brand-en">INTO THE WILD</text></view>
    </view>

    <block wx:if="{{!trip}}">
      <view wx:if="{{tab === 'today'}}" class="welcome">
        <block wx:if="{{account.profileComplete}}">
          <text class="eyebrow">把准备留下，把风景带走</text>
          <text class="welcome-title">下一程，\n从容出发。</text>
          <text class="welcome-copy">还没有旅行，先填写名称和出发归来时间。</text>
          <view class="hero-card"><text class="pill">你的自驾随身助手</text><view class="route-line"></view><text class="hero-foot">准备好，就出发。</text></view>
          <button class="primary" bindtap="openCreateTrip">＋ 新建旅行</button>
        </block>
        <block wx:else>
          <view class="empty-onboarding card"><image src="/assets/brand/logo-144.png" mode="aspectFill"/><text class="state-title">还没有旅行</text><text class="muted">请先到“我的”完成微信授权登录。</text><button class="primary" data-tab="people" bindtap="setTab">前往我的</button></view>
        </block>
      </view>
      <view wx:elif="{{tab === 'route'}}" class="content empty-tab"><view class="empty card"><text class="state-title">暂无行程</text><text class="muted">{{account.profileComplete ? '请先新建旅行，再添加每天的行程。' : '请先到“我的”完成微信授权登录。'}}</text></view></view>
      <view wx:elif="{{tab === 'list'}}" class="content empty-tab"><view class="empty card"><text class="state-title">暂无清单</text><text class="muted">{{account.profileComplete ? '请先新建旅行，再添加自己的清单。' : '请先到“我的”完成微信授权登录。'}}</text></view></view>
      <view wx:elif="{{tab === 'expenses'}}" class="content empty-tab"><view class="empty card"><text class="state-title">暂无记账</text><text class="muted">{{account.profileComplete ? '请先新建旅行，再记录旅行费用。' : '请先到“我的”完成微信授权登录。'}}</text></view></view>
      <view wx:else class="content empty-profile-page">
        <block wx:if="{{account.profileComplete}}"><view class="section-head"><text class="section-title plain">我的资料</text></view><view class="profile card"><image src="{{account.avatarSrc}}" mode="aspectFill"/><view class="grow"><text class="strong">{{account.nickname}}</text><text>微信账号已绑定</text></view><button class="profile-edit" aria-label="编辑资料" bindtap="openProfileTap">✎</button></view><view class="empty card"><text class="state-title">还没有旅行</text><text class="muted">创建第一趟旅行，开始安排路线和清单。</text><button class="primary" bindtap="openCreateTrip">＋ 新建旅行</button></view></block>
        <block wx:else><view class="login-card card"><image src="/assets/brand/logo-144.png" mode="aspectFill"/><text class="state-title">登录后开始使用</text><text class="muted">使用微信头像和昵称建立你的同行身份。</text><button class="primary" disabled="{{busy}}" bindtap="startWechatLogin">微信授权登录</button></view></block>
      </view>
    </block>

    <block wx:else>
      <scroll-view wx:if="{{tab === 'route'}}" class="date-strip" scroll-x enable-flex show-scrollbar="false">
        <button wx:for="{{dates}}" wx:key="value" class="date-chip {{item.active ? 'active' : ''}}" data-date="{{item.value}}" bindtap="selectDate">
          <text>{{item.weekday}}</text><text class="strong">{{item.day}}</text><text class="small">{{item.month}}月</text>
        </button>
      </scroll-view>

      <view class="content">
        <view wx:if="{{trip.archived}}" class="notice">这趟旅行已归档，内容仅供查看。</view>

        <block wx:if="{{tab === 'today'}}">
          <text class="page-title">旅途将近，准备出发。</text>
          <view class="trip-hero card">
            <view class="row"><text class="card-title">{{trip.name}}</text><text class="tag">{{trip.type}}</text></view>
            <view class="countdown"><text>距离出发</text><text class="strong">{{daysUntil}}</text><text>天</text></view>
            <view class="trip-dates"><view><text>出发日期</text><text class="strong">{{trip.startDisplay}}</text></view><text class="arrow">→</text><view><text>归来日期</text><text class="strong">{{trip.endDisplay}}</text></view></view>
          </view>
          <view class="section-title"><text>出行准备</text></view>
          <view class="stats">
            <button class="stat-card" data-scope="公共" bindtap="openChecklist"><text>公共准备</text><view><text class="strong">{{publicProgress.done}}</text><text class="small"> / {{publicProgress.total}} 项</text></view><view class="progress"><view class="progress-fill" style="width:{{publicProgress.percent}}%"></view></view></button>
            <button class="stat-card" data-scope="我的" bindtap="openChecklist"><text>我的准备</text><view><text class="strong">{{mineProgress.done}}</text><text class="small"> / {{mineProgress.total}} 项</text></view><view class="progress"><view class="progress-fill" style="width:{{mineProgress.percent}}%"></view></view></button>
          </view>
          <view class="weather today-weather card">
            <view wx:if="{{weatherLoading}}"><text class="muted">正在获取天气…</text></view>
            <view wx:elif="{{weather && weather.available}}" class="weather-row"><text class="weather-icon">{{weather.code < 3 ? '☀️' : weather.code < 60 ? '☁️' : '🌧️'}}</text><view class="grow"><text class="strong">{{weather.location}}</text><text>{{weather.condition}}</text><text class="small">天气 Open-Meteo · 地点 {{weather.geoSource}}</text></view><text class="strong temp">{{weather.high}}°</text><text class="muted">{{weather.low}}°</text></view>
            <view wx:else><text class="strong">当地天气</text><text class="muted">请先填写住宿城市或行程地址</text></view>
          </view>
        </block>

        <block wx:elif="{{tab === 'route'}}">
          <view class="section-head"><text class="section-title plain">{{dateLabel}}</text><button class="outline" data-date="{{selectedDate}}" bindtap="openEvent">＋ 添加安排</button></view>
          <view wx:for="{{periods}}" wx:for-index="periodIndex" wx:key="name" class="schedule card period-{{periodIndex}}">
            <view class="schedule-head"><view class="period-bar"></view><text class="strong">{{item.name}}行程</text><text class="tag">{{item.events.length}} 项</text></view>
            <view wx:for="{{item.events}}" wx:for-item="event" wx:key="id" class="event-row">
              <view class="event-timeline"><view class="timeline-dot"></view><view class="timeline-line"></view></view>
              <view class="event-body">
                <view class="event-main"><view class="event-copy"><text class="event-time">{{event.startTime}}—{{event.endTime}}</text><view class="event-activity"><text class="strong">{{event.title}}</text><text wx:if="{{event.locationText}}" class="address">⌖ {{event.locationText}}</text></view></view><view class="icon-actions"><button data-id="{{event.id}}" bindtap="openEvent" aria-label="编辑行程"><image src="/assets/icons/edit.svg" mode="aspectFit" /></button><button data-place="{{event.locationText}}" bindtap="openMap" aria-label="查看位置"><image src="/assets/icons/map-pin.svg" mode="aspectFit" /></button><button class="danger-text" data-action="deleteEvent" data-id="{{event.id}}" bindtap="confirmDelete" aria-label="删除行程"><image src="/assets/icons/trash.svg" mode="aspectFit" /></button></view></view>
                <view wx:if="{{event.startPlace || event.endPlace}}" class="route-box"><text class="start">起点</text><text class="strong">{{event.startPlace}}</text><text class="route-arrow">→</text><text class="strong route-destination">{{event.endPlace}}</text><text class="end">终点</text></view>
                <view wx:if="{{event.note}}" class="event-note"><text class="event-note-label">备注</text><text class="event-note-content">{{event.note}}</text></view>
              </view>
            </view>
          </view>
          <view wx:if="{{!periods.length}}" class="empty card"><text>这一天还没有行程</text></view>
          <view class="section-head"><text class="section-title plain">住宿</text><button class="outline" data-date="{{selectedDate}}" bindtap="openHotel">＋ 添加住宿</button></view>
          <view wx:if="{{hotel}}" class="hotel card"><view class="grow"><text class="strong">{{hotel.name}}</text><text>{{hotel.city}} · {{hotel.checkin}} 至 {{hotel.checkout}}</text><text class="address">⌖ {{hotel.address}}</text></view><view class="icon-actions"><button data-id="{{hotel.id}}" bindtap="openHotel" aria-label="编辑住宿"><image src="/assets/icons/edit.svg" mode="aspectFit" /></button><button data-place="{{hotel.address}}" bindtap="openMap" aria-label="查看住宿位置"><image src="/assets/icons/map-pin.svg" mode="aspectFit" /></button><button class="danger-text" data-action="deleteHotel" data-id="{{hotel.id}}" bindtap="confirmDelete" aria-label="删除住宿"><image src="/assets/icons/trash.svg" mode="aspectFit" /></button></view></view>
          <view wx:else class="empty card"><text>当晚尚未填写住宿</text></view>
          <view class="section-head"><text class="section-title plain">票据</text><button class="outline" bindtap="addTicket">＋ 添加票据</button></view>
          <view wx:if="{{selectedTickets.length}}" class="ticket-grid"><view wx:for="{{selectedTickets}}" wx:key="id" class="ticket"><button class="ticket-preview" data-id="{{item.id}}" bindtap="previewTicket"><image src="{{item.previewSrc}}" mode="aspectFill"/><text class="strong">{{item.type}}</text><text>{{item.startTime}}</text></button><view class="ticket-actions"><button data-id="{{item.id}}" bindtap="editTicket" aria-label="编辑票据">编辑</button><button class="danger-text" data-action="deleteTicket" data-id="{{item.id}}" bindtap="confirmDelete" aria-label="删除票据">删除</button></view></view></view>
          <view wx:else class="empty card"><text>当天尚未添加票据</text></view>
        </block>

        <block wx:elif="{{tab === 'list'}}">
          <view class="segment"><button class="{{scope === '公共' ? 'active' : ''}}" data-scope="公共" bindtap="setScope">一起准备</button><button class="{{scope === '我的' ? 'active' : ''}}" data-scope="我的" bindtap="setScope">我的物品</button></view>
          <view class="progress-card card"><view class="progress-copy"><text class="progress-label">准备进度</text><view class="progress-value"><text class="strong">{{scope === '公共' ? publicProgress.done : mineProgress.done}}</text><text class="small">/ {{scope === '公共' ? publicProgress.total : mineProgress.total}} 项</text></view></view><view class="top-actions"><button class="outline" bindtap="openTemplates">▦ 导入模板</button><button class="outline" bindtap="openCategory">＋ 新建分类</button></view></view>
          <view wx:for="{{checklistGroups}}" wx:key="id" class="check-group">
            <view class="section-head category-head"><text class="section-title plain">{{item.name}} <text class="small">{{item.items.length}} 项</text></text><view class="category-actions"><button class="outline" data-category="{{item.id}}" bindtap="openItem">新增条目 ＋</button><button class="category-menu-trigger" data-id="{{item.id}}" bindtap="toggleCategoryMenu" aria-label="{{item.name}}分类更多操作">···</button></view><view wx:if="{{categoryMenuId === item.id}}" class="category-menu-panel" catchtap="stopBubble"><button data-id="{{item.id}}" bindtap="openCategory">编辑</button><button class="danger-text" data-action="deleteCategory" data-id="{{item.id}}" bindtap="confirmDelete">删除</button></view></view>
            <view class="card list-card">
              <view wx:for="{{item.items}}" wx:for-item="entry" wx:key="id" class="check-row">
                <view class="check-toggle-zone" data-action="toggle" data-id="{{entry.id}}" bindtap="mutateAction"><view class="check {{entry.done ? 'done' : ''}}">{{entry.done ? '✓' : ''}}</view><view class="grow"><text class="item-title {{entry.done ? 'done' : ''}}">{{entry.title}}</text><text wx:if="{{entry.key}}" class="key-tag">关键项</text><view wx:if="{{entry.done && entry.confirmerName}}" class="confirmation"><image wx:if="{{entry.confirmerAvatarSrc}}" src="{{entry.confirmerAvatarSrc}}" mode="aspectFill"/><text class="confirmation-name">{{entry.confirmerName}}</text><text class="confirmation-status">已确认</text></view></view></view>
                <button wx:if="{{entry.done && entry.key}}" class="review {{entry.reviewed ? 'active' : ''}}" data-action="review" data-id="{{entry.id}}" catchtap="mutateAction">复核</button>
                <button class="mini-btn" data-id="{{entry.id}}" catchtap="openItem"><image src="/assets/icons/edit.svg" mode="aspectFit" /></button>
                <button class="mini-btn danger-text" data-action="deleteItem" data-id="{{entry.id}}" catchtap="confirmDelete"><image src="/assets/icons/trash.svg" mode="aspectFit" /></button>
              </view>
            </view>
          </view>
        </block>

        <block wx:elif="{{tab === 'expenses'}}">
          <view class="section-head"><view><text class="section-title plain">旅行记账</text><text class="small"> {{trip.name}}</text></view><button class="outline" bindtap="openExpense">＋ 记一笔</button></view>
          <view class="expense-summary card"><view><text>总支出</text><text class="strong">¥{{expenseSummary.totalYuan}}</text></view><view><text>我的结余</text><text class="strong {{expenseSummary.myNetMinor >= 0 ? 'positive' : 'negative'}}">{{expenseSummary.myNetLabel}}</text></view></view>
          <view class="segment"><button class="active">明细</button><button bindtap="openExpenseSplit">分账</button></view>
          <view wx:if="{{expenses.length}}"><view wx:for="{{expenses}}" wx:key="id" class="card expense-row"><view class="grow"><text class="strong">{{item.title}}</text><text>{{item.date}} · {{item.category}} · {{item.payerName}}先付</text><text wx:if="{{item.note}}">备注：{{item.note}}</text></view><text class="expense-amount">{{item.displayAmount}}</text></view></view>
          <view wx:else class="empty card"><text>还没有费用，记一笔吧</text></view>
        </block>
        <block wx:else>
          <view class="section-head"><text class="section-title plain">我的资料</text></view>
          <view class="profile card"><image src="{{account.avatarSrc}}" mode="aspectFill"/><view class="grow"><text class="strong">{{account.nickname}}</text><text>微信账号已绑定</text></view><button class="profile-edit" aria-label="编辑资料" bindtap="openProfileTap">✎</button></view>
          <view class="section-head"><text class="section-title plain">旅行与同行人管理</text><button class="outline" bindtap="openCreateTrip">＋ 新建旅行</button></view>
          <view wx:for="{{trips}}" wx:key="id" class="trip-card card {{item.id === trip.id ? 'current' : ''}}">
            <view class="trip-summary" data-id="{{item.id}}" bindtap="switchTrip"><view class="row"><text class="strong">{{item.name}}</text><view class="trip-card-actions"><text wx:if="{{item.id === trip.id}}" class="tag tag-current">{{trip.type || '其他'}}</text><text class="tag {{item.archived ? 'tag-archived' : item.id === trip.id ? 'tag-current' : 'tag-active'}}">{{item.archived ? '已归档' : item.id === trip.id ? '当前旅程' : '进行中'}}</text></view></view><text class="trip-summary-dates">{{item.startDisplay}} → {{item.endDisplay}}</text></view>
            <view wx:if="{{item.id === trip.id}}" class="trip-expanded">
              <view class="member-panel">
                <view class="member-heading"><text class="strong">同行成员</text><text>{{trip.members.length}} 人</text></view>
                <view wx:for="{{trip.members}}" wx:key="id" class="member"><image src="{{item.avatarSrc}}" mode="aspectFill"/><view class="grow"><text class="strong">{{item.name}}</text><text>{{item.id === trip.creator ? '创建者' : '同行成员'}}</text></view><button wx:if="{{isOwner && item.id !== trip.creator}}" class="danger-text" data-action="removeMember" data-id="{{item.id}}" bindtap="confirmDelete">移除</button></view>
                <button wx:if="{{isOwner && !trip.archived}}" class="primary" open-type="share">邀请同行人</button>
              </view>
              <button class="clone-trip" data-id="{{trip.id}}" bindtap="openCloneTrip">创建副本</button>
              <view class="manage-grid"><button wx:if="{{!trip.archived}}" bindtap="openEditTrip">编辑旅行</button><button bindtap="exportCalendar">导出日历</button><button wx:if="{{isOwner}}" bindtap="exportTrip">导出备份</button><button wx:if="{{isOwner}}" class="danger-text" bindtap="deleteTrip">删除旅行</button></view>
            </view>
            <button wx:if="{{item.id !== trip.id && item.canDelete}}" class="trip-delete" data-id="{{item.id}}" bindtap="deleteTrip" aria-label="删除旅行"><image src="/assets/icons/trash.svg" mode="aspectFit"/></button>
          </view>
        </block>
      </view>

    </block>

    <view class="bottom-nav">
      <button class="{{tab === 'today' ? 'active' : ''}}" data-tab="today" bindtap="setTab"><image src="/assets/icons/nav-today.svg" mode="aspectFit" /><text class="small">今天</text></button>
      <button class="{{tab === 'route' ? 'active' : ''}}" data-tab="route" bindtap="setTab"><image src="/assets/icons/nav-route.svg" mode="aspectFit" /><text class="small">行程</text></button>
      <button class="{{tab === 'list' ? 'active' : ''}}" data-tab="list" bindtap="setTab"><image src="/assets/icons/nav-list.svg" mode="aspectFit" /><text class="small">清单</text></button>
      <button class="{{tab === 'expenses' ? 'active' : ''}}" data-tab="expenses" bindtap="setTab"><image src="/assets/icons/nav-list.svg" mode="aspectFit" /><text class="small">记账</text></button>
      <button class="{{tab === 'people' ? 'active' : ''}}" data-tab="people" bindtap="setTab"><image src="/assets/icons/nav-people.svg" mode="aspectFit" /><text class="small">我的</text></button>
    </view>
  </block>

  <view wx:if="{{loginProfile}}" class="modal-mask" bindtap="cancelWechatLogin">
    <view class="modal auth-modal" catchtap="stopBubble">
      <view class="modal-head"><text>{{loginProfile.mode === 'edit' ? '编辑个人资料' : '微信授权登录'}}</text><button bindtap="cancelWechatLogin">×</button></view>
      <scroll-view wx:if="{{loginProfile.mode === 'edit'}}" class="profile-editor" scroll-y>
        <image class="profile-preview" src="{{loginProfile.avatarUrl || loginProfile.avatarData}}" mode="aspectFill"/>
        <text class="profile-label">切换头像</text>
        <view class="profile-source-actions">
          <button open-type="chooseAvatar" bindchooseavatar="chooseWechatAvatar">选择微信头像</button>
          <button bindtap="chooseLocalAvatar">上传图片</button>
        </view>
        <text class="profile-label">选择默认头像</text>
        <view class="profile-avatar-grid">
          <button wx:for="{{avatars}}" wx:key="id" class="{{loginProfile.avatarId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectProfileAvatar" aria-label="{{item.name}}"><image src="{{item.src}}" mode="aspectFill"/></button>
        </view>
        <label class="field profile-name"><text>昵称</text><input value="{{loginProfile.nickname}}" maxlength="40" placeholder="请输入昵称" bindinput="bindWechatNickname"/></label>
        <view class="auth-actions"><button bindtap="cancelWechatLogin">取消</button><button class="primary" disabled="{{busy}}" bindtap="saveProfileEdit">保存</button></view>
      </scroll-view>
      <view wx:elif="{{loginProfile.stage === 'collect'}}" class="wechat-profile-collect">
        <text class="muted">请使用微信提供的头像和昵称完成授权。</text>
        <button class="wechat-avatar" open-type="chooseAvatar" bindchooseavatar="chooseWechatAvatar"><image wx:if="{{loginProfile.avatarUrl}}" src="{{loginProfile.avatarUrl}}" mode="aspectFill"/><text wx:else>选择微信头像</text></button>
        <input class="wechat-nickname" type="nickname" value="{{loginProfile.nickname}}" placeholder="选择微信昵称" bindinput="bindWechatNickname"/>
        <button class="primary wechat-login" disabled="{{busy}}" bindtap="reviewWechatProfile">继续</button>
      </view>
      <view wx:else class="wechat-profile-confirm">
        <image src="{{loginProfile.avatarData || loginProfile.avatarUrl}}" mode="aspectFill"/>
        <text class="state-title">{{loginProfile.nickname}}</text>
        <text class="muted">确认使用以上微信头像和昵称？</text>
        <view class="auth-actions"><button bindtap="cancelWechatLogin">取消</button><button class="primary" disabled="{{busy}}" bindtap="confirmWechatProfile">确定</button></view>
      </view>
    </view>
  </view>

  <view wx:if="{{modal}}" class="modal-mask" bindtap="closeModal">
    <view class="modal" catchtap="stopBubble">
      <view class="modal-head"><text>{{modal.title}}</text><button wx:if="{{!modal.required}}" bindtap="closeModal">×</button></view>
      <scroll-view class="modal-body" scroll-y>
        <block wx:if="{{modal.type === 'trip'}}">
          <label class="field"><text>旅行名称</text><input value="{{modal.values.name}}" data-field="name" bindinput="bindInput"/></label>
          <label class="field"><text>旅行类型</text><picker range="{{tripTypes}}" bindchange="bindType"><view class="picker-value">{{modal.values.type}} 〉</view></picker></label>
          <view class="field-row"><label class="field"><text>出发日期</text><picker mode="date" value="{{modal.values.startDate}}" data-field="startDate" bindchange="bindDate"><view class="picker-value">{{modal.values.startDate}}</view></picker></label><label class="field"><text>时间</text><picker mode="time" value="{{modal.values.startTime}}" data-field="startTime" bindchange="bindTime"><view class="picker-value">{{modal.values.startTime}}</view></picker></label></view>
          <view class="field-row"><label class="field"><text>归来日期</text><picker mode="date" value="{{modal.values.endDate}}" data-field="endDate" bindchange="bindDate"><view class="picker-value">{{modal.values.endDate}}</view></picker></label><label class="field"><text>时间</text><picker mode="time" value="{{modal.values.endTime}}" data-field="endTime" bindchange="bindTime"><view class="picker-value">{{modal.values.endTime}}</view></picker></label></view>
        </block>
        <block wx:elif="{{modal.type === 'cloneTrip'}}">
          <view class="notice">将复制“{{trip.name}}”的日期、行程、住宿、清单和票据。原旅行不会改变；同行人需在新副本中重新邀请。</view>
          <label class="field"><text>副本名称</text><input value="{{modal.values.name}}" maxlength="200" data-field="name" bindinput="bindInput"/></label>
        </block>
        <block wx:elif="{{modal.type === 'event'}}">
          <label class="field"><text>做什么</text><input value="{{modal.values.title}}" data-field="title" bindinput="bindInput"/></label>
          <label class="field"><text>日期</text><picker mode="date" value="{{modal.values.date}}" data-field="date" bindchange="bindDate"><view class="picker-value">{{modal.values.date}}</view></picker></label>
          <view class="field-row"><label class="field"><text>开始时间</text><picker mode="time" value="{{modal.values.startTime}}" data-field="startTime" bindchange="bindTime"><view class="picker-value">{{modal.values.startTime}}</view></picker></label><label class="field"><text>结束时间</text><picker mode="time" value="{{modal.values.endTime}}" data-field="endTime" bindchange="bindTime"><view class="picker-value">{{modal.values.endTime}}</view></picker></label></view>
          <label class="field"><text>起始地</text><input value="{{modal.values.startPlace}}" data-field="startPlace" bindinput="bindInput"/></label><label class="field"><text>目的地</text><input value="{{modal.values.endPlace}}" data-field="endPlace" bindinput="bindInput"/></label><label class="field"><text>具体地址</text><input value="{{modal.values.address}}" data-field="address" bindinput="bindInput"/></label><label class="field"><text>备注</text><textarea value="{{modal.values.note}}" data-field="note" bindinput="bindInput"/></label>
        </block>
        <block wx:elif="{{modal.type === 'hotel'}}">
          <label class="field"><text>住宿名称</text><input value="{{modal.values.name}}" data-field="name" bindinput="bindInput"/></label><label class="field"><text>城市</text><input value="{{modal.values.city}}" data-field="city" bindinput="bindInput"/></label><label class="field"><text>具体地址</text><input value="{{modal.values.address}}" data-field="address" bindinput="bindInput"/></label>
          <view class="field-row"><label class="field"><text>入住</text><picker mode="date" value="{{modal.values.checkin}}" data-field="checkin" bindchange="bindDate"><view class="picker-value">{{modal.values.checkin}}</view></picker></label><label class="field"><text>退房</text><picker mode="date" value="{{modal.values.checkout}}" data-field="checkout" bindchange="bindDate"><view class="picker-value">{{modal.values.checkout}}</view></picker></label></view><label class="field"><text>电话（选填）</text><input value="{{modal.values.phone}}" data-field="phone" bindinput="bindInput"/></label><label class="field"><text>备注</text><textarea value="{{modal.values.note}}" data-field="note" bindinput="bindInput"/></label>
        </block>
        <block wx:elif="{{modal.type === 'item'}}">
          <view wx:if="{{!modal.edit}}" class="item-context">{{modal.categoryName}}</view><label class="field"><text>条目名称</text><input value="{{modal.values.title}}" data-field="title" bindinput="bindInput"/></label><label wx:if="{{modal.edit}}" class="field"><text>分类</text><picker range="{{modal.categories}}" range-key="name" value="{{modal.categoryIndex}}" bindchange="bindCategory"><view class="picker-value">{{modal.categories[modal.categoryIndex].name}} 〉</view></picker></label><label class="switch-row"><text>设为关键项</text><switch checked="{{modal.values.key}}" data-field="key" bindchange="bindSwitch" color="#4f8ee8"/></label>
        </block>
        <block wx:elif="{{modal.type === 'category'}}"><label class="field"><text>分类名称</text><input value="{{modal.values.name}}" data-field="name" bindinput="bindInput"/></label></block>
        <block wx:elif="{{modal.type === 'templates'}}"><button wx:for="{{templates}}" wx:key="id" class="template-card" data-id="{{item.id}}" bindtap="openTemplateDetail"><view class="template-icon-slot"><image class="template-symbol" src="{{item.iconSrc}}" mode="aspectFit"/></view><view class="grow"><text class="strong">{{item.name}}</text><text class="small">{{item.items.length}} 项</text></view><text class="template-arrow">›</text></button></block>
        <block wx:elif="{{modal.type === 'templateDetail'}}"><view class="template-detail-head"><image class="template-symbol large" src="{{modal.template.iconSrc}}" mode="aspectFit"/><view class="grow"><text class="template-badge">建议放入{{modal.template.recommendedScope === '公共' ? '一起准备' : '我的物品'}}</text><text class="template-description">{{modal.template.description}}</text></view></view><view class="template-items"><view wx:for="{{modal.template.items}}" wx:key="title" class="template-item"><text>{{item.title}}</text><text wx:if="{{item.key}}" class="key-tag">关键项</text></view></view><button class="primary template-import" data-id="{{modal.template.id}}" bindtap="importTemplate">导入到{{scope === '公共' ? '一起准备' : '我的物品'}}</button><button class="template-back" bindtap="openTemplates">返回模板列表</button></block>
        <block wx:elif="{{modal.type === 'join'}}"><view class="notice">你将以微信账号“{{account.nickname}}”加入这趟旅行，头像和昵称会保持全账号一致。</view></block>
        <block wx:elif="{{modal.type === 'ticket'}}"><label class="field"><text>票据类型</text><input value="{{modal.values.type}}" data-field="type" bindinput="bindInput"/></label><view class="field-row"><label class="field"><text>使用日期</text><picker mode="date" value="{{modal.values.useDate}}" start="{{tripStartDate}}" end="{{tripEndDate}}" data-field="useDate" bindchange="bindDate"><view class="picker-value">{{modal.values.useDate}}</view></picker></label><label class="field"><text>使用时间</text><picker mode="time" value="{{modal.values.useClock}}" data-field="useClock" bindchange="bindTime"><view class="picker-value">{{modal.values.useClock}}</view></picker></label></view></block>
        <block wx:elif="{{modal.type === 'ticketMeta'}}"><label class="field"><text>票据类型</text><input value="{{modal.values.type}}" data-field="type" bindinput="bindInput"/></label><view class="field-row"><label class="field"><text>使用日期</text><picker mode="date" value="{{modal.values.useDate}}" start="{{tripStartDate}}" end="{{tripEndDate}}" data-field="useDate" bindchange="bindDate"><view class="picker-value">{{modal.values.useDate}}</view></picker></label><label class="field"><text>使用时间</text><picker mode="time" value="{{modal.values.useClock}}" data-field="useClock" bindchange="bindTime"><view class="picker-value">{{modal.values.useClock}}</view></picker></label></view></block>
        <block wx:elif="{{modal.type === 'expense'}}"><label class="field"><text>哪一天</text><picker mode="date" value="{{modal.values.date}}" start="{{tripStartDate}}" end="{{tripEndDate}}" data-field="date" bindchange="bindDate"><view class="picker-value">{{modal.values.date}}</view></picker></label><label class="field"><text>干什么</text><input value="{{modal.values.title}}" data-field="title" bindinput="bindInput"/></label><label class="field"><text>金额（元）</text><input type="digit" value="{{modal.values.amount}}" data-field="amount" bindinput="bindInput"/></label><label class="field"><text>备注</text><textarea value="{{modal.values.note}}" data-field="note" bindinput="bindInput"/></label><label class="switch-row"><text>AA 分账</text><switch checked="{{modal.values.isAA}}" data-field="isAA" bindchange="bindSwitch" color="#4f8ee8"/></label></block>
      </scroll-view>
      <button wx:if="{{modal.type === 'ticket'}}" class="primary modal-submit" disabled="{{busy}}" bindtap="submitTicket">上传票据</button>
      <button wx:elif="{{modal.type !== 'templates' && modal.type !== 'templateDetail'}}" class="primary modal-submit" disabled="{{busy}}" bindtap="submitModal">{{modal.type === 'join' ? '确认加入' : modal.type === 'cloneTrip' ? '创建副本' : '保存'}}</button>
    </view>
  </view>
</view>
