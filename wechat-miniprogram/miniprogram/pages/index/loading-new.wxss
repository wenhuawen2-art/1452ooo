/* New reference: 786 × 1704 (exactly 393 × 852 logical pixels). */
.new-loading-surface{position:absolute;top:0;right:0;bottom:0;left:0;width:100%;height:100%;overflow:hidden;background:#eaf4ff}
.new-loading-fallback{position:absolute;top:55%;left:0;right:0;display:flex;flex-direction:column;align-items:center;text-align:center;color:#001126;font-size:24px;font-weight:700}
.new-loading-fallback image{display:block;width:76px;height:76px;margin-bottom:16px}
.new-loading-fallback text+text{margin-top:6px;color:#526477;font-size:14px;font-weight:400}
.new-loading-reference{display:block;position:absolute;top:0;left:0;width:100%;height:100%;z-index:1}
.new-loading-landscape{display:block;position:absolute;left:-12.5%;top:-2%;width:125%;height:57%;z-index:2}
