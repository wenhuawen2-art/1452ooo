@keyframes sky-light{from{opacity:.45;transform:translateX(-20rpx)}to{opacity:.9;transform:translateX(20rpx)}}
@keyframes content-arrive{from{opacity:.4;transform:translateY(12rpx)}to{opacity:1;transform:none}}
@keyframes sheet-arrive{from{opacity:.5;transform:translateY(50rpx)}to{opacity:1;transform:none}}
@keyframes spin{to{transform:rotate(360deg)}}
@media(prefers-reduced-motion:reduce){.today-hero:before,.module-hero:before,.content,.modal,.nav-item,.progress-fill{animation:none!important;transition:none!important}}
