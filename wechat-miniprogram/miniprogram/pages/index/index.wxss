.route-stop-title{display:flex;align-items:center;gap:10rpx;flex-wrap:wrap}.route-source{display:inline-flex;padding:5rpx 9rpx;border-radius:11rpx;background:#edf3fb;color:#5f7391;font-size:18rpx}.route-source.lodging{background:#e8f5ec;color:#4c8a60}.route-source.administrative{background:#fff3df;color:#9a6b25}.route-source.unresolved{background:#fff0ef;color:#c85d5d}.route-original{display:block;margin-top:4rpx;color:#9aa4b3;font-size:18rpx}
.route-editor{flex:1;min-height:0;padding:22rpx 24rpx 150rpx;box-sizing:border-box}.route-editor-point{margin-top:18rpx;padding:20rpx;border:2rpx solid #e3eaf4;border-radius:26rpx;background:#fff}.route-editor-point.excluded{opacity:.52}.route-editor-top{display:flex;align-items:center;gap:14rpx}.route-editor-top input,.route-address-input{height:70rpx;padding:0 16rpx;border-radius:16rpx;background:#f4f7fb;box-sizing:border-box}.route-address-input{width:100%;margin-top:12rpx}.route-mode-picker{margin-top:12rpx;background:#f0f5fc}.route-editor-actions{display:grid;grid-template-columns:1fr 1fr 1.5fr;gap:10rpx;margin-top:12rpx}.route-editor-actions button{height:58rpx;border-radius:16rpx;background:#edf4fd;color:#3978d4;font-size:20rpx}.route-search{margin-top:14rpx;padding:14rpx;border-radius:18rpx;background:#f4f7fb}.route-search-bar{display:flex;gap:10rpx}.route-search-bar input{height:66rpx;padding:0 14rpx;border-radius:14rpx;background:#fff}.route-search-bar button{padding:0 20rpx;border-radius:14rpx;background:#4f8ee8;color:#fff}.route-search-result{display:block;width:100%;margin-top:10rpx;padding:14rpx;text-align:left;border-radius:14rpx;background:#fff}.route-search-result text{display:block}.route-editor-bottom-space{height:80rpx}.route-editor-footer{display:grid;grid-template-columns:1fr 1.5fr;gap:14rpx;padding:18rpx 24rpx 34rpx;background:#fff;box-shadow:0 -8rpx 24rpx rgba(32,51,79,.08)}.route-editor-footer button{height:76rpx}
.route-editor-resolution{display:flex;align-items:center;gap:10rpx;margin:12rpx 0 0 62rpx;color:#8b96a7;font-size:19rpx}

/* Keep native button content optically centered across simulator and device fonts. */
button::after{border:0}
.check,.review,.ticket-actions button,.expense-entry-actions button,.expense-settings,.expense-filters button,.settlement-row button,.receipt-picker,.receipt-remove,.outfit-actions button,.outfit-item-heading button,.outfit-item-remove,.outfit-photo-picker button,.outfit-type-create button,.outfit-type-row button,.modal-head button,.route-map-head button,.route-editor-actions button,.route-search-bar button,.guest-banner button{display:flex;align-items:center;justify-content:center;text-align:center;box-sizing:border-box;line-height:1.2}
.check{flex:none;padding:0}
button[disabled]{opacity:.55}
.check-toggle-zone.readonly{cursor:default}
.receipt-actions{display:flex;gap:12rpx;margin-bottom:22rpx}.receipt-actions .receipt-picker{min-width:0;flex:1;margin-bottom:0}.receipt-remove{flex:none;height:82rpx;padding:0 20rpx;border-radius:22rpx;font-size:22rpx}

.outfit-item-editor-single{margin-bottom:0}.outfit-item-editor-single .outfit-item-name{margin:0}.outfit-item-editor-single .outfit-photo-picker{margin-top:18rpx}
.outfit-head-actions .mini-btn{display:flex;align-items:center;justify-content:center;width:62rpx;height:62rpx;min-width:62rpx;padding:0;border-radius:50%;box-sizing:border-box;line-height:1}
.outfit-head-actions .mini-btn image{display:block;width:28rpx;height:28rpx}
.outfit-head-actions .outfit-item-create{background:#edf4fd;color:#3978d4;font-size:32rpx;font-weight:400;line-height:1}
