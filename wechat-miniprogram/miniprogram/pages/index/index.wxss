/* Surface, status, and action hierarchy */
.card,.hero-card,.date-chip.active,.segment button.active,.modal{box-shadow:none}
.trip-card .strong{font-weight:500}
.trip-card{position:relative;margin-bottom:20rpx;padding:24rpx;border:2rpx solid transparent;border-radius:28rpx;background:#fff}
.trip-card.current{border:2rpx solid #78a7ef}
.trip-summary{display:block;text-align:left}
.trip-summary .row{align-items:center}
.trip-summary .strong{font-weight:600}
.trip-summary-dates{display:block;margin-top:14rpx;color:#647187;font-size:24rpx}
.trip-card-actions{flex-wrap:wrap;justify-content:flex-end}
.trip-expanded{margin-top:20rpx;padding-top:18rpx;border-top:2rpx solid #e6edf6}
.member-panel{padding:16rpx 18rpx;border-radius:20rpx;background:#f4f6f9}
.member-heading{display:flex;align-items:center;justify-content:space-between;font-size:25rpx}
.member-panel .member{padding:16rpx 0}
.member-panel .member image{width:64rpx;height:64rpx}
.member-panel .primary{margin-top:12rpx;min-height:64rpx}
.clone-trip{width:100%;min-height:70rpx;margin-top:16rpx;border-radius:18rpx;background:#e6f1ff;color:#3978d4;font-size:26rpx}
.trip-card .manage-grid{margin-top:16rpx}
.trip-card .trip-delete{position:absolute;right:18rpx;bottom:16rpx}
.profile .strong{color:#111827}
.tag-current{background:#dcecff;color:#3978d4}
.tag-active{background:#e4f5e8;color:#318653}
.tag-archived{background:#edf0f3;color:#8993a0}
.outline,.icon-actions button,.mini-btn,.profile-edit,.manage-grid button,.review{background:#e5effc}
.check{background:#e3eaf4}
.modal-head button{background:#e3eaf4}

/* Itinerary action emphasis and route destination alignment */
.icon-actions button,.mini-btn,.profile-edit{background:#eef4fd}
.icon-actions .danger-text{background:#fff0f0!important}
.icon-actions .danger-text image{width:32rpx;height:32rpx}
.event-note{display:flex;align-items:flex-start;gap:12rpx;margin-top:16rpx;padding:14rpx 18rpx;border-radius:14rpx;background:#f3f7fc;color:#52647d;font-size:23rpx;line-height:1.5;white-space:pre-wrap;overflow-wrap:anywhere}.event-note-label{flex:none;color:#6187bb}.event-note-content{flex:1;min-width:0}
.mini-btn.danger-text{background:#fff4f3}
.route-box{column-gap:8rpx}
.route-box .route-destination{justify-self:end;text-align:right}
.event-copy>.strong{font-size:32rpx;font-weight:500}
.event-activity{display:flex;align-items:baseline;gap:16rpx;min-width:0;margin-top:10rpx}
.event-activity .strong{flex:none;color:#3978d4;font-size:32rpx;font-weight:500;white-space:nowrap}
.event-activity .address{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

/* Checklist selection and confirmation identity */
.check{width:48rpx;height:48rpx;padding:0;box-sizing:border-box;display:flex;align-items:center;justify-content:center;border:3rpx solid #cfd7e1;border-radius:50%;background:#fff;color:#fff;font-size:30rpx;font-weight:500;line-height:1;text-align:center}
.check.done{border-color:#5d92e5;background:linear-gradient(145deg,#7fa8ee,#5d8cdf);box-shadow:0 4rpx 10rpx rgba(81,124,202,.18)}
.confirmation{display:flex;align-items:center;gap:6rpx;margin-top:8rpx;color:#667184;font-size:20rpx;line-height:32rpx}
.confirmation image{width:32rpx;height:32rpx;border-radius:50%;flex:none}
.confirmation-name{color:#667184}
.confirmation-status{color:#5f89d2}
