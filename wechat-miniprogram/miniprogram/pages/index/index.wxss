/* Surface, status, and action hierarchy */
.card,.hero-card,.date-chip.active,.segment button.active,.modal{box-shadow:none}
.trip-card .strong{font-weight:500}
.profile .strong{color:#111827}
.tag-current{background:#dcecff;color:#3978d4}
.tag-active{background:#e4f5e8;color:#318653}
.tag-archived{background:#edf0f3;color:#8993a0}
.outline,.icon-actions button,.mini-btn,.profile-edit,.manage-grid button,.review{background:#e5effc}
.check{background:#e3eaf4}
.modal-head button{background:#e3eaf4}

/* Itinerary action emphasis and route destination alignment */
.icon-actions button,.mini-btn,.profile-edit{background:#eef4fd}
.mini-btn.danger-text{background:#fff4f3}
.route-box{column-gap:8rpx}
.route-box .route-destination{justify-self:end;text-align:right}
.event-copy>.strong{font-size:32rpx;font-weight:500}
.event-activity{display:flex;align-items:baseline;gap:16rpx;min-width:0;margin-top:10rpx}
.event-activity .strong{flex:none;color:#3978d4;font-size:32rpx;font-weight:500;white-space:nowrap}
.event-activity .address{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

.ticket-preview{width:100%;padding:0;background:transparent;text-align:left}.ticket-actions{display:flex;gap:12rpx;padding:8rpx}.ticket-actions button{flex:1;min-height:56rpx;border-radius:14rpx;background:#eef6ff;color:#3978d4;font-size:24rpx}

