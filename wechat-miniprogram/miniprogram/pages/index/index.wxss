.bottom-nav{left:28rpx;right:28rpx;padding:12rpx;border-radius:38rpx;background:rgba(255,255,255,.97);box-shadow:0 24rpx 70rpx rgba(29,54,88,.25),0 6rpx 22rpx rgba(29,54,88,.12)}.bottom-nav button{height:104rpx;border-radius:30rpx;gap:6rpx}.bottom-nav button image{width:38rpx;height:38rpx;opacity:.34}.bottom-nav button.active image{opacity:1}.bottom-nav button .small{font-size:22rpx}
.item-context{margin-bottom:20rpx;padding:18rpx 22rpx;border-radius:20rpx;background:#edf4fd;color:#3978d4;font-size:24rpx}
.template-card{align-items:center;min-height:104rpx;padding:22rpx 24rpx}.template-card .strong{color:#17243f;font-size:30rpx;line-height:1.3;font-weight:700;margin:0 0 8rpx}.template-card .small{margin:0;color:#3978d4;font-size:22rpx}.template-symbol{width:64rpx;height:64rpx;padding:12rpx;box-sizing:border-box;border-radius:18rpx;background:#edf4fd}.template-arrow{color:#9aa7b7!important;font-size:40rpx!important;margin:0!important}.template-detail-head{display:flex;align-items:center;gap:20rpx;padding:6rpx 0 24rpx}.template-symbol.large{width:84rpx;height:84rpx;border-radius:22rpx}.template-badge{display:inline-flex;padding:6rpx 12rpx;border-radius:12rpx;background:#e8f2ff;color:#3978d4;font-size:20rpx}.template-description{display:block;margin-top:12rpx;color:#667184;font-size:24rpx;line-height:1.5}.template-items{overflow:hidden;border-radius:24rpx;background:#fff}.template-item{min-height:80rpx;padding:0 22rpx;display:flex;align-items:center;justify-content:space-between;gap:16rpx;border-bottom:2rpx solid #edf0f4}.template-item:last-child{border-bottom:0}.template-import{margin-top:24rpx}.template-back{width:100%;min-height:72rpx;margin-top:12rpx;color:#3978d4;font-size:24rpx}.modal-body{padding-bottom:2rpx}
