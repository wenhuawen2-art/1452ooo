/* V2: licensed travel photography on staggered, asymmetric flight paths. */
.photo-loading-surface{position:absolute;inset:0;overflow:hidden;display:flex;justify-content:center;align-items:center;background:#f3f6fa}
.photo-loading-haze{position:absolute;inset:10% -30%;background:radial-gradient(ellipse at 50% 48%,#e1eaf7 0,rgba(235,240,247,.5) 42%,transparent 68%)}
.photo-loading-stage{position:relative;width:750rpx;max-width:100%;height:920rpx;flex:none;perspective:1200rpx}
.photo-loading-brand{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);font-size:72rpx;font-weight:650;letter-spacing:6rpx;color:#244566;z-index:5}
.photo-fragment{position:absolute;top:50%;left:50%;box-sizing:border-box;border:3rpx solid rgba(255,255,255,.96);border-radius:12rpx;overflow:hidden;background:#e2e9ef;box-shadow:0 14rpx 28rpx rgba(36,59,89,.14),0 2rpx 4rpx rgba(36,59,89,.08);animation-timing-function:linear;animation-iteration-count:infinite;will-change:transform;pointer-events:none;backface-visibility:hidden}
.photo-fragment image{display:block;width:100%;height:100%}
.motion-paused .photo-fragment,.reduced-motion .photo-fragment{animation-play-state:paused}
@media(prefers-reduced-motion:reduce){.photo-fragment{animation-play-state:paused}}
@media(max-height:580px){.photo-loading-stage{transform:scale(.82)}}
