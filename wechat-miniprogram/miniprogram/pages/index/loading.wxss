/* Travel fragments: transform-only elliptical motion, with depth and staggered phases. */
.journey-loading{position:fixed;inset:0;z-index:120;background:#f3f7fc;overflow:hidden;display:flex;align-items:center;justify-content:center;flex-direction:column;color:#17212c}
.journey-loading-glow{position:absolute;width:900rpx;height:1000rpx;top:4%;left:50%;margin-left:-450rpx;background:radial-gradient(ellipse,rgba(113,175,242,.26),rgba(214,234,253,.12) 50%,transparent 72%);pointer-events:none}
.journey-loading-stage{position:relative;width:750rpx;max-width:100%;height:790rpx;flex:none;margin-top:-100rpx}
.journey-loading-core{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);text-align:center;z-index:5;width:260rpx}
.journey-loading-name{display:block;font-size:84rpx;font-weight:650;letter-spacing:10rpx;color:#244b76}
.journey-loading-en{display:block;font-size:18rpx;letter-spacing:4rpx;color:#7294b9;margin-top:10rpx}
.journey-fragment{position:absolute;top:50%;left:50%;margin-left:-45rpx;margin-top:-55rpx;padding:5rpx 5rpx 17rpx;border-radius:13rpx;background:#fff;box-shadow:0 12rpx 26rpx rgba(41,76,116,.14);animation-duration:8.1s;animation-timing-function:linear;animation-iteration-count:infinite;will-change:transform;pointer-events:none}
.journey-fragment image{display:block;width:100%;height:100%;border-radius:8rpx}
.journey-orbit-0{animation-name:journey-orbit-a}.journey-orbit-1{animation-name:journey-orbit-b}.journey-orbit-2{animation-name:journey-orbit-c}
.journey-loading-copy{position:relative;z-index:12;text-align:center;margin-top:-20rpx}
.journey-loading-title{display:block;font-size:34rpx;letter-spacing:3rpx;font-weight:500}
.journey-loading-status{display:flex;align-items:center;justify-content:center;gap:14rpx;margin-top:24rpx;color:#72869d;font-size:26rpx}
.journey-loading-dot{width:10rpx;height:10rpx;border-radius:50%;background:#438fe8;animation:journey-breathe 1.6s ease-in-out infinite}
.journey-loading-footer{position:absolute;bottom:calc(54rpx + env(safe-area-inset-bottom));font-size:23rpx;letter-spacing:3rpx;color:#8d9bae}
@keyframes journey-breathe{0%,100%{opacity:.35;transform:scale(.8)}50%{opacity:1;transform:scale(1.2)}}
.motion-paused .journey-fragment,.motion-paused .journey-loading-dot{animation-play-state:paused}
.reduced-motion .journey-fragment,.reduced-motion .journey-loading-dot{animation-play-state:paused}
@media(prefers-reduced-motion:reduce){.journey-fragment,.journey-loading-dot{animation-play-state:paused}}
@media(max-height:650px){.journey-loading-stage{height:710rpx;transform:scale(.84);margin-top:-110rpx}.journey-loading-copy{margin-top:-60rpx}}
