@import "../index/interaction-motion.wxss";
page{background:#fff;color:#001126}.wc-page{min-height:100vh;padding:0 12px calc(24px + var(--safe-bottom,0px));box-sizing:border-box;font-family:'Alibaba PuHuiTi 2.0',sans-serif}.wc-header{position:fixed;top:0;left:0;right:0;z-index:40;display:flex;align-items:center;gap:12px;padding:var(--wc-top,16px) 16px 12px;background:#ffffffed;backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px)}.wc-header>text{flex:1;text-align:center;font-size:20px;font-weight:500;line-height:40px}.wc-header button,.wc-header>view{width:40px;height:40px;flex:none}.wc-header button{display:flex;align-items:center;justify-content:center;margin:0;padding:0;border:0;background:transparent;border-radius:50%}.wc-header button:after{border:0}.wc-header image{width:24px;height:24px;filter:brightness(0)}.wc-cards{display:flex;flex-direction:column;gap:12px}.wc-card{position:relative;display:flex;justify-content:space-between;min-height:96px;padding:14px 16px;box-sizing:border-box;overflow:hidden;border-radius:16px;background:#5585c7;color:#fff;transition:transform 260ms cubic-bezier(.22,1,.36,1),opacity 140ms ease;animation:xy-content-a 280ms cubic-bezier(.22,1,.36,1)}.wc-sky,.wc-shade{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}.wc-sky{object-position:center 35%;filter:saturate(.75) brightness(.8)}.wc-shade{background:linear-gradient(115deg,#2866af44,#1c4c9266)}.wc-card.cloudy .wc-sky,.wc-card.rain .wc-sky{filter:grayscale(.65) brightness(.55)}.wc-card.rain .wc-shade{background:repeating-linear-gradient(104deg,transparent 0 15px,#ffffff12 16px,transparent 17px 34px),linear-gradient(115deg,#27425d66,#344e7199)}.wc-card.unavailable{background:#8194b0}.wc-card.unavailable .wc-sky{opacity:.3}.wc-city,.wc-temperatures{position:relative;display:flex;flex-direction:column;justify-content:space-between;gap:12px;min-width:0}.wc-city>text:first-child{font-size:20px;font-weight:400;line-height:28px;overflow-wrap:anywhere}.wc-city>text:last-child,.wc-temperatures>text:last-child{font-size:14px;line-height:20px}.wc-temperatures{flex:none;align-items:flex-end;white-space:nowrap;margin-left:12px}.wc-current{font-size:40px;font-weight:300;line-height:44px}.wc-state{display:flex;flex-direction:column;gap:8px;padding:48px 16px;text-align:center;color:#748196;font-size:14px;line-height:24px}.wc-demo{display:block;margin:0 4px 12px;color:#748196;font-size:12px}.wc-page .motion-pressed{transform:scale(.98);opacity:.85}

.wc-temperatures{gap:4px}.wc-page button{transition:transform 260ms cubic-bezier(.22,1,.36,1),opacity 140ms ease}.wc-page .button-hover{transform:scale(.97);opacity:.8}
