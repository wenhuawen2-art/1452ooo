
page{margin:0;padding:0;background:#edf1f5;color:#001126}
.pp-page,.pp-page view,.pp-page text,.pp-page button{box-sizing:border-box}
.pp-page{position:relative;min-height:1061px;padding:16px 16px 50px;overflow:hidden;background:linear-gradient(180deg,#007bff 0%,rgba(6,126,255,.98) 15%,rgba(255,255,255,0) 100%) 0 0/100% 441px no-repeat,#edf1f5}
.pp-page text,.pp-page button{font-family:'Alibaba PuHuiTi 2.0',sans-serif;font-size:16px;line-height:22px}
.pp-page button{display:flex;align-items:center;justify-content:center;margin:0;padding:0;min-height:0;border:0;line-height:normal;background:transparent;color:#001126}.pp-page button:after{border:0}
.pp-sky{position:absolute;left:0;top:0;width:100%;height:441px;overflow:hidden;pointer-events:none}.pp-cloud{position:absolute;width:583px;height:413px}.pp-cloud.right{left:86px;top:0;width:307px;height:304px}.pp-cloud.left{left:0;top:0;width:269px;height:334px}.pp-cloud.bottom{left:4px;top:173px;width:389px;height:268px}
.pp-nav{position:relative;display:flex;align-items:center;gap:16px;height:40px;z-index:2}.pp-nav>text{flex:1;text-align:center;font-size:20px;font-weight:600;line-height:28px;color:#001126}.pp-nav button{width:40px;height:40px;flex:none;border-radius:50%;background:rgba(0,17,38,.2)}.pp-nav image{width:20px;height:20px}.pp-nav .pp-settings{background:transparent}
.pp-hero{position:relative;margin-top:30px;height:262px;padding-top:40px;display:flex;flex-direction:column;align-items:center}.pp-portrait{width:100px;height:100px;border:1px solid #fff;border-radius:50%;overflow:hidden;box-shadow:0 10px 20px #00255833;z-index:1}.pp-portrait image{width:100%;height:100%;max-width:none}.pp-name{display:flex;align-items:center;justify-content:center;gap:16px;margin-top:24px;z-index:1;max-width:100%}.pp-name>text{font-size:24px;font-weight:700;line-height:34px;max-width:240px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.pp-name button{width:36px;height:36px;border-radius:50%;background:#00112633}.pp-name button image{width:24px;height:24px}.pp-sticker{position:absolute;pointer-events:none}.pp-sticker.fire{left:-5px;top:25px;width:60px;height:60px}.pp-sticker.camp{left:49px;top:103px;width:42px;height:47px}.pp-sticker.bike{left:229px;top:-12px;width:37.85px;height:42px}.pp-sticker.car{left:257px;top:96px;width:27.63px;height:28px}.pp-sticker.tree{right:20px;top:42px;width:34px;height:37px}
.pp-section{position:relative;display:flex;align-items:center;justify-content:space-between;height:36px;gap:12px}.pp-section>text{font-size:18px;font-weight:600;line-height:25px}.pp-section button{height:36px;gap:4px;padding:0 16px;background:#ffffff80;border:1px solid #0011261a;border-radius:237px;white-space:nowrap}.pp-section button image{width:20px;height:20px}
.pp-trips{position:relative;display:flex;flex-direction:column;gap:12px;margin-top:16px}.pp-trip{display:flex;flex-direction:column;gap:16px;padding:11px;border:1px solid #ffffffcc;border-radius:16px;background:#ffffff99;backdrop-filter:blur(10px)}.pp-trip.current{border-color:#4699ff;background:linear-gradient(180deg,rgba(0,114,255,.06),#fff0 50%),#ffffff99}.pp-trip-head{display:flex;align-items:center;gap:12px;min-height:30px;position:relative}.pp-trip-name{font-size:18px!important;font-weight:500;line-height:25px!important;max-width:62%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.expanded .pp-trip-name{font-weight:700}.pp-type{padding:3px 8px;color:#0072ff;background:#7dadff33;border:1px solid #0072ff33;border-radius:8px;font-size:14px!important;line-height:20px!important;white-space:nowrap}.pp-trip-head>image{margin-left:auto;width:30px;height:30px;flex:none}.pp-archive{font-size:12px!important;color:#6f7c8d}.pp-dates{display:flex;align-items:center;gap:12px}.pp-dates text{flex:1;white-space:nowrap}.pp-dates image{width:20px;height:20px;flex:none}.pp-members{display:flex;flex-direction:column;gap:16px;padding:12px;background:#3f5a870f;border-radius:12px}.pp-members-title{display:flex;align-items:center;justify-content:space-between}.pp-members-title text{font-size:18px;font-weight:600;line-height:25px}.pp-member{display:flex;align-items:center;gap:8px;min-height:40px}.pp-member>image{width:40px;height:40px;border:1.33px solid #fff;border-radius:50%;flex:none}.pp-member>text:nth-child(2){flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:500}.pp-owner{color:#0072ff;font-weight:700}.pp-member .pp-remove{position:relative;color:#ff1e00;font-weight:700;height:40px}.pp-member .pp-remove:before{content:"";position:absolute;inset:-2px 0}.pp-members .pp-invite{height:36px;border-radius:12px;background:#ffffffb3;gap:8px}.pp-invite image{width:24px;height:24px}.pp-invite text{font-size:14px;color:#333e}.pp-actions{display:flex;gap:16px}.pp-actions button{flex:1;height:40px;background:#ffffff80;border:1px solid #0011261a;border-radius:237px}.pp-actions image{width:20px;height:20px}.pp-actions button:nth-child(2) image{width:24px;height:24px}.pp-empty{padding:40px 16px;background:#ffffff99;border-radius:16px;text-align:center}.pp-settings-panel{position:relative;margin-top:16px;padding:16px;border-radius:16px;background:#ffffffe6}.pp-settings-panel>view{display:flex;align-items:center;justify-content:space-between}.pp-settings-panel button{height:44px;width:100%;margin-top:12px;background:#edf4ff;border-radius:12px}
@media(max-width:374px){.pp-section>text{font-size:16px}.pp-section button{padding:0 10px}.pp-dates{gap:6px}.pp-dates text{font-size:14px}.pp-trip-head{gap:8px}.pp-type{padding:3px 6px}}
.pp-sky:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 0%,rgba(237,241,245,.5) 30%,rgba(237,241,245,.98) 68%,#edf1f5 84%)}



.pp-current{display:flex;align-items:center;gap:6px;flex:none;white-space:nowrap}.pp-current>view{width:8px;height:8px;border-radius:50%;background:#66c82b}.pp-current>text{color:#66c82b;font-size:14px;font-weight:600;line-height:20px}
@import "../index/components.wxss"; @import "../index/forms-sheet.wxss";
/* Latest reference: current-trip date block has an additional 20px separation. */
.pp-trip{background:#fff}.pp-trip.current{background:#fff}.pp-trip.current .pp-dates{margin-top:20px}.pp-type{border-color:transparent}.pp-current>view{background:#14cb00}.pp-current>text{color:#14cb00;font-weight:500}
@import "../../styles/control-geometry.wxss";
.pp-sticker.bike{width:38.34px}.pp-sticker.car{width:28.64px}.pp-sticker.tree{width:33.08px}

@import "../index/interaction-motion.wxss";
.pp-header{position:fixed;top:0;left:0;right:0;z-index:40;padding:0 16px 12px;pointer-events:none}.pp-header .pp-nav{pointer-events:auto}.pp-nav-space{height:40px}

@import "../index/sticky-header.wxss";

.pp-trip-head .pp-switch-trip{flex:none;margin-left:auto;padding:0 12px;min-width:52px;height:32px;min-height:32px;border:1px solid #0011261a;border-radius:999px;background:#ffffff80;color:#001126;font-size:14px;line-height:32px;display:flex;align-items:center;justify-content:center;position:relative}.pp-switch-trip:before{content:"";position:absolute;inset:-6px 0}.pp-switch-trip+image{margin-left:0}.pp-trip-name{min-width:0;flex-shrink:1}

.pp-trip-head .pp-switch-trip image{width:20px;height:20px;flex:none}
