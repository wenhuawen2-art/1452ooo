<view class="pp-page {{reducedMotion ? 'reduced-motion' : ''}}" style="padding-top:{{systemContentTop}}px">
 <view class="pp-sky"><image class="pp-cloud right" src="/assets/mastergo-profile/cloud-right.webp"/><image class="pp-cloud left" src="/assets/mastergo-profile/cloud-left.webp"/><image class="pp-cloud bottom" src="/assets/mastergo-profile/cloud-bottom.webp"/></view>
 <view class="pp-header" style="padding-top:{{systemContentTop}}px;--header-progress:{{profileHeaderProgress || 0}}"><view class="pp-header-blur"></view><view class="pp-nav"><button bindtap="back" aria-label="返回上一页"><image src="/assets/mastergo-profile/svg_28f66596.svg" mode="aspectFit"/></button><text>我的</text><button class="pp-settings" bindtap="toggleSettings" aria-label="我的设置"></button></view></view><view class="pp-nav-space"></view>
 <view class="pp-hero"><view class="pp-portrait"><image src="{{account.avatarSrc}}" mode="aspectFill"/></view><image class="pp-sticker fire" src="/assets/mastergo-profile/fire-hd.webp" mode="aspectFit"/><image class="pp-sticker camp" src="/assets/mastergo-profile/camp-hd.webp" mode="aspectFit"/><image class="pp-sticker bike" src="/assets/mastergo-profile/bike-hd.webp" mode="aspectFit"/><image class="pp-sticker car" src="/assets/mastergo-profile/car-hd.webp" mode="aspectFit"/><image class="pp-sticker tree" src="/assets/loading-welcome/sticker-tree-hd.webp" mode="aspectFit"/><view class="pp-name"><text>{{account.nickname || '旅行者'}}</text><button data-method="editProfile" bindtap="command" aria-label="编辑资料"><image src="/assets/mastergo-profile/svg_09d1fa5a.svg"/></button></view></view>
 <view class="pp-section"><text>旅行与同行人管理</text><button data-method="createTrip" bindtap="command"><image src="/assets/mastergo-profile/svg_116003db.svg"/><text>新建旅行</text></button></view>
 <view class="pp-trips"><view wx:for="{{profileTrips}}" wx:key="id" class="pp-trip {{item.expanded ? 'expanded' : ''}} {{item.current ? 'current' : ''}}">
  <view class="pp-trip-head" data-id="{{item.id}}" bindtap="toggleTrip" hover-class="motion-pressed" hover-stop-propagation="true"><text class="pp-trip-name">{{item.name}}</text><text class="pp-type">{{item.type}}</text><view wx:if="{{item.current}}" class="pp-current"><view></view><text>当前旅行</text></view><text wx:if="{{item.archived}}" class="pp-archive">已归档</text><image src="/assets/mastergo-profile/{{item.expanded ? 'svg_04b0a7d7.svg' : 'svg_c8fcc180.svg'}}"/></view>
  <view class="pp-dates"><text>{{item.startLabel}}</text><image src="/assets/mastergo-profile/svg_18e28d3c.svg"/><text>{{item.endLabel}}</text></view>
  <view class="pp-trip-body {{item.expanded ? 'is-expanded' : ''}}" aria-hidden="{{!item.expanded}}"><view class="pp-trip-inner"><view class="pp-members"><view class="pp-members-title"><text>同行成员</text><text>{{item.memberCount}}人</text></view><view class="pp-member" wx:for="{{item.members}}" wx:for-item="person" wx:key="id"><image src="{{person.avatarSrc}}" mode="aspectFill"/><text>{{person.name}}</text><text wx:if="{{person.owner}}" class="pp-owner">创建者</text><button wx:elif="{{person.canRemove}}" class="pp-remove" data-method="removeMember" data-id="{{item.id}}" data-member="{{person.id}}" bindtap="command">移除</button></view><button wx:if="{{!item.readOnly}}" class="pp-invite" data-method="copyInvite" data-id="{{item.id}}" bindtap="command"><image src="/assets/mastergo-profile/svg_ac9f9b85.svg"/><text>邀请同行人</text></button></view>
  <view class="pp-actions"><button data-method="cloneTrip" data-id="{{item.id}}" bindtap="command" aria-label="创建旅行副本"><image src="/assets/mastergo-profile/svg_f6798b13.svg"/></button><button wx:if="{{!item.readOnly}}" data-method="editTrip" data-id="{{item.id}}" bindtap="command" aria-label="编辑旅行"><image src="/assets/mastergo-profile/svg_d8593e3e.svg"/></button><button wx:if="{{item.canManage}}" data-method="deleteTrip" data-id="{{item.id}}" bindtap="command" aria-label="删除旅行"><image src="/assets/mastergo-profile/svg_e6691c47.svg"/></button></view>
  </view></view></view><view wx:if="{{!profileTrips.length}}" class="pp-empty">还没有旅行，创建你的第一段旅程吧。</view></view>
 <view wx:if="{{settingsOpen}}" class="pp-settings-panel"><view><text>减少动态效果</text><switch checked="{{reducedMotion}}" bindchange="toggleMotion"/></view><button wx:if="{{trip}}" data-method="switchTrip" data-id="{{expandedTripId || trip.id}}" bindtap="command">进入这段旅行</button><button wx:if="{{trip && isOwner && !trip.archived}}" data-method="archiveTrip" data-id="{{expandedTripId || trip.id}}" bindtap="command">归档旅行</button><button wx:if="{{trip}}" data-method="exportCalendar" bindtap="command">导出日历</button><button wx:if="{{trip && isOwner}}" data-method="exportTrip" bindtap="command">导出备份</button></view>
</view>
<include src="../index/views/form-sheet.wxml" />
